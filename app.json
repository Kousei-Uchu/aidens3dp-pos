{
  "expo": {
    "name": "Shopify POS",
    "slug": "shopify-zeller-pos",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.aidens3dp.pos",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to scan product barcodes, gift card QR codes and to pair your Zeller terminal.",
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "ITSAppUsesNonExemptEncryption": false,
        "UIRequiresFullScreen": false
      },
      "appleTeamId": "HD264P8365"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan product barcodes, gift card QR codes and to pair your Zeller terminal."
        }
      ]
    ]
  }
}
