SCREEN page_customers "Customers" { "kind": "page", "route": "customers", "label": "Customers", "summary": "Find, add or edit customers.", "keywords": ["customer list", "new customer", "contact", "member", "client"] }
SCREEN page_reports "Reports" { "kind": "page", "route": "reports", "label": "Reports", "summary": "Sales totals for a period: payments, categories and gift cards.", "keywords": ["takings", "daily totals", "end of day", "z report", "sales report", "top sellers", "totals"] }
SCREEN page_giftcards "Gift cards" { "kind": "page", "route": "giftcards", "label": "Gift cards", "summary": "Look up gift cards, their balance and history.", "keywords": ["gift card balance", "voucher", "check gift card", "redeem"] }
SCREEN page_drawer "Cash drawer" { "kind": "page", "route": "drawer", "label": "Cash drawer", "summary": "The cash drawer: what it holds, open and close, paid in and out, float report and swap cash.", "keywords": ["till", "cash up", "float", "count the till", "banking", "notes and coins", "cash in drawer", "change"] }
SCREEN page_settings "Settings" { "kind": "page", "route": "settings", "label": "Settings", "summary": "Register settings: Shopify, payments, hardware, receipts, backups and display.", "keywords": ["setup", "configure", "preferences", "shopify", "printer", "backup", "theme", "scanner"] }
