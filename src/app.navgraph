# ----------------------------------------------------------- Checkout sheets
SCREEN sheet_search "Search" { "kind": "sheet", "tab": "checkout", "label": "Search", "summary": "Search products by name, SKU or barcode to add to the sale.", "keywords": ["find product", "lookup", "type to search"] }
SCREEN sheet_customer "Customer" { "kind": "sheet", "tab": "checkout", "label": "Customer", "summary": "Pick the customer for this sale, or find one.", "keywords": ["attach customer", "add customer to sale", "find customer"] }
SCREEN sheet_customer_new "New customer" { "kind": "sheet", "tab": "checkout", "label": "New customer", "summary": "The form for a new customer.", "keywords": ["create customer", "register customer", "new contact"] }
SCREEN sheet_custom_amount "Custom amount" { "kind": "sheet", "tab": "checkout", "label": "Custom amount", "summary": "Sell something that is not in the catalogue by typing a price.", "keywords": ["misc", "open price", "custom price", "no barcode", "manual price"] }
SCREEN sheet_gift_sell "Sell gift card" { "kind": "sheet", "tab": "checkout", "label": "Sell gift card", "summary": "Choose an amount to sell a gift card.", "keywords": ["sell voucher", "gift card amount", "new gift card"] }
SCREEN sheet_gift_sell_details "Gift card" { "kind": "sheet", "tab": "checkout", "label": "Gift card", "summary": "Gift card details: handover or email to the recipient.", "keywords": ["gift card email", "recipient", "handover"] }
SCREEN sheet_cart_menu "Cart menu" { "kind": "sheet", "tab": "checkout", "label": "Cart menu", "summary": "The cart's menu: discount, whole order price, save cart, sell a gift card.", "keywords": ["three dots", "more options", "cart options", "cart actions"] }
SCREEN sheet_cart_discount "Cart discount" { "kind": "sheet", "tab": "checkout", "label": "Cart discount", "summary": "Apply a discount to the whole cart.", "keywords": ["percent off", "discount the sale", "whole cart discount", "money off"] }
SCREEN sheet_order_price "Whole order price" { "kind": "sheet", "tab": "checkout", "label": "Whole order price", "summary": "Set a single price for the whole order.", "keywords": ["total price", "override total", "round price", "agreed price"] }
SCREEN sheet_review "Check the price adjustments" { "kind": "sheet", "tab": "checkout", "label": "Check the price adjustments", "summary": "Check the price adjustments before payment.", "keywords": ["review adjustments", "price changes", "confirm discounts"] }
SCREEN sheet_bundles "Check these bundles" { "kind": "sheet", "tab": "checkout", "label": "Check these bundles", "summary": "Check bundle deals found in the cart before payment.", "keywords": ["bundle deal", "buy together", "multi buy"] }
SCREEN sheet_cart_warnings "Customer warning" { "kind": "sheet", "tab": "checkout", "label": "Customer warning", "summary": "A customer warning shown at Charge when the cart holds a flagged item.", "keywords": ["warning", "fragile", "prompt", "reminder at charge"] }
SCREEN sheet_warning_list "Warnings list" { "kind": "sheet", "tab": "checkout", "label": "Warnings list", "summary": "The list of warnings that were added to the list instead of shown on Charge, e.g. an item sold from a fixed display that needs putting back out.", "keywords": ["warning list", "restock", "display", "put another out", "queued warning"] }
SCREEN sheet_save_cart "Save cart" { "kind": "sheet", "tab": "checkout", "label": "Save cart", "summary": "Save the cart to finish later.", "keywords": ["park", "hold sale", "put on hold", "save sale"] }

tab_checkout -> sheet_search [say="Tap Search."] { DO TAP { "target": "find.search" } }
sheet_search -> tab_checkout [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
tab_checkout -> sheet_customer [say="Tap the customer row."] { DO TAP { "target": "cart.customer" } }
page_cart -> sheet_customer [say="Tap the customer row."] { DO TAP { "target": "cart.customer" } }
sheet_customer -> tab_checkout [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
