SCREEN sheet_cash_receive "Cash received" { "kind": "sheet", "tab": "checkout", "label": "Cash received", "summary": "Tap the notes and coins the customer handed over.", "keywords": ["cash tendered", "cash received", "amount given", "customer cash"] }
SCREEN sheet_cash_change "Give change" { "kind": "sheet", "tab": "checkout", "label": "Give change", "summary": "Shows the change to give from the drawer.", "keywords": ["give change", "change due", "notes and coins to give"] }
SCREEN sheet_check_change "Check change" { "kind": "sheet", "tab": "checkout", "label": "Check change", "summary": "Check, before taking notes, whether the drawer can make the change.", "keywords": ["can make change", "change check", "enough change"] }
SCREEN sheet_split "Split amount" { "kind": "sheet", "tab": "checkout", "label": "Split amount", "summary": "Split the bill equally or by an amount.", "keywords": ["split payment", "part payment", "pay in pieces", "share the bill"] }
SCREEN sheet_gift_check "Check gift card" { "kind": "sheet", "tab": "checkout", "label": "Check gift card", "summary": "Scan or type a gift card code to pay with it.", "keywords": ["pay with gift card", "gift card code", "voucher payment"] }
SCREEN sheet_receipt "Receipt" { "kind": "sheet", "tab": "checkout", "label": "Receipt", "summary": "The receipt after a sale: QR, email, text or share.", "keywords": ["send receipt", "email receipt", "receipt qr", "print receipt", "invoice"] }

page_pay -> sheet_cash_receive [say="Tap Cash."] { DO TAP { "target": "pay.cash" } }
page_pay -> sheet_split [say="Tap Split."] { DO TAP { "target": "pay.split" } }
sheet_split -> page_pay [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
sheet_cash_receive -> sheet_cash_change [say="Tap Next: give change."] { DO TAP { "target": "cash.next" } }
sheet_cash_receive -> page_pay [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
sheet_cash_change -> page_pay [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
page_pay -> sheet_check_change [say="Check the change."] { DO TAP { "target": "pay.cash" } }
tab_checkout -> sheet_check_change [say="Tap the Check change tile."] { DO TAP { "target": "grid.action:check_change" } }
page_cart -> sheet_check_change [say="Tap the Check change tile."] { DO TAP { "target": "grid.action:check_change" } }
page_pay -> sheet_gift_check [say="Tap Gift card."] { DO TAP { "target": "pay.gift" } }
sheet_gift_check -> page_pay [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
page_pay -> sheet_receipt [say="Finish the sale."] { DO TAP { "target": "pay.card" } }
sheet_receipt -> tab_checkout [say="Close this window first."] { DO TAP { "target": "receipt.none" } }

# ---------------------------------------------------------- Orders & refund -
SCREEN sheet_order "Order" { "kind": "sheet", "tab": "more", "label": "Order", "summary": "One order: its items, payments and the refund button.", "keywords": ["order details", "view sale", "reprint receipt"] }
SCREEN sheet_refund "Return" { "kind": "sheet", "tab": "more", "label": "Return", "summary": "Choose what is coming back and how to refund it.", "keywords": ["refund", "refund a sale", "return", "exchange", "give money back", "restock"] }
SCREEN sheet_refund_pick "Replacement item" { "kind": "sheet", "tab": "more", "label": "Replacement item", "summary": "Pick the replacement item for an exchange.", "keywords": ["exchange", "swap item", "replacement"] }
SCREEN sheet_refund_done "Done" { "kind": "sheet", "tab": "more", "label": "Done", "summary": "The refund is finished.", "keywords": ["refund complete", "refund result"] }

page_orders -> sheet_order [say="Tap the order."] { DO TAP { "target": "order.row" } }
sheet_order -> page_orders [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
