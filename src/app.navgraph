sheet_gift_sell_details -> tab_checkout [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
sheet_gift_sell -> tab_checkout [say="Close this window first."] { DO TAP { "target": "sheet.close" } }

page_cart -> sheet_cart_menu [say="Tap the three dots in the cart."] { DO TAP { "target": "cart.menu" } }
tab_checkout -> sheet_cart_menu [say="Tap the three dots in the cart."] { DO TAP { "target": "cart.menu" } }
sheet_cart_menu -> page_cart [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
