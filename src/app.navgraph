SCREEN page_diagnostics "Support & diagnostics" { "kind": "page", "route": "diagnostics", "label": "Support & diagnostics", "summary": "Support and diagnostics for when something is not working.", "keywords": ["troubleshoot", "problem", "error", "fault", "sync", "logs", "support"] }
SCREEN page_help "Help" { "kind": "page", "route": "help", "label": "Help", "summary": "The built in help pages.", "keywords": ["manual", "guide", "instructions", "how to", "documentation"] }
SCREEN page_assistant "Ask the assistant" { "kind": "page", "route": "assistant", "label": "Ask the assistant", "summary": "Chat with the Help assistant.", "keywords": ["ask", "chatbot", "ai", "question"] }
SCREEN page_training "Training" { "kind": "page", "route": "training", "label": "Training", "summary": "Practice the till with guided lessons on safe practice data.", "keywords": ["learn", "lessons", "practice", "training mode", "trainee"] }
SCREEN page_training_run "Training run" { "kind": "page", "route": "trainingRun", "label": "Training run", "summary": "A running practice lesson.", "keywords": ["lesson", "practice", "exercise"] }
SCREEN page_terminal_play "Practice terminal" { "kind": "page", "route": "terminalPlay", "label": "Practice terminal", "summary": "A practice card terminal for trying card payments safely.", "keywords": ["practice card reader", "practice terminal", "tap card"] }

# Checkout to payment and cart
tab_checkout -> page_cart [say="Open the cart first."] { DO TAP { "target": "cart.open" } }
