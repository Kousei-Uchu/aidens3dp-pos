NAVGRAPH/2
APP "Aidens 3D POS"

# The line key of a per line window (its variant, or the line's own id for a
# custom amount). The `sheet_line` template below is copied once per open line
# at runtime, and the copy fills this in (see `ensureLineWindow` in appGraph).
VAR ITEM_KEY : string

# ============================================================================
# The app as a graph. Screens are places a person can be. Edges are how they
# move and what they do. Control level action nodes are registered at runtime
# from src/lib/appControls.ts (node id = "do:" + spot id), so every button,
# tile, row and gesture in the app joins this graph without hand editing.
#
# Node kinds (screen meta "kind"):
#   tab      the five bottom bar tabs
#   view     a mode inside Checkout (Keypad, All products; Quick Menu is the tab)
#   page     a pushed route
#   sheet    a window drawn over the page
#   overlay  something drawn over everything (sign in, screensaver, practice)
#   action   a control, a terminal node in a route
#
# Edge meta:
#   say      the words said while pointing at this transition
#   gesture  tap (default), or a swipe/hold/scroll
#   spot     the UI spot this transition taps, when it has one
#   roles    who may take it
#   modules  which run the transition belongs to (a module id, or "real"); missing means every run
# ============================================================================

# ---------------------------------------------------------------- tabs -----
SCREEN tab_checkout "Checkout" { "kind": "tab", "tab": "checkout", "label": "Checkout", "summary": "Build the sale and take payment." }
SCREEN tab_inventory "Inventory" { "kind": "tab", "tab": "inventory", "label": "Inventory" }
SCREEN tab_transactions "Transactions" { "kind": "tab", "tab": "transactions", "label": "Transactions" }
SCREEN tab_notifications "Notifications" { "kind": "tab", "tab": "notifications", "label": "Notifications" }
SCREEN tab_more "More" { "kind": "tab", "tab": "more", "label": "More" }

tab_checkout -> tab_inventory [say="Tap Inventory."] { DO TAP { "target": "tab.inventory" } }
tab_checkout -> tab_transactions [say="Tap Transactions."] { DO TAP { "target": "tab.transactions" } }
tab_checkout -> tab_notifications [say="Tap Notifications."] { DO TAP { "target": "tab.notifications" } }
tab_checkout -> tab_more [say="Tap More."] { DO TAP { "target": "tab.more" } }
