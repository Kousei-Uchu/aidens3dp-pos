# ------------------------------------------------------ Line editor sheets
SCREEN sheet_line "Item" { "kind": "sheet", "tab": "checkout", "label": "Item" }
SCREEN sheet_line_discount "Item discount" { "kind": "sheet", "tab": "checkout", "label": "Item discount" }
SCREEN sheet_line_item_price "Item price adjustment" { "kind": "sheet", "tab": "checkout", "label": "Item price adjustment" }
SCREEN sheet_line_line_price "Line price adjustment" { "kind": "sheet", "tab": "checkout", "label": "Line price adjustment" }

# The per line copies (sheet_line:<key>) and their controls are registered at
# runtime as each line window opens (see `ensureLineWindow` in appGraph). These
# static edges are the template: each copy fills $ITEM_KEY$ with its own line.
page_cart -> sheet_line [say="Open the item's window first."] { DO TAP { "target": "cart.line:$ITEM_KEY$" } }
tab_checkout -> sheet_line [say="Open the item's window first."] { DO TAP { "target": "cart.line:$ITEM_KEY$" } }
sheet_line -> tab_checkout [say="Tap Done to close the item."] { DO TAP { "target": "line.done" } }
sheet_line -> page_cart [say="Close this window first."] { DO TAP { "target": "line.done" } }
sheet_line -> sheet_line_discount [say="Tap Discount."] { DO TAP { "target": "line.discount" } }
sheet_line -> sheet_line_item_price [say="Tap Item price adjustment."] { DO TAP { "target": "line.price" } }
sheet_line -> sheet_line_line_price [say="Tap Line price adjustment."] { DO TAP { "target": "line.adjust" } }
sheet_line_discount -> sheet_line [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
sheet_line_item_price -> sheet_line [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
sheet_line_line_price -> sheet_line [say="Close this window first."] { DO TAP { "target": "sheet.close" } }

# ----------------------------------------------------------------- Payment --
SCREEN sheet_cash_receive "Cash received" { "kind": "sheet", "tab": "checkout", "label": "Cash received" }
SCREEN sheet_cash_change "Give change" { "kind": "sheet", "tab": "checkout", "label": "Give change" }
SCREEN sheet_check_change "Check change" { "kind": "sheet", "tab": "checkout", "label": "Check change" }
