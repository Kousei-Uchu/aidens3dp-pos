NAVGRAPH/2
APP "Aidens 3D POS"

# The line key of a per line window (its variant, or the line's own id for a
# custom amount). The `sheet_line` template below is copied once per open line
# at runtime, and the copy fills this in (see `ensureLineWindow` in appGraph).
VAR ITEM_KEY : string

# ============================================================================
# The app as a graph. Screens are places a person can be. Edges are how they
# move and what they do. Control level action nodes are registered at runtime
# from src/lib/appControls.ts (node id = "do:" + spot id), so every button,
# tile, row and gesture in the app joins this graph without hand editing.
#
# Node kinds (screen meta "kind"):
#   tab      the five bottom bar tabs
#   view     a mode inside Checkout (Keypad, All products; Quick Menu is the tab)
#   page     a pushed route
#   sheet    a window drawn over the page
#   overlay  something drawn over everything (sign in, screensaver, practice)
#   action   a control, a terminal node in a route
#
# Edge meta:
#   say      the words said while pointing at this transition
#   gesture  tap (default), or a swipe/hold/scroll
#   spot     the UI spot this transition taps, when it has one
#   roles    who may take it
#   modules  which run the transition belongs to (a module id, or "real"); missing means every run
# ============================================================================

# ---------------------------------------------------------------- tabs -----
SCREEN tab_checkout "Checkout" { "kind": "tab", "tab": "checkout", "label": "Checkout", "summary": "Build the sale and take payment.", "keywords": ["sell", "new sale", "quick menu", "start a sale", "home", "till"] }
SCREEN tab_inventory "Inventory" { "kind": "tab", "tab": "inventory", "label": "Inventory", "summary": "Search the catalogue, see stock levels and receive, adjust or count stock.", "keywords": ["stock", "stock levels", "count", "receive", "adjust", "products", "catalogue"] }
SCREEN tab_transactions "Transactions" { "kind": "tab", "tab": "transactions", "label": "Transactions", "summary": "Past sales and refunds as a timeline.", "keywords": ["sales history", "past sales", "timeline", "receipts", "refund list"] }
SCREEN tab_notifications "Notifications" { "kind": "tab", "tab": "notifications", "label": "Notifications", "summary": "Notices and alerts for the register.", "keywords": ["alerts", "notices", "messages"] }
SCREEN tab_more "More" { "kind": "tab", "tab": "more", "label": "More", "summary": "The menu of the other pages, such as orders, items, customers, reports, the cash drawer and help.", "keywords": ["menu", "other pages", "menu list"] }

tab_checkout -> tab_inventory [say="Tap Inventory."] { DO TAP { "target": "tab.inventory" } }
tab_checkout -> tab_transactions [say="Tap Transactions."] { DO TAP { "target": "tab.transactions" } }
tab_checkout -> tab_notifications [say="Tap Notifications."] { DO TAP { "target": "tab.notifications" } }
tab_checkout -> tab_more [say="Tap More."] { DO TAP { "target": "tab.more" } }
tab_inventory -> tab_checkout [say="Tap Checkout."] { DO TAP { "target": "tab.checkout" } }
tab_inventory -> tab_transactions [say="Tap Transactions."] { DO TAP { "target": "tab.transactions" } }
tab_inventory -> tab_notifications [say="Tap Notifications."] { DO TAP { "target": "tab.notifications" } }
tab_inventory -> tab_more [say="Tap More."] { DO TAP { "target": "tab.more" } }
tab_transactions -> tab_checkout [say="Tap Checkout."] { DO TAP { "target": "tab.checkout" } }
tab_transactions -> tab_inventory [say="Tap Inventory."] { DO TAP { "target": "tab.inventory" } }
tab_transactions -> tab_notifications [say="Tap Notifications."] { DO TAP { "target": "tab.notifications" } }
tab_transactions -> tab_more [say="Tap More."] { DO TAP { "target": "tab.more" } }
tab_notifications -> tab_checkout [say="Tap Checkout."] { DO TAP { "target": "tab.checkout" } }
tab_notifications -> tab_inventory [say="Tap Inventory."] { DO TAP { "target": "tab.inventory" } }
tab_notifications -> tab_transactions [say="Tap Transactions."] { DO TAP { "target": "tab.transactions" } }
tab_notifications -> tab_more [say="Tap More."] { DO TAP { "target": "tab.more" } }
tab_more -> tab_checkout [say="Tap Checkout."] { DO TAP { "target": "tab.checkout" } }
tab_more -> tab_inventory [say="Tap Inventory."] { DO TAP { "target": "tab.inventory" } }
tab_more -> tab_transactions [say="Tap Transactions."] { DO TAP { "target": "tab.transactions" } }
tab_more -> tab_notifications [say="Tap Notifications."] { DO TAP { "target": "tab.notifications" } }

# ------------------------------------------------------- checkout views ----
SCREEN view_keypad "Keypad" { "kind": "view", "tab": "checkout", "label": "Keypad", "summary": "Type an amount or code on a keypad and add it to the sale.", "keywords": ["numbers", "type amount", "key in", "keypad"] }
SCREEN view_all "All products" { "kind": "view", "tab": "checkout", "label": "All products", "summary": "Browse every product in the catalogue and add it to the sale.", "keywords": ["browse", "all items", "catalogue", "filter products"] }

