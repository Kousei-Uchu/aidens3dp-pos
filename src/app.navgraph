sheet_refund_pick -> sheet_refund [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
sheet_refund -> sheet_refund_done [say="Tap the refund button."] { DO TAP { "target": "refund.go" } }
sheet_refund_done -> page_orders [say="Tap OK."] { DO TAP { "target": "refund.done" } }

