# ------------------------------------------------------------- pages -------
SCREEN page_pay "Payment" { "kind": "page", "route": "pay", "label": "Payment", "summary": "Take payment for the sale: cash, card, gift card or split.", "keywords": ["pay", "charge", "tender", "take payment", "card", "cash", "gift card", "split", "checkout"] }
SCREEN page_cart "Cart" { "kind": "page", "route": "cart", "label": "Cart", "summary": "The cart: what is in the sale, change a line, add a customer or discount.", "keywords": ["basket", "sale", "lines", "remove item", "quantity"] }
SCREEN page_saved "Saved carts" { "kind": "page", "route": "saved", "label": "Saved carts", "summary": "Sales parked to finish later.", "keywords": ["parked", "park a sale", "hold", "resume", "saved sale"] }
SCREEN page_orders "Orders" { "kind": "page", "route": "orders", "label": "Orders", "summary": "Find past orders and open one to see it, reprint a receipt or refund.", "keywords": ["past sales", "refund", "return", "exchange", "receipt", "find a sale", "transactions"] }
SCREEN page_items "Items" { "kind": "page", "route": "items", "label": "Items", "summary": "Search and edit catalogue items, or create a new one.", "keywords": ["products", "price change", "edit price", "barcode", "sku", "catalogue", "stock"] }
