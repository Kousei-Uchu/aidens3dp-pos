sheet_switch_staff -> page_staff [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
page_staff -> sheet_staff_pass [say="Tap the pass."] { DO TAP { "target": "staff.pass" } }
sheet_staff_pass -> page_staff [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
tab_inventory -> sheet_inventory_filters [say="Tap Filters & sort."] { DO TAP { "target": "inv.filter" } }
tab_inventory -> sheet_inventory_product [say="Tap a product."] { DO TAP { "target": "inv.product" } }
sheet_inventory_filters -> tab_inventory [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
sheet_inventory_product -> tab_inventory [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
tab_checkout -> sheet_lookup [say="Tap Price check."] { DO TAP { "target": "grid.action:price_check" } }
tab_checkout -> sheet_lookup [say="Tap Stock check."] { DO TAP { "target": "grid.action:stock_check" } }
sheet_lookup -> tab_checkout [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
tab_checkout -> sheet_tile [say="Tap the tile."] { DO TAP { "target": "tile.settings" } }
sheet_tile -> tab_checkout [say="Close this window first."] { DO TAP { "target": "sheet.close" } }

# ------------------------------------------------------------- overlays ----
# `modules` says which run a place belongs to: a training module id, or "real" for the everyday till. Only the places
# that differ carry it; everything else is in every scope. The camera is the clear case: the everyday till opens the
# real camera, while practice opens the drawn practice camera (see src/screens/Scanner.tsx).
SCREEN overlay_lock "Sign in" { "kind": "overlay", "label": "Sign in" }
SCREEN overlay_screensaver "Screensaver" { "kind": "overlay", "label": "Screensaver" }
SCREEN overlay_practice_pass "Scan your cashier pass" { "kind": "overlay", "label": "Scan your cashier pass", "modules": ["sign-in"] }
SCREEN overlay_practice_camera "Practice camera" { "kind": "overlay", "label": "Practice camera", "modules": ["scanning"] }
SCREEN overlay_camera "Camera" { "kind": "overlay", "label": "Camera", "modules": ["real"] }

overlay_lock -> tab_checkout [say="Unlock the till."] { DO TAP { "target": "login.unlock" } }
overlay_lock -> tab_checkout [say="Unlock the till."] { DO TAP { "target": "login.pinpad" } }
overlay_lock -> overlay_practice_pass [say="Tap Scan pass.", modules=["sign-in"]] { DO TAP { "target": "login.scanpass" } }
overlay_practice_pass -> tab_checkout [say="Tap Scan this pass."] { DO TAP { "target": "pass.scan" } }
overlay_camera -> tab_checkout [say="Tap Done."] { DO TAP { "target": "scan.done" } }
tab_checkout -> overlay_camera [say="Tap the scan button."] { DO TAP { "target": "scan.camera" } }
overlay_practice_camera -> tab_checkout [say="Tap Done."] { DO TAP { "target": "scan.done" } }
tab_checkout -> overlay_practice_camera [say="Tap the scan button."] { DO TAP { "target": "scan.camera" } }
overlay_screensaver -> tab_checkout [say="Tap the screen."] { DO TAP { "target": "screensaver.tap" } }

END
