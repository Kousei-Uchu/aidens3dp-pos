sheet_cart_menu -> sheet_order_price [say="Tap Whole order price."] { DO TAP { "target": "cart.menu.order" } }
sheet_cart_menu -> sheet_save_cart [say="Tap Save cart."] { DO TAP { "target": "cart.menu.save" } }
sheet_cart_discount -> sheet_cart_menu [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
sheet_order_price -> page_cart [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
tab_checkout -> sheet_order_price [say="Tap Whole order price."] { DO TAP { "target": "cart.menu.order" } }
sheet_save_cart -> sheet_cart_menu [say="Close this window first."] { DO TAP { "target": "sheet.close" } }

page_cart -> sheet_review [say="Tap Charge."] { DO TAP { "target": "cart.charge" } }
tab_checkout -> sheet_review [say="Tap Charge."] { DO TAP { "target": "cart.charge" } }
sheet_review -> page_pay [say="Tap Continue to payment."] { DO TAP { "target": "review.continue" } }
sheet_review -> page_cart [say="Close this window first."] { DO TAP { "target": "sheet.close" } }
tab_checkout -> sheet_bundles [say="Tap Charge."] { DO TAP { "target": "cart.charge" } }
sheet_bundles -> page_pay [say="Tap Continue to payment."] { DO TAP { "target": "bundle.continue" } }
sheet_bundles -> page_cart [say="Tap Edit cart."] { DO TAP { "target": "bundle.edit" } }
page_cart -> sheet_cart_warnings [say="Tap Charge."] { DO TAP { "target": "cart.charge" } }
tab_checkout -> sheet_cart_warnings [say="Tap Charge."] { DO TAP { "target": "cart.charge" } }
sheet_cart_warnings -> page_pay [say="Tap Continue to payment."] { DO TAP { "target": "warning.continue" } }
sheet_cart_warnings -> page_cart [say="Tap Back to cart."] { DO TAP { "target": "warning.cancel" } }

# The warnings list: warnings set to "Add to the list" are recorded here instead of being shown on Charge.
