DEFINE SCHEMA

    RECORD TYPE Attempt (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        amountCents     INT64 QUERYABLE SORTABLE,
        ref             STRING QUERYABLE SEARCHABLE SORTABLE,
        registerId      STRING QUERYABLE SEARCHABLE SORTABLE,
        registerName    STRING QUERYABLE SEARCHABLE SORTABLE,
        saleUuid        STRING QUERYABLE SEARCHABLE SORTABLE,
        status          STRING QUERYABLE SEARCHABLE SORTABLE,
        ts              STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Cart (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
