        lines_json      STRING QUERYABLE SEARCHABLE SORTABLE,
        locked_at       STRING QUERYABLE SEARCHABLE SORTABLE,
        locked_by       STRING QUERYABLE SEARCHABLE SORTABLE,
        name            STRING QUERYABLE SEARCHABLE SORTABLE,
        note            STRING QUERYABLE SEARCHABLE SORTABLE,
        register_id     STRING QUERYABLE SEARCHABLE SORTABLE,
        status          STRING QUERYABLE SEARCHABLE SORTABLE,
        updated_at      STRING QUERYABLE SEARCHABLE SORTABLE,
        version         STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

