+// Location: tests/characterise_shopify_state.test.ts
+// Alloys P2 (characterisation): gift cards and the shared-state backend (metaobjects) against a fake Shopify.
+// Gift cards use Shopify's own balance ledger, and the metaobject backend is the shared-state seam today, so both are pinned exactly.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as fake from './helpers/fakeShopify';
+
+const ok = (field: string, extra: Record<string, unknown> = {}) => fake.data({ [field]: { ...extra, userErrors: [] } });
+const card = (o: any = {}) => ({ id: 'GC1', lastCharacters: 'ABCD', balance: { amount: '20.00' }, initialValue: { amount: '50.00' }, enabled: true, expiresOn: null, note: null, customer: null, ...o });
+const sha = async (code: string) => (await import('node:crypto')).createHash('sha256').update(code).digest('hex').slice(0, 10);
+
+test('createGiftCard: normalised code, the note carries the sale and a checksum (never the code), recipient is found by email', async () => {
+  fake.install(); await fake.signIn();
+  fake.on('customers(first: 20', fake.data({ customers: { nodes: [{ id: 'U9', email: 'Friend@X.com', displayName: 'F' }] } }));
+  fake.on('giftCardCreate', ok('giftCardCreate', { giftCard: card({ customer: { displayName: 'F' } }) }));
+  const { createGiftCard } = await import('../src/lib/shopify/giftcards');
+  const { normaliseCode } = await import('../src/lib/giftCode');
+  const r = await createGiftCard(5000, 'abcd-1234-efgh-5678', 'SALE-1', undefined, { email: ' Friend@X.com ', name: 'Fay Friend', message: 'Enjoy' });
+  assert.deepEqual(fake.gqlCalls()[0].variables, { q: 'email:friend@x.com' });
+  const i = fake.lastCall().variables.i;
+  assert.equal(i.initialValue, '50.00'); assert.equal(i.code, normaliseCode('abcd-1234-efgh-5678'));
+  assert.equal(i.note, `pos|sale:SALE-1|chk:${await sha(normaliseCode('abcd-1234-efgh-5678'))}`);
+  assert.deepEqual(i.recipientAttributes, { id: 'U9', preferredName: 'Fay Friend', message: 'Enjoy' });
+  assert.equal('customerId' in i, false);
+  assert.deepEqual(r, { id: 'GC1', last4: 'ABCD', balanceCents: 2000, initialCents: 5000, enabled: true, expiresOn: undefined, customerName: 'F', verified: true });
+});
+
+test('createGiftCard: no matching customer creates one from the email and name; no recipient sends no recipient attributes', async () => {
+  fake.install(); await fake.signIn();
+  fake.on('customers(first: 20', fake.data({ customers: { nodes: [] } }));
+  fake.on('customerCreate', ok('customerCreate', { customer: { id: 'U10', displayName: 'New Person', email: 'n@x.com' } }));
+  fake.on('giftCardCreate', ok('giftCardCreate', { giftCard: card() }));
+  const { createGiftCard } = await import('../src/lib/shopify/giftcards');
+  await createGiftCard(1000, 'ZZZZ1111YYYY2222', 'S', 'U1', { email: 'n@x.com', name: 'New Person' });
+  assert.deepEqual(fake.gqlCalls()[1].variables, { i: { email: 'n@x.com', firstName: 'New', lastName: 'Person' } });
+  assert.equal(fake.lastCall().variables.i.recipientAttributes.id, 'U10'); assert.equal(fake.lastCall().variables.i.customerId, 'U1');
+  fake.on('giftCardCreate', ok('giftCardCreate', { giftCard: card() }));
+  await createGiftCard(1000, 'ZZZZ1111YYYY2223', 'S2');
+  assert.equal('recipientAttributes' in fake.lastCall().variables.i, false);
