+// Location: tests/helpers/fakeShopify.ts
+// A fake Shopify for the characterisation tests (Alloys P2). It stands in for the three things src/lib/shopify/* reaches outside
+// itself: expo-secure-store (the Keychain), expo-crypto (SHA-256) and fetch. Nothing here knows about Alloys; it only records what
+// today's Shopify code sends and plays back canned replies, so a later move of that code can be proved to change nothing.
+import Module from 'node:module';
+import { createHash } from 'node:crypto';
+
+const keychain = new Map<string, string>();
+const stubs: Record<string, unknown> = {
+  'expo-secure-store': {
+    getItemAsync: async (k: string) => keychain.get(k) ?? null,
+    setItemAsync: async (k: string, v: string) => { keychain.set(k, v); },
+    deleteItemAsync: async (k: string) => { keychain.delete(k); },
+  },
+  'expo-crypto': {
+    CryptoDigestAlgorithm: { SHA256: 'SHA-256' },
+    digestStringAsync: async (_a: string, s: string) => createHash('sha256').update(s).digest('hex'),
+  },
+};
+const M = Module as unknown as { _load: (request: string, ...rest: unknown[]) => unknown };
+const realLoad = M._load;
+M._load = function (request: string, ...rest: unknown[]) { return request in stubs ? stubs[request] : realLoad.call(this, request, ...rest); };
+
+export type Call = { url: string; method: string; headers: Record<string, string>; body: any; query: string; variables: any };
+export type Reply = { status?: number; json?: unknown; text?: string; throws?: string };
+type Handler = (c: Call) => Reply | undefined;
+
+export const calls: Call[] = [];
+let handlers: Handler[] = [];
+let fallback: Handler | undefined;
+const realFetch = globalThis.fetch;
+
+/** Queue a reply for the next call whose GraphQL text includes `match` (a string), or for any call when match is omitted. */
+export function on(match: string | RegExp | null, reply: Reply | ((c: Call) => Reply)): void {
+  handlers.push(c => {
+    const hit = match === null || (typeof match === 'string' ? c.query.includes(match) : match.test(c.query));
+    if (!hit) return undefined;
+    return typeof reply === 'function' ? reply(c) : reply;
+  });
+}
+export const data = (d: unknown): Reply => ({ json: { data: d } });
+
+export function install(): void {
+  calls.length = 0; handlers = []; fallback = undefined;
+  globalThis.fetch = (async (url: any, init: any = {}) => {
+    const body = init.body && String(init.body).startsWith('{') ? JSON.parse(init.body) : init.body;
+    const c: Call = { url: String(url), method: init.method ?? 'GET', headers: init.headers ?? {}, body, query: body?.query ?? '', variables: body?.variables ?? {} };
+    calls.push(c);
+    if (c.url.endsWith('/oauth/access_token')) return mk({ json: { access_token: 'tok-1', expires_in: 86399, scope: 'read_products,write_orders' } });
+    if (c.url.startsWith('https://bulk.example/')) return mk({ text: bulkFiles.get(c.url) ?? '' });
+    const idx = handlers.findIndex(h => h(c) !== undefined);
+    if (idx < 0) throw new Error(`fakeShopify: no reply queued for: ${c.query.slice(0, 90)}`);
+    const r = handlers[idx](c)!; handlers.splice(idx, 1);
+    if (r.throws) throw new Error(r.throws);
+    return mk(r);
+  }) as typeof fetch;
+}
+export function restore(): void { globalThis.fetch = realFetch; }
+export const bulkFiles = new Map<string, string>();
+const mk = (r: Reply) => ({
+  ok: (r.status ?? 200) < 400, status: r.status ?? 200,
+  json: async () => { if (r.json === undefined) throw new Error('not json'); return r.json; },
+  text: async () => r.text ?? JSON.stringify(r.json ?? ''),
+}) as unknown as Response;
+
+/** Only the GraphQL calls (the token request is not one). */
+export const gqlCalls = () => calls.filter(c => c.query);
+export const lastCall = () => gqlCalls()[gqlCalls().length - 1];
+export const unqueued = () => handlers.length;
+
+/** Sign in against the fake so gql() works. Domain is fixed so URLs in assertions are stable. */
+export async function signIn(): Promise<typeof import('../../src/lib/shopify/client')> {
+  const client = await import('../../src/lib/shopify/client');
+  await client.saveCreds({ domain: 'shop.example', clientId: 'id', clientSecret: 'secret' });
+  return client;
+}
