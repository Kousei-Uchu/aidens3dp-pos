+// Location: tests/characterise_zeller.test.ts
+// Alloys P2 (characterisation): src/lib/zeller.ts against a fake TerminalLike. tests/lib.test.ts already covers the main charge and refund paths;
+// this pins the rest: the exact SDK calls, reconcile, the refund error branches, cancel, events and the helper mappers.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { attemptRef, describeEvent, normalise, reconcile, startCharge, startRefund, txnToCard, type TerminalLike, type ZellerEvent, type ZellerTxn } from '../src/lib/zeller';
+
+const err = (type: string, message = type) => Object.assign(new Error(message), { type });
+const approved = (ref: string, extra: Partial<ZellerTxn> = {}): ZellerTxn => ({ $type: 'Approved', status: 'APPROVED', amount: 500, externalReference: ref, approvalCode: 'AP', ...extra });
+
+type Script = { purchase?: ZellerTxn | Error; refund?: ZellerTxn | Error; lookup?: ZellerTxn[] | Error; events?: string[] };
+function terminal(s: Script) {
+  const log: { purchase: any[]; refund: any[]; lookups: any[]; cancelled: number } = { purchase: [], refund: [], lookups: [], cancelled: 0 };
+  const op = <T>(value: T, events: string[] = []) => {
+    const p: any = new Promise<T>(r => setTimeout(() => r(value), 5));
+    p.onEvent = (cb: (e: ZellerEvent) => void) => { events.forEach(type => setTimeout(() => cb({ type }), 1)); };
+    p.cancel = () => { log.cancelled++; };
+    return p;
+  };
+  const t: TerminalLike = {
+    initialise: () => op(true as const) as any, setup: () => op(true as const) as any, configure: () => op(true as const) as any,
+    purchase: o => { log.purchase.push(o); return op(s.purchase ?? approved(o.reference), s.events); },
+    refund: o => { log.refund.push(o); return op(s.refund ?? approved(o.reference ?? '', { type: 'REFUND' }), s.events); },
+    getTransactions: o => { log.lookups.push(o); return op(s.lookup ?? []) as any; },
+  };
+  return { t, log };
+}
