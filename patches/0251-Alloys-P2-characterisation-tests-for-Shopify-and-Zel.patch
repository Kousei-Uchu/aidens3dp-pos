+  assert.equal((k('Setup Required') as any).reason, 'SETUP_REQUIRED');
+  assert.equal((k('Network Failure') as any).reason, 'OFFLINE'); assert.equal(k('Network Failure', seenAny).kind, 'UNKNOWN');
+  assert.equal((k('Operation Busy') as any).reason, 'BUSY'); assert.equal((k('Paired Device Busy') as any).reason, 'BUSY');
+  assert.equal((k('Paired Device Not Available') as any).reason, 'TERMINAL_UNAVAILABLE');
+  assert.equal((k('Operation Request Invalid') as any).reason, 'INVALID_REQUEST');
+  assert.equal(k('Cancelled').kind, 'CANCELLED');
+  for (const t of ['Card Declined', 'Transaction Declined', 'Card Blocked', 'Card Not Supported']) { const r: any = k(t); assert.equal(r.kind, 'DECLINED'); assert.equal(r.category, 'DECLINED_TRY_OTHER_CARD'); assert.equal(r.retryable, true); }
+  for (const t of ['Inactivity Timeout', 'Card Read Failure', 'Card Insert Required']) assert.equal((k(t) as any).category, 'DECLINED_CUSTOMER_ACTION');
+  assert.deepEqual(k('Operation Interrupted'), { kind: 'UNKNOWN', reason: 'Operation Interrupted: Operation Interrupted' });
+  assert.equal(normalise(approved('A'), seen).kind, 'APPROVED');
+  assert.equal(normalise({ amount: 1, status: 'APPROVED' }, seen).kind, 'APPROVED');
+});
