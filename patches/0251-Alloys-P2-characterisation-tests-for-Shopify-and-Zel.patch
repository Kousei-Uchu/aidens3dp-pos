+  assert.equal(r.kind, 'APPROVED');
+  assert.deepEqual(log.purchase, [{ amount: 1234, reference: 'S-1', sessionUuid: 'SES', terminalReceipt: false, terminalReceiptPrint: false }]);
+  const { t: t2, log: l2 } = terminal({});
+  await startCharge(t2, { amountCents: 100, reference: 'S-2', terminalReceipt: true }).promise;
+  assert.equal(l2.purchase[0].terminalReceipt, true); assert.equal(l2.purchase[0].terminalReceiptPrint, false);
+});
