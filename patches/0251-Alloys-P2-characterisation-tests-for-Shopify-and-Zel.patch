+// Location: tests/characterise_shopify_client.test.ts
+// Alloys P2 (characterisation): pins what src/lib/shopify/client.ts does today against a fake Shopify. These are not design tests.
+// They record current behaviour so the move into src/alloys/shopify (P3 onwards) can be proved to change nothing. If one fails after a
+// move, the move changed behaviour; fix the move, not the test.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as fake from './helpers/fakeShopify';
+import { setTrainingGuard } from '../src/lib/trainingGuard';
+
+test('not signed in: gql refuses with the setup message and sends nothing', async () => {
+  fake.install();
+  const c = await import('../src/lib/shopify/client');
+  assert.equal(c.hasCreds(), false);
+  await assert.rejects(() => c.gql('{ shop { name } }'), (e: Error) => e instanceof c.ShopifyUserError && /not set up/.test(e.message));
+  assert.equal(fake.calls.length, 0);
+});
+
+test('normaliseDomain: bare shop names get .myshopify.com, URLs are cut down to the host', async () => {
+  const c = await import('../src/lib/shopify/client');
+  assert.equal(c.normaliseDomain('  Aidens3DP '), 'aidens3dp.myshopify.com');
+  assert.equal(c.normaliseDomain('https://Shop.Example/admin/orders'), 'shop.example');
+  assert.equal(c.normaliseDomain(''), '');
+});
+
+test('sign-in: saveCreds stores trimmed values, hasCreds flips, the token request is a client-credentials form post', async () => {
+  fake.install();
+  const c = await fake.signIn();
+  assert.equal(c.hasCreds(), true); assert.equal(c.shopDomain(), 'shop.example');
+  fake.on('shop {', fake.data({ shop: { name: 'S' } }));
+  await c.gql('{ shop { name } }');
+  const [tokenReq, apiReq] = fake.calls;
+  assert.equal(tokenReq.url, 'https://shop.example/admin/oauth/access_token');
+  assert.equal(tokenReq.method, 'POST');
+  assert.equal(tokenReq.body, 'grant_type=client_credentials&client_id=id&client_secret=secret');
+  assert.equal(apiReq.url, `https://shop.example/admin/api/${c.API_VERSION}/graphql.json`);
+  assert.equal(c.API_VERSION, '2026-07');
+  assert.equal(apiReq.headers['X-Shopify-Access-Token'], 'tok-1');
+  assert.deepEqual(c.tokenScopes(), ['read_products', 'write_orders']);
+});
+
+test('the token is reused between calls (one token request for many queries)', async () => {
+  fake.install(); const c = await fake.signIn();
+  fake.on(null, fake.data({ a: 1 })); fake.on(null, fake.data({ a: 2 }));
+  await c.gql('{ a }'); await c.gql('{ a }');
+  assert.equal(fake.calls.filter(x => x.url.endsWith('access_token')).length, 1);
+});
+
+test('gql returns json.data; variables travel with the query', async () => {
+  fake.install(); const c = await fake.signIn();
+  fake.on('thing', fake.data({ thing: { id: 'T1' } }));
+  const d = await c.gql('query($id:ID!){ thing(id:$id){ id } }', { id: 'T1' });
+  assert.deepEqual(d, { thing: { id: 'T1' } });
+  assert.deepEqual(fake.lastCall().variables, { id: 'T1' });
+});
+
+test('GraphQL errors become one ShopifyUserError joined with "; " and carrying the raw errors', async () => {
+  fake.install(); const c = await fake.signIn();
+  fake.on(null, { json: { errors: [{ message: 'Bad one' }, { message: 'Bad two' }] } });
+  await assert.rejects(() => c.gql('{ x }'), (e: any) => e instanceof c.ShopifyUserError && e.message === 'Bad one; Bad two' && e.details.length === 2);
+});
+
+test('a non-JSON reply is a network error (the till treats it as retryable)', async () => {
+  fake.install(); const c = await fake.signIn();
+  fake.on(null, { status: 200 });
+  await assert.rejects(() => c.gql('{ x }'), (e: any) => c.isNetworkError(e) && /non-JSON/.test(e.message));
+});
+
+test('401: the token is refreshed once and the call retried', async () => {
+  fake.install(); const c = await fake.signIn();
+  fake.on(null, fake.data({ ok: 1 })); await c.gql('{ warm }');
+  fake.on(null, { status: 401 }); fake.on(null, fake.data({ ok: 2 }));
+  assert.deepEqual(await c.gql('{ x }'), { ok: 2 });
+  assert.equal(fake.calls.filter(x => x.url.endsWith('access_token')).length, 2, 'initial token + one forced refresh');
+});
+
+test('429: backs off and retries, then returns the data', async () => {
+  fake.install(); const c = await fake.signIn();
+  fake.on(null, { status: 429 }); fake.on(null, fake.data({ ok: 1 }));
+  assert.deepEqual(await c.gql('{ x }'), { ok: 1 });
+  assert.equal(fake.gqlCalls().length, 2);
+});
+
+test('THROTTLED in the error list is retried (other error codes throw, see above)', async () => {
+  fake.install(); const c = await fake.signIn();
+  fake.on(null, { json: { errors: [{ message: 'Throttled', extensions: { code: 'THROTTLED' } }] } }); fake.on(null, fake.data({ ok: 1 }));
+  assert.deepEqual(await c.gql('{ x }'), { ok: 1 });
+});
+
+test('throwUserErrors: nothing for empty or missing, otherwise "<what>: msg; msg" as a ShopifyUserError with the errors attached', async () => {
+  const c = await import('../src/lib/shopify/client');
+  c.throwUserErrors([], 'x'); c.throwUserErrors(undefined, 'x'); c.throwUserErrors(null, 'x');
+  assert.throws(() => c.throwUserErrors([{ message: 'a' }, { message: 'b' }], 'Doing it'), (e: any) => e instanceof c.ShopifyUserError && e.message === 'Doing it: a; b' && e.details.length === 2);
+});
+
+test('token request failures: 4xx is a user error naming the status, 5xx is a network error', async () => {
+  fake.install();
+  const c = await import('../src/lib/shopify/client');
+  await c.saveCreds({ domain: 'shop.example', clientId: 'id', clientSecret: 'bad' });
+  fake.install();
+  // saveCreds drops the cached token, so the next call asks for a new one; make that ask fail.
+  const orig = globalThis.fetch;
+  globalThis.fetch = (async (url: any) => String(url).endsWith('access_token') ? ({ ok: false, status: 400, text: async () => 'invalid_client', json: async () => ({}) }) as any : orig(url)) as any;
+  await assert.rejects(() => c.getToken(true), (e: any) => e instanceof c.ShopifyUserError && /rejected the client ID\/secret \(400\)/.test(e.message));
+  globalThis.fetch = (async () => ({ ok: false, status: 503, text: async () => '', json: async () => ({}) }) as any) as any;
+  await assert.rejects(() => c.getToken(true), (e: any) => c.isNetworkError(e) && /auth 503/.test(e.message));
+  fake.restore();
+});
+
+test('practice (training) mode: no credentials, no token, no calls', async () => {
+  fake.install(); const c = await fake.signIn();
+  setTrainingGuard(true);
+  try {
+    assert.equal(c.hasCreds(), false);
+    await assert.rejects(() => c.gql('{ x }'), /Training mode: Shopify is switched off/);
+    await assert.rejects(() => c.getToken(), /Training mode/);
+    await assert.rejects(() => c.saveCreds({ domain: 'a', clientId: 'b', clientSecret: 'c' }), /changing the Shopify login/);
+    await assert.rejects(() => c.clearCreds(), /changing the Shopify login/);
+  } finally { setTrainingGuard(false); }
+  assert.equal(fake.calls.length, 0);
+});
+
+test('secrets for the receipt, claim and wallet-pass servers live in the Keychain, trimmed, empty clears', async () => {
+  const c = await import('../src/lib/shopify/client');
+  assert.equal(await c.getReceiptSecret(), '');
+  await c.setReceiptSecret('  s1 '); assert.equal(await c.getReceiptSecret(), 's1');
+  await c.setClaimSecret('s2'); assert.equal(await c.getClaimSecret(), 's2');
+  await c.setPassSecret('s3'); assert.equal(await c.getPassSecret(), 's3');
+  await c.setReceiptSecret(''); assert.equal(await c.getReceiptSecret(), '');
+  setTrainingGuard(true);
+  try { await c.setClaimSecret('changed'); } finally { setTrainingGuard(false); }
+  assert.equal(await c.getClaimSecret(), 's2', 'practice mode never writes the Keychain');
+});
+
+test('clearCreds signs out', async () => {
+  fake.install(); const c = await fake.signIn();
+  await c.clearCreds();
+  assert.equal(c.hasCreds(), false); assert.equal(c.shopDomain(), '');
+  await assert.rejects(() => c.gql('{ x }'), /not set up/);
+});
