-> page_orders [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_order -> sheet_refund [say=\"Tap Refund or return.\"] { DO TAP { \"target\": \"orders.refund\" } }\nsheet_refund -> page_orders [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_refund -> sheet_refund_pick [say=\"Tap Add replacement item.\"] { DO TAP { \"target\": \"refund.replace\" } }\nsheet_refund_pick -> sheet_refund [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_refund -> sheet_refund_done [say=\"Tap the refund button.\"] { DO TAP { \"target\": \"refund.go\" } }\nsheet_refund_done -> page_orders [say=\"Tap OK.\"] { DO TAP { \"target\": \"refund.done\" } }\n\n# ------------------------------------------------------- More page sheets ---\nSCREEN sheet_reports_filter \"Customise\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Customise\" }\nSCREEN sheet_drawer_open \"Open drawer\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Open drawer\" }\nSCREEN sheet_drawer_close \"Close drawer\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Close drawer\" }\nSCREEN sheet_drawer_float \"Daily float report\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Daily float report\" }\nSCREEN sheet_drawer_swap \"Swap my cash\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Swap my cash\" }\nSCREEN sheet_cash_give \"Give cash refund\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Give cash refund\" }\nSCREEN sheet_cash_return \"Return cash for cancelled sale\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Return cash for cancelled sale\" }\nSCREEN sheet_saved_name \"Save cart\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Save cart\" }\nSCREEN sheet_switch_staff \"Switch staff\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Switch staff\" }\nSCREEN sheet_staff_pass \"Staff pass\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Staff pass\" }\nSCREEN sheet_tile \"Add to grid\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Add to grid\" }\nSCREEN sheet_inventory_filters \"Filters & sort\" { \"kind\": \"sheet\", \"tab\": \"inventory\", \"label\": \"Filters & sort\" }\nSCREEN sheet_inventory_product \"Product\" { \"kind\": \"sheet\", \"tab\": \"inventory\", \"label\": \"Product\" }\nSCREEN sheet_lookup \"Look up\" { \"kind\": \"sheet\", \"tab\": \"inventory\", \"label\": \"Look up\" }\n\npage_reports -> sheet_reports_filter [say=\"Tap Customise.\"] { DO TAP { \"target\": \"reports.filter\" } }\nsheet_reports_filter -> page_reports [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_drawer -> sheet_drawer_open [say=\"Tap Open drawer.\"] { DO TAP { \"target\": \"drawer.open\" } }\npage_drawer -> sheet_drawer_close [say=\"Tap Close drawer.\"] { DO TAP { \"target\": \"drawer.close\" } }\npage_drawer -> sheet_drawer_float [say=\"Tap Daily float report.\"] { DO TAP { \"target\": \"drawer.float\" } }\npage_drawer -> sheet_drawer_swap [say=\"Tap Swap my cash.\"] { DO TAP { \"target\": \"drawer.swap\" } }\nsheet_drawer_open -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_drawer_close -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_drawer_float -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_drawer_swap -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_drawer -> sheet_cash_give [say=\"Give cash.\"] { DO TAP { \"target\": \"drawer.givecash\" } }\npage_drawer -> sheet_cash_return [say=\"Return cash.\"] { DO TAP { \"target\": \"drawer.returncash\" } }\nsheet_cash_give -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"cash.gave\" } }\nsheet_cash_return -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_saved -> sheet_saved_name [say=\"Tap Save cart.\"] { DO TAP { \"target\": \"saved.save\" } }\nsheet_saved_name -> page_saved [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_staff -> sheet_switch_staff [say=\"Tap the staff member.\"] { DO TAP { \"target\": \"staff.switch\" } }\nsheet_switch_staff -> page_staff [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_staff -> sheet_staff_pass [say=\"Tap the pass.\"] { DO TAP { \"target\": \"staff.pass\" } }\nsheet_staff_pass -> page_staff [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\ntab_inventory -> sheet_inventory_filters [say=\"Tap Filters & sort.\"] { DO TAP { \"target\": \"inv.filter\" } }\ntab_inventory -> sheet_inventory_product [say=\"Tap a product.\"] { DO TAP { \"target\": \"inv.product\" } }\ntab_inventory -> sheet_lookup [say=\"Tap Look up.\"] { DO TAP { \"target\": \"inv.lookup\" } }\nsheet_inventory_filters -> tab_inventory [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_inventory_product -> tab_inventory [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_lookup -> tab_inventory [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\ntab_checkout -> sheet_tile [say=\"Tap the tile.\"] { DO TAP { \"target\": \"tile.settings\" } }\nsheet_tile -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\n\n# ------------------------------------------------------------- overlays ----\n# `modules` says which run a place belongs to: a training module id, or \"real\" for the everyday till. Only the places\n# that differ carry it; everything else is in every scope. The camera is the clear case: the everyday till opens the\n# real camera, while practice opens the drawn practice camera (see src/screens/Scanner.tsx).\nSCREEN overlay_lock \"Sign in\" { \"kind\": \"overlay\", \"label\": \"Sign in\" }\nSCREEN overlay_screensaver \"Screensaver\" { \"kind\": \"overlay\", \"label\": \"Screensaver\" }\nSCREEN overlay_practice_pass \"Scan your cashier pass\" { \"kind\": \"overlay\", \"label\": \"Scan your cashier pass\", \"modules\": [\"sign-in\"] }\nSCREEN overlay_practice_camera \"Practice camera\" { \"kind\": \"overlay\", \"label\": \"Practice camera\", \"modules\": [\"scanning\"] }\nSCREEN overlay_camera \"Camera\" { \"kind\": \"overlay\", \"label\": \"Camera\", \"modules\": [\"real\"] }\n\noverlay_lock -> tab_checkout [say=\"Unlock the till.\"] { DO TAP { \"target\": \"login.unlock\" } }\noverlay_lock -> tab_checkout [say=\"Unlock the till.\"] { DO TAP { \"target\": \"login.pinpad\" } }\noverlay_lock -> overlay_practice_pass [say=\"Tap Scan pass.\", modules=[\"sign-in\"]] { DO TAP { \"target\": \"login.scanpass\" } }\noverlay_practice_pass -> tab_checkout [say=\"Tap Scan this pass.\"] { DO TAP { \"target\": \"pass.scan\" } }\noverlay_camera -> tab_checkout [say=\"Tap Done.\"] { DO TAP { \"target\": \"scan.done\" } }\ntab_checkout -> overlay_camera [say=\"Tap the scan button.\"] { DO TAP { \"target\": \"scan.camera\" } }\noverlay_practice_camera -> tab_checkout [say=\"Tap Done.\"] { DO TAP { \"target\": \"scan.done\" } }\ntab_checkout -> overlay_practice_camera [say=\"Tap the scan button.\"] { DO TAP { \"target\": \"scan.camera\" } }\noverlay_screensaver -> tab_checkout [say=\"Tap the screen.\"] { DO TAP { \"target\": \"screensaver.tap\" } }\n\nEND\n";
 
 export const APP_NAVSCHEMA: Record<string, unknown> = {"$schema":"https://routegraph.dev/schema/v1","schemaVersion":1,"name":"aidens3dp-pos","extends":"default","actions":{},"screenMetadata":{"kind":{"type":"string","enum":["app","tab","page","sheet","overlay","view","list","action"],"description":"What sort of place this node is. Used to word guidance and to reason about layers."},"label":{"type":"string","description":"What a person calls this place. Falls back to the screen name."},"tab":{"type":"string","description":"The bottom-bar tab this place belongs to, when it belongs to one."},"route":{"type":"string","description":"The pushed page this place is, when it is a page."},"roles":{"type":"array","items":{"type":"string"},"description":"Which staff roles may reach this place (cashier, manager, owner). Empty or missing means anyone."},"summary":{"type":"string","description":"One plain line about what this place is for."},"modules":{"type":"array","items":{"type":"string"},"description":"Which scopes this place exists in: a training module id (see src/training/index.ts), or \"real\" for the everyday till. Empty or missing means every scope, so only the places that differ carry it. Guidance never routes a run through a place outside its scope."}},"edgeMetadata":{"say":{"type":"string","description":"The words said while pointing at the control on this transition. Guidance prefixes the fix wording with this."},"gesture":{"type":"string","description":"tap, double, triple, hold, swipe-left, swipe-right, swipe-up, swipe-down, scroll-up, scroll-down. Left out is a tap."},"spot":{"type":"string","description":"The UI spot id this transition taps, when it has one. The runtime also learns this from the action payload."},"roles":{"type":"array","items":{"type":"string"},"description":"Which roles may take this transition. Empty or missing means anyone."},"modules":{"type":"array","items":{"type":"string"},"description":"Which scopes this transition exists in: a training module id, or \"real\" for the everyday till. Empty or missing means every scope. A transition is only used when the place it arrives at is also in scope."}}};
