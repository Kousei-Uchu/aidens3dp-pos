iagnostics\", \"label\": \"Support & diagnostics\", \"summary\": \"Support and diagnostics for when something is not working.\", \"keywords\": [\"troubleshoot\", \"problem\", \"error\", \"fault\", \"sync\", \"logs\", \"support\"] }\nSCREEN page_help \"Help\" { \"kind\": \"page\", \"route\": \"help\", \"label\": \"Help\", \"summary\": \"The built in help pages.\", \"keywords\": [\"manual\", \"guide\", \"instructions\", \"how to\", \"documentation\"] }\nSCREEN page_assistant \"Ask the assistant\" { \"kind\": \"page\", \"route\": \"assistant\", \"label\": \"Ask the assistant\", \"summary\": \"Chat with the Help assistant.\", \"keywords\": [\"ask\", \"chatbot\", \"ai\", \"question\"] }\nSCREEN page_training \"Training\" { \"kind\": \"page\", \"route\": \"training\", \"label\": \"Training\", \"summary\": \"Practice the till with guided lessons on safe practice data.\", \"keywords\": [\"learn\", \"lessons\", \"practice\", \"training mode\", \"trainee\"] }\nSCREEN page_training_run \"Training run\" { \"kind\": \"page\", \"route\": \"trainingRun\", \"label\": \"Training run\", \"summary\": \"A running practice lesson.\", \"keywords\": [\"lesson\", \"practice\", \"exercise\"] }\nSCREEN page_terminal_play \"Practice terminal\" { \"kind\": \"page\", \"route\": \"terminalPlay\", \"label\": \"Practice terminal\", \"summary\": \"A practice card terminal for trying card payments safely.\", \"keywords\": [\"practice card reader\", \"practice terminal\", \"tap card\"] }\n\n# Checkout to payment and cart\ntab_checkout -> page_cart [say=\"Open the cart first.\"] { DO TAP { \"target\": \"cart.open\" } }\npage_cart -> tab_checkout [say=\"Tap Back to return.\"] { DO TAP { \"target\": \"page.back\" } }\ntab_checkout -> page_pay [say=\"Tap Charge.\"] { DO TAP { \"target\": \"cart.charge\" } }\npage_cart -> page_pay [say=\"Tap Charge.\"] { DO TAP { \"target\": \"cart.charge\" } }\npage_pay -> page_cart [say=\"Tap Back to return.\"] { DO TAP { \"target\": \"page.back\" } }\npage_pay -> tab_c