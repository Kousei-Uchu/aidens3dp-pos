ce\", \"agreed price\"] }\nSCREEN sheet_review \"Check the price adjustments\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Check the price adjustments\", \"summary\": \"Check the price adjustments before payment.\", \"keywords\": [\"review adjustments\", \"price changes\", \"confirm discounts\"] }\nSCREEN sheet_bundles \"Check these bundles\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Check these bundles\", \"summary\": \"Check bundle deals found in the cart before payment.\", \"keywords\": [\"bundle deal\", \"buy together\", \"multi buy\"] }\nSCREEN sheet_cart_warnings \"Customer warning\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Customer warning\", \"summary\": \"A customer warning shown at Charge when the cart holds a flagged item.\", \"keywords\": [\"warning\", \"fragile\", \"prompt\", \"reminder at charge\"] }\nSCREEN sheet_save_cart \"Save cart\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Save cart\", \"summary\": \"Save the cart to finish later.\", \"keywords\": [\"park\", \"hold sale\", \"put on hold\", \"save sale\"] }\n\ntab_checkout -> sheet_search [say=\"Tap Search.\"] { DO TAP { \"target\": \"find.search\" } }\nsheet_search -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\ntab_checkout -> sheet_customer [say=\"Tap the customer row.\"] { DO TAP { \"target\": \"cart.customer\" } }\npage_cart -> sheet_customer [say=\"Tap the customer row.\"] { DO TAP { \"target\": \"cart.customer\" } }\nsheet_customer -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_customer -> sheet_customer_new [say=\"Tap Create customer.\"] { DO TAP { \"target\": \"customer.create\" } }\nsheet_customer_new -> sheet_customer [say=\"Tap Back.\"] { DO TAP { \"target\": \"customer.back\" } }\ntab_checkout -> sheet_custom_amount [say=\"Tap Custom amount.\"] { DO TAP { \"target\": \"grid.action:custom\" } }\nsheet_custom_amount -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_cart_menu -> sheet_gift_sell [say=\"Tap Sell gift card.\"] { DO TAP { \"target\": \"cart.menu.gift\" } }\nsheet_gift_sell -> sheet_gift_sell_details [say=\"Tap Next.\"] { DO TAP { \"target\": \"gift.next\" } }\nsheet_gift_sell_details -> sheet_gift_sell [say=\"Tap Change amount.\"] { DO TAP { \"target\": \"gift.change\" } }\nsheet_gift_sell_details -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_gift_sell -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\n\npage_cart -> sheet_cart_menu [say=\"Tap the three dots in the cart.\"] { DO TAP { \"target\": \"cart.menu\" } }\ntab_checkout -> sheet_cart_menu [say=\"Tap the three dots in the cart.\"] { DO TAP { \"target\": \"cart.menu\" } }\nsheet_cart_menu -> page_cart [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_cart_menu -> sheet_cart_discount [say=\"Tap Apply cart discount.\"] { DO TAP { \"target\": \"cart.menu.discount\" } }\nsheet_cart_menu -> sheet_order_price [say=\"Tap Whole order price.\"] { DO TAP { \"target\": \"cart.menu.order\" } }\nsheet_cart_menu -> sheet_save_cart [say=\"Tap Save cart.\"] { DO TAP { \"target\": \"cart.menu.save\" } }\nsheet_cart_discount -> sheet_cart_menu [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_order_price -> page_cart [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\ntab_checkout -> sheet_order_price [say=\"Tap Whole order price.\"] { DO TAP { \"target\": \"cart.menu.order\" } }\nsheet_save_cart -> sheet_cart_menu [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\n\npage_cart -> sheet_review [say=\"Tap Charge.\"] { DO TAP { \"target\": \"cart.charge\" } }\ntab_checkout -> sheet_review [say=\"Tap Charge.\"] { DO TAP { \"target\": \"cart.charge\" } }\nsheet_review -> page_pay [say=\"Tap Continue to payment.\"] { DO TAP { \"target\": \"review.continue\" } }\nsheet_review -> page_cart [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\ntab_checkout -> sheet_bundles [say=\"Tap Charge.\"] { DO TAP { \"target\": \"cart.charge\" } }\nsheet_bundles -> page_pay [say=\"Tap Continue to payment.\"] { DO TAP { \"target\": \"bundle.continue\" } }\nsheet_bundles -> page_cart [say=\"Tap Edit cart.\"] { DO TAP { \"target\": \"bundle.edit\" } }\npage_cart -> sheet_cart_warnings [say=\"Tap Charge.\"] { DO TAP { \"target\": \"cart.charge\" } }\ntab_checkout -> sheet_cart_warnings [say=\"Tap Charge.\"] { DO TAP { \"target\": \"cart.charge\" } }\nsheet_cart_warnings -> page_pay [say=\"Tap Continue to payment.\"] { DO TAP { \"target\": \"warning.continue\" } }\nsheet_cart_warnings -> page_cart [say=\"Tap Back to cart.\"] { DO TAP { \"target\": \"warning.cancel\" } }\n\n# ------------------------------------------------------ Line editor sheets\nSCREEN sheet_line \"Item\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Item\", \"summary\": \"Edit one cart line: discount, price, note and remove.\", \"keywords\": [\"line item\", \"edit item in cart\", \"item window\", \"quantity\", \"note\"] }\nSCREEN sheet_line_discount \"Item discount\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Item discount\", \"summary\": \"Discount one item in the cart.\", \"keywords\": [\"item discount\", \"percent off item\", \"one item cheaper\"] }\nSCREEN sheet_line_item_price \"Item price adjustment\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Item price adjustment\", \"summary\": \"Change the price of an item, per unit.\", \"keywords\": [\"unit price\", \"price override\", \"change price of item\"] }\nSCREEN sheet_line_line_price \"Line price adjustment\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Line price adjustment\", \"summary\": \"Change the price of the whole line.\", \"keywords\": [\"line total\", \"price for the line\", \"set line price\"] }\n\n# The per line copies (sheet_line:<key>) and their controls are registered at\n# runtime as each line window opens (see `ensureLineWindow` in appGraph). These\n# static edges are the template: each copy fills $ITEM_KEY$ with its own line.\npage_cart -> sheet_line [say=\"Open the item's window first.\"] { DO TAP { \"target\": \"cart.line:$ITEM_KEY$\" } }\ntab_checkout -> sheet_line [say=\"Open the item's window first.\"] { DO TAP { \"target\": \"cart.line:$ITEM_KEY$\" } }\nsheet_line -> tab_checkout [say=\"Tap Done to close the item.\"] { DO TAP { \"target\": \"line.done\" } }\nsheet_line -> page_cart [say=\"Close this window first.\"] { DO TAP { \"target\": \"line.done\" } }\nsheet_line -> sheet_line_discount [say=\"Tap Discount.\"] { DO TAP { \"target\": \"line.discount\" } }\nsheet_line -> sheet_line_item_price [say=\"Tap Item price adjustment.\"] { DO TAP { \"target\": \"line.price\" } }\nsheet_line -> sheet_line_line_price [say=\"Tap Line price adjustment.\"] { DO TAP { \"target\": \"line.adjust\" } }\nsheet_line_discount -> sheet_line [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_line_item_price -> sheet_line [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_line_line_price -> sheet_line [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\n\n# ----------------------------------------------------------------- Payment --\nSCREEN sheet_cash_receive \"Cash received\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Cash received\", \"summary\": \"Tap the notes and coins the customer handed over.\", \"keywords\": [\"cash tendered\", \"cash received\", \"amount given\", \"customer cash\"] }\nSCREEN sheet_cash_change \"Give change\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Give change\", \"summary\": \"Shows the change to give from the drawer.\", \"keywords\": [\"give change\", \"change due\", \"notes and coins to give\"] }\nSCREEN sheet_check_change \"Check change\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Check change\", \"summary\": \"Check, before taking notes, whether the drawer can make the change.\", \"keywords\": [\"can make change\", \"change check\", \"enough change\"] }\nSCREEN sheet_split \"Split amount\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Split amount\", \"summary\": \"Split the bill equally or by an amount.\", \"keywords\": [\"split payment\", \"part payment\", \"pay in pieces\", \"share the bill\"] }\nSCREEN sheet_gift_check \"Check gift card\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Check gift card\", \"summary\": \"Scan or type a gift card code to pay with it.\", \"keywords\": [\"pay with gift card\", \"gift card code\", \"voucher payment\"] }\nSCREEN sheet_receipt \"Receipt\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Receipt\", \"summary\": \"The receipt after a sale: QR, email, text or share.\", \"keywords\": [\"send receipt\", \"email receipt\", \"receipt qr\", \"print receipt\", \"invoice\"] }\n\npage_pay -> sheet_cash_receive [say=\"Tap Cash.\"] { DO TAP { \"target\": \"pay.cash\" } }\npage_pay -> sheet_split [say=\"Tap Split.\"] { DO TAP { \"target\": \"pay.split\" } }\nsheet_split -> page_pay [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_cash_receive -> sheet_cash_change [say=\"Tap Next: give change.\"] { DO TAP { \"target\": \"cash.next\" } }\nsheet_cash_receive -> page_pay [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_cash_change -> page_pay [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_pay -> sheet_check_change [say=\"Check the change.\"] { DO TAP { \"target\": \"pay.cash\" } }\npage_pay -> sheet_gift_check [say=\"Tap Gift card.\"] { DO TAP { \"target\": \"pay.gift\" } }\nsheet_gift_check -> page_pay [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_pay -> sheet_receipt [say=\"Finish the sale.\"] { DO TAP { \"target\": \"pay.card\" } }\nsheet_receipt -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"receipt.none\" } }\n\n# ---------------------------------------------------------- Orders & refund -\nSCREEN sheet_order \"Order\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Order\", \"summary\": \"One order: its items, payments and the refund button.\", \"keywords\": [\"order details\", \"view sale\", \"reprint receipt\"] }\nSCREEN sheet_refund \"Return\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Return\", \"summary\": \"Choose what is coming back and how to refund it.\", \"keywords\": [\"refund\", \"refund a sale\", \"return\", \"exchange\", \"give money back\", \"restock\"] }\nSCREEN sheet_refund_pick \"Replacement item\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Replacement item\", \"summary\": \"Pick the replacement item for an exchange.\", \"keywords\": [\"exchange\", \"swap item\", \"replacement\"] }\nSCREEN sheet_refund_done \"Done\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Done\", \"summary\": \"The refund is finished.\", \"keywords\": [\"refund complete\", \"refund result\"] }\n\npage_orders -> sheet_order [say=\"Tap the order.\"] { DO TAP { \"target\": \"order.row\" } }\nsheet_order -> page_orders [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_order -> sheet_refund [say=\"Tap Refund or return.\"] { DO TAP { \"target\": \"orders.refund\" } }\nsheet_refund -> page_orders [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_refund -> sheet_refund_pick [say=\"Tap Add replacement item.\"] { DO TAP { \"target\": \"refund.replace\" } }\nsheet_refund_pick -> sheet_refund [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_refund -> sheet_refund_done [say=\"Tap the refund button.\"] { DO TAP { \"target\": \"refund.go\" } }\nsheet_refund_done -> page_orders [say=\"Tap OK.\"] { DO TAP { \"target\": \"refund.done\" } }\n\n# ------------------------------------------------------- More page sheets ---\nSCREEN sheet_reports_filter \"Customise\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Customise\", \"summary\": \"Choose the report period and register.\", \"keywords\": [\"date range\", \"period\", \"today\", \"week\", \"month\", \"register filter\"] }\nSCREEN sheet_drawer_open \"Open drawer\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Open drawer\", \"summary\": \"Open the drawer with a float, or record paid in and out.\", \"keywords\": [\"start of day\", \"opening float\", \"paid in\", \"paid out\", \"open till\"] }\nSCREEN sheet_drawer_close \"Close drawer\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Close drawer\", \"summary\": \"Count and close the drawer.\", \"keywords\": [\"end of day\", \"cash up\", \"close till\", \"count drawer\", \"reconcile\"] }\nSCREEN sheet_drawer_float \"Daily float report\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Daily float report\", \"summary\": \"The daily float report: takings, banking and the float to leave.\", \"keywords\": [\"banking\", \"float\", \"bank run\", \"cash takings\", \"deposit\"] }\nSCREEN sheet_drawer_swap \"Swap my cash\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Swap my cash\", \"summary\": \"Enter your own cash to see what to swap with the drawer.\", \"keywords\": [\"swap cash\", \"change float\", \"exchange notes\", \"break notes\"] }\nSCREEN sheet_cash_give \"Give cash refund\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Give cash refund\", \"summary\": \"Give a cash refund from the drawer.\", \"keywords\": [\"cash refund\", \"give cash back\"] }\nSCREEN sheet_cash_return \"Return cash for cancelled sale\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Return cash for cancelled sale\", \"summary\": \"Return cash for a cancelled sale.\", \"keywords\": [\"cancelled sale cash\", \"void cash\"] }\nSCREEN sheet_switch_staff \"Switch staff\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Switch staff\", \"summary\": \"Switch to another staff member.\", \"keywords\": [\"change user\", \"change cashier\", \"swap staff\", \"log in as\"] }\nSCREEN sheet_staff_pass \"Staff pass\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Staff pass\", \"summary\": \"A staff member's cashier pass.\", \"keywords\": [\"pass\", \"qr\", \"badge\", \"print pass\", \"wallet\"] }\nSCREEN sheet_tile \"Add to grid\" { \"kind\": \"sheet\", \"tab\": \"more\", \"label\": \"Add to grid\", \"summary\": \"Add or edit a tile on the Quick Menu grid.\", \"keywords\": [\"quick menu\", \"grid\", \"button\", \"shortcut\", \"edit tile\"] }\nSCREEN sheet_inventory_filters \"Filters & sort\" { \"kind\": \"sheet\", \"tab\": \"inventory\", \"label\": \"Filters & sort\", \"summary\": \"Filter and sort the inventory list.\", \"keywords\": [\"sort\", \"filter stock\", \"low stock\", \"out of stock\"] }\nSCREEN sheet_inventory_product \"Product\" { \"kind\": \"sheet\", \"tab\": \"inventory\", \"label\": \"Product\", \"summary\": \"One product: stock by variation, with receive, adjust and count.\", \"keywords\": [\"stock count\", \"receive stock\", \"adjust stock\", \"stocktake\", \"variants\"] }\nSCREEN sheet_lookup \"Look up\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Look up\", \"summary\": \"Check a price and its deals, or check stock, without selling.\", \"keywords\": [\"price check\", \"stock check\", \"scan to check\", \"how much is\", \"do we have\"] }\n\npage_reports -> sheet_reports_filter [say=\"Tap Customise.\"] { DO TAP { \"target\": \"reports.filter\" } }\nsheet_reports_filter -> page_reports [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_drawer -> sheet_drawer_open [say=\"Tap Open drawer.\"] { DO TAP { \"target\": \"drawer.open\" } }\npage_drawer -> sheet_drawer_close [say=\"Tap Close drawer.\"] { DO TAP { \"target\": \"drawer.close\" } }\npage_drawer -> sheet_drawer_float [say=\"Tap Daily float report.\"] { DO TAP { \"target\": \"drawer.float\" } }\npage_drawer -> sheet_drawer_swap [say=\"Tap Swap my cash.\"] { DO TAP { \"target\": \"drawer.swap\" } }\nsheet_drawer_open -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_drawer_close -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_drawer_float -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_drawer_swap -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_drawer -> sheet_cash_give [say=\"Give cash.\"] { DO TAP { \"target\": \"drawer.givecash\" } }\npage_drawer -> sheet_cash_return [say=\"Return cash.\"] { DO TAP { \"target\": \"drawer.returncash\" } }\nsheet_cash_give -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"cash.gave\" } }\nsheet_cash_return -> page_drawer [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_staff -> sheet_switch_staff [say=\"Tap the staff member.\"] { DO TAP { \"target\": \"staff.switch\" } }\nsheet_switch_staff -> page_staff [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\npage_staff -> sheet_staff_pass [say=\"Tap the pass.\"] { DO TAP { \"target\": \"staff.pass\" } }\nsheet_staff_pass -> page_staff [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\ntab_inventory -> sheet_inventory_filters [say=\"Tap Filters & sort.\"] { DO TAP { \"target\": \"inv.filter\" } }\ntab_inventory -> sheet_inventory_product [say=\"Tap a product.\"] { DO TAP { \"target\": \"inv.product\" } }\nsheet_inventory_filters -> tab_inventory [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_inventory_product -> tab_inventory [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\ntab_checkout -> sheet_lookup [say=\"Tap Price check.\"] { DO TAP { \"target\": \"grid.action:price_check\" } }\ntab_checkout -> sheet_lookup [say=\"Tap Stock check.\"] { DO TAP { \"target\": \"grid.action:stock_check\" } }\nsheet_lookup -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\ntab_checkout -> sheet_tile [say=\"Tap the tile.\"] { DO TAP { \"target\": \"tile.settings\" } }\nsheet_tile -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\n\n# ------------------------------------------------------------- overlays ----\n# `modules` says which run a place belongs to: a training module id, or \"real\" for the everyday till. Only the places\n# that differ carry it; everything else is in every scope. The camera is the clear case: the everyday till opens the\n# real camera, while practice opens the drawn practice camera (see src/screens/Scanner.tsx).\nSCREEN overlay_lock \"Sign in\" { \"kind\": \"overlay\", \"label\": \"Sign in\" }\nSCREEN overlay_screensaver \"Screensaver\" { \"kind\": \"overlay\", \"label\": \"Screensaver\" }\nSCREEN overlay_practice_pass \"Scan your cashier pass\" { \"kind\": \"overlay\", \"label\": \"Scan your cashier pass\", \"modules\": [\"sign-in\"] }\nSCREEN overlay_practice_camera \"Practice camera\" { \"kind\": \"overlay\", \"label\": \"Practice camera\", \"modules\": [\"scanning\"] }\nSCREEN overlay_camera \"Camera\" { \"kind\": \"overlay\", \"label\": \"Camera\", \"modules\": [\"real\"] }\n\noverlay_lock -> tab_checkout [say=\"Unlock the till.\"] { DO TAP { \"target\": \"login.unlock\" } }\noverlay_lock -> tab_checkout [say=\"Unlock the till.\"] { DO TAP { \"target\": \"login.pinpad\" } }\noverlay_lock -> overlay_practice_pass [say=\"Tap Scan pass.\", modules=[\"sign-in\"]] { DO TAP { \"target\": \"login.scanpass\" } }\noverlay_practice_pass -> tab_checkout [say=\"Tap Scan this pass.\"] { DO TAP { \"target\": \"pass.scan\" } }\noverlay_camera -> tab_checkout [say=\"Tap Done.\"] { DO TAP { \"target\": \"scan.done\" } }\ntab_checkout -> overlay_camera [say=\"Tap the scan button.\"] { DO TAP { \"target\": \"scan.camera\" } }\noverlay_practice_camera -> tab_checkout [say=\"Tap Done.\"] { DO TAP { \"target\": \"scan.done\" } }\ntab_checkout -> overlay_practice_camera [say=\"Tap the scan button.\"] { DO TAP { \"target\": \"scan.camera\" } }\noverlay_screensaver -> tab_checkout [say=\"Tap the screen.\"] { DO TAP { \"target\": \"screensaver.tap\" } }\n\nEND\n";
 
