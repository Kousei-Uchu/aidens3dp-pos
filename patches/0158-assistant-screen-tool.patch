+export const APP_NAVGRAPH: string = "NAVGRAPH/2\nAPP \"Aidens 3D POS\"\n\n# The line key of a per line window (its variant, or the line's own id for a\n# custom amount). The `sheet_line` template below is copied once per open line\n# at runtime, and the copy fills this in (see `ensureLineWindow` in appGraph).\nVAR ITEM_KEY : string\n\n# ============================================================================\n# The app as a graph. Screens are places a person can be. Edges are how they\n# move and what they do. Control level action nodes are registered at runtime\n# from src/lib/appControls.ts (node id = \"do:\" + spot id), so every button,\n# tile, row and gesture in the app joins this graph without hand editing.\n#\n# Node kinds (screen meta \"kind\"):\n#   tab      the five bottom bar tabs\n#   view     a mode inside Checkout (Keypad, All products; Quick Menu is the tab)\n#   page     a pushed route\n#   sheet    a window drawn over the page\n#   overlay  something drawn over everything (sign in, screensaver, practice)\n#   action   a control, a terminal node in a route\n#\n# Edge meta:\n#   say      the words said while pointing at this transition\n#   gesture  tap (default), or a swipe/hold/scroll\n#   spot     the UI spot this transition taps, when it has one\n#   roles    who may take it\n#   modules  which run the transition belongs to (a module id, or \"real\"); missing means every run\n# ============================================================================\n\n# ---------------------------------------------------------------- tabs -----\nSCREEN tab_checkout \"Checkout\" { \"kind\": \"tab\", \"tab\": \"checkout\", \"label\": \"Checkout\", \"summary\": \"Build the sale and take payment.\", \"keywords\": [\"sell\", \"new sale\", \"quick menu\", \"start a sale\", \"home\", \"till\"] }\nSCREEN tab_inventory \"Inventory\" { \"kind\": \"tab\", \"tab\": \"inventory\", \"label\": \"Inventory\", \"summary\": \"Search the catalogue, see stock levels and receive, adjust or count stock.\", \"keywords\": [\"stock\", \"stock levels\", \"count\", \"receive\", \"adjust\", \"products\", \"catalogue\"] }\nSCREEN tab_transactions \"Transactions\" { \"kind\": \"tab\", \"tab\": \"transactions\", \"label\": \"Transactions\", \"summary\": \"Past sales and refunds as a timeline.\", \"keywords\": [\"sales history\", \"past sales\", \"timeline\", \"receipts\", \"refund list\"] }\nSCREEN tab_notifications \"Notifications\" { \"kind\": \"tab\", \"tab\": \"notifications\", \"label\": \"Notifications\", \"summary\": \"Notices and alerts for the register.\", \"keywords\": [\"alerts\", \"notices\", \"messages\"] }\nSCREEN tab_more \"More\" { \"kind\": \"tab\", \"tab\": \"more\", \"label\": \"More\", \"summary\": \"The menu of the other pages, such as orders, items, customers, reports, the cash drawer and help.\", \"keywords\": [\"menu\", \"other pages\", \"menu list\"] }\n\ntab_checkout -> tab_inventory [say=\"Tap Inventory.\"] { DO TAP { \"target\": \"tab.inventory\" } }\ntab_checkout -> tab_transactions [say=\"Tap Transactions.\"] { DO TAP { \"target\": \"tab.transactions\" } }\ntab_checkout -> tab_notifications [say=\"Tap Notifications.\"] { DO TAP { \"target\": \"tab.notifications\" } }\ntab_checkout -> tab_more [say=\"Tap More.\"] { DO TAP { \"target\": \"tab.more\" } }\ntab_inventory -> tab_checkout [say=\"Tap Checkout.\"] { DO TAP { \"target\": \"tab.checkout\" } }\ntab_inventory -> tab_transactions [say=\"Tap Transactions.\"] { DO TAP { \"target\": \"tab.transactions\" } }\ntab_inventory -> tab_notifications [say=\"Tap Notifications.\"] { DO TAP { \"target\": \"tab.notifications\" } }\ntab_inventory -> tab_more [say=\"Tap More.\"] { DO TAP { \"target\": \"tab.more\" } }\ntab_transactions -> tab_checkout [say=\"Tap Checkout.\"] { DO TAP { \"target\": \"tab.checkout\" } }\ntab_transactions -> tab_inventory [say=\"Tap Inventory.\"] { DO TAP { \"target\": \"tab.inventory\" } }\ntab_transactions -> tab_notifications [say=\"Tap Notificat