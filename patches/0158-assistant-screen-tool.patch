+ */
+export function searchScreenList(ctx: Pick<ToolContext, 'screens' | 'role'>, query: string, max = 5): ScreenHit[] {
+  const terms = searchTerms(query).filter(t => !SCREEN_NOISE.has(t)); if (!terms.length) return [];
