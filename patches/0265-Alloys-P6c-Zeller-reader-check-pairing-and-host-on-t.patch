diff --git a/src/alloyhost/AlloyHosts.tsx b/src/alloyhost/AlloyHosts.tsx
new file mode 100644
index 0000000..1c2c79f
--- /dev/null
+++ b/src/alloyhost/AlloyHosts.tsx
@@ -0,0 +1,14 @@
+// Location: src/alloyhost/AlloyHosts.tsx
+// Alloys P6c: mounts every registered Alloy's native host (today only Zeller's reader) around the app, in the same place the Zeller root
+// always was. They are mounted whatever is chosen, because unmounting a card reader's host in the middle of a payment (by changing the
+// choice) would drop the payment; a host that nothing uses sits idle. The list is worked out once so the roots never remount.
+import React from 'react';
+import { ALLOYS } from '../alloys';
+
+type Root = React.ComponentType<{ children: React.ReactNode }>;
+let roots: Root[] | null = null;
+const hostRoots = (): Root[] => (roots ??= ALLOYS.map(a => a.host?.() as Root | undefined).filter((r): r is Root => !!r));
+
+export function AlloyHosts({ children }: { children: React.ReactNode }) {
+  return <>{hostRoots().reduceRight<React.ReactNode>((inner, Root) => <Root>{inner}</Root>, children)}</>;
+}
diff --git a/src/alloyhost/terminal.ts b/src/alloyhost/terminal.ts
index c2ab718..2253c62 100644
--- a/src/alloyhost/terminal.ts
+++ b/src/alloyhost/terminal.ts
@@ -7,3 +7,24 @@ import { appRouter } from './appRouter';
 import type { Router } from './router';
 
 export const currentTerminal = (router: Router = appRouter): TerminalLike | null => router.api('cardTerminal')?.terminal() ?? null;
+
+// ── The reader itself: checking it and pairing it ─────────────────────────────────────────────
+// Both go to whichever Alloy supplies the Card terminal Element. The Alloy's connect is the reader check (it updates the app's reader state
+// exactly as the old check did) and its `pair` is the setup. With no such Alloy (Element off) there is nothing to check or pair.
+import { ALLOYS } from '../alloys';
+import { appCtxFor } from './appRouter';
+import { connectAlloy } from './choice';
+
+const terminalAlloyId = (router: Router): string | undefined => { const v = router.current().selection.cardTerminal; return v && v !== 'off' ? v : undefined; };
+
+/** True when the reader is ready. The reason when not is in `useApp.getState().zeller.message`, as before. */
+export async function checkTerminal(router: Router = appRouter): Promise<boolean> {
+  const id = terminalAlloyId(router); if (!id) return false;
+  return (await connectAlloy(id)).ok;
+}
+/** Null when paired, otherwise what to tell the person. */
+export async function pairTerminal(router: Router = appRouter): Promise<string | null> {
+  const id = terminalAlloyId(router); const a = id ? ALLOYS.find(x => x.id === id) : undefined;
+  if (!a?.pair) return 'No card reader is set up. Choose one in Settings ▸ Connections.';
+  try { return await a.pair(appCtxFor(a.id)); } catch (e) { return e instanceof Error && e.message ? e.message : 'Setup failed'; }
+}
