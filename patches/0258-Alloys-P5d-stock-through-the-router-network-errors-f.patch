+// Location: tests/alloyp5stock.test.ts
+// Alloys P5d: stock (the poll's change check, Receive/Adjust/Count, the Scan stock panel) reaches Shopify through the router, and a network
+// failure that comes back through the Alloy layer is still a network failure to the whole app (this fixes a gap left by 0255 and 0257).
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import * as fake from './helpers/fakeShopify';
+import { useApp } from '../src/state/store';
+import { AlloyNetworkError, AlloyUserError } from '../src/alloykit/errors';
+import { OFF } from '../src/alloykit/types';
+
+useApp.getState().patchSettings({ locationId: 'L1' });
+const lvl = (n: number) => ({ quantities: [{ name: 'available', quantity: n }] });
+const ok = (f: string) => fake.data({ [f]: { userErrors: [] } });
+
+test('isNetworkError is true for Shopify network errors AND Alloy network errors, false for user errors and plain errors', async () => {
+  const c = await import('../src/alloys/shopify/client');
+  assert.equal(c.isNetworkError(new c.ShopifyNetworkError('x')), true); assert.equal(c.isNetworkError(new AlloyNetworkError('x')), true);
+  assert.equal(c.isNetworkError(new c.ShopifyUserError('x')), false); assert.equal(c.isNetworkError(new AlloyUserError('x')), false); assert.equal(c.isNetworkError(new Error('x')), false);
+});
+
+test('a dropped connection on a routed call (catalogue, discounts, stock) is a network error to the app, so the poll says offline and screens say "No connection"', async () => {
+  fake.install(); await fake.signIn();
+  const c = await import('../src/alloys/shopify/client'); const { stockChanges } = await import('../src/alloyhost/stock'); const { loadDiscounts } = await import('../src/alloyhost/discounts');
+  fake.on('inventoryItems', { throws: 'offline' });
+  await assert.rejects(() => stockChanges('2026-11-01T00:00:00Z'), c.isNetworkError);
+  fake.on('automaticDiscountNodes', { throws: 'offline' });
+  await assert.rejects(() => loadDiscounts(), c.isNetworkError);
+});
+
+test('stockChanges: same query as the poll made, levels as a map, and a fresh cursor stamped before the call', async () => {
+  fake.install(); await fake.signIn();
+  const { stockChanges } = await import('../src/alloyhost/stock');
+  fake.on('inventoryItems', fake.data({ inventoryItems: { pageInfo: { hasNextPage: false }, nodes: [{ id: 'I1', inventoryLevel: lvl(5) }, { id: 'I2', inventoryLevel: null }, { id: 'I3', inventoryLevel: lvl(-2) }] } }));
+  const t0 = Date.now();
+  const r = await stockChanges('2026-11-01T00:00:00Z');
+  assert.deepEqual(r!.levels, { I1: 5, I3: -2 }); assert.ok(Date.parse(r!.cursor) >= t0 - 1 && Date.parse(r!.cursor) <= Date.now());
+  assert.deepEqual(fake.lastCall().variables, { q: "updated_at:>'2026-11-01T00:00:00Z'", loc: 'L1', after: null });
+});
+
+test('stockChanges: legacy selection without a login fails with the old words; a chosen setup with Stock off returns null and sends nothing', async () => {
+  fake.install(); const client = await import('../src/alloys/shopify/client'); await client.clearCreds();
+  const { stockChanges } = await import('../src/alloyhost/stock');
+  await assert.rejects(() => stockChanges('x'), /^Error: Shopify is not set up - open More ▸ Settings ▸ Shopify\.$/);
+  fake.install(); await fake.signIn();
+  const { createRouter } = await import('../src/alloyhost/router'); const { ALLOYS } = await import('../src/alloys');
+  const { makeCtx } = await import('../src/alloyhost/ctx'); const { memoryStore } = await import('../src/alloyhost/store');
