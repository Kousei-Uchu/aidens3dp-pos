+// Location: src/alloyhost/stock.ts
+// Alloys P5d: how the half-hourly poll asks what stock changed. On the legacy selection a missing login fails exactly as before (the poll's
+// error state); on a chosen setup with Stock switched off the poll simply has nothing to check and returns null.
+import type { Router } from './router';
+import { appRouter } from './appRouter';
+import { needFeature } from './need';
+
+export type StockChanges = { levels: Record<string, number>; cursor: string };
+
+/** `cursor` is what the last call returned (an ISO time for Shopify). null means this Element is off, so skip the step. */
+export async function stockChanges(cursor: string, router: Router = appRouter): Promise<StockChanges | null> {
+  if (router.current().source === 'saved' && !router.has('stock')) return null;
+  const r = await needFeature('stock', 'changesSince', 'Shopify', router)(cursor);
+  return { levels: Object.fromEntries(r.levels.map(l => [l.itemId, l.quantity])), cursor: r.cursor };
+}
