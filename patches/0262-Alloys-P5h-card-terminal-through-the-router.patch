+// Location: src/alloyhost/terminal.ts
+// Alloys P5h: how a screen gets the card terminal. It is the terminal of whichever Alloy supplies the Card terminal Element (Zeller today),
+// or null when there is none yet (reader still starting, not paired) or the Element is off, which the screens already treat as "reader not
+// ready". In practice mode the Alloy hands back the pretend terminal, exactly as the old `getTerminal` did.
+import type { TerminalLike } from '../lib/zeller';
+import { appRouter } from './appRouter';
+import type { Router } from './router';
+
+export const currentTerminal = (router: Router = appRouter): TerminalLike | null => router.api('cardTerminal')?.terminal() ?? null;
