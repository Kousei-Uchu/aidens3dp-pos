+  assert.ok(readFileSync('src/screens/Diagnostics.tsx', 'utf8').includes("import { checkReader, pairReader } from '../zellerBridge';"));
+  assert.ok(readFileSync('src/screens/Refund.tsx', 'utf8').includes('terminal: currentTerminal()'));
