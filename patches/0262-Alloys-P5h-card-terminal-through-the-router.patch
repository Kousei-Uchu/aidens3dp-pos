+  held = { marker: 'x' };
+  assert.equal(currentTerminal(mk({ cardTerminal: 'off', catalogue: 'shopify', orders: 'shopify', sharedState: 'shopify' })), null);
+  assert.equal(currentTerminal(mk({ cardTerminal: 'zeller', catalogue: 'shopify', orders: 'shopify', sharedState: 'shopify' })) as any, held);
