+// Location: tests/alloyp5terminal.test.ts
+// Alloys P5h: the card terminal. Pay, Refund and Diagnostics get the terminal through the router instead of from the Zeller bridge. Pins
+// that they get the very same terminal object the bridge holds (the pretend one in practice mode), null while the reader has not started,
+// null when the Card terminal Element is off, and that the reader check, pairing and the provider are still the bridge's.
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import Module from 'node:module';
+
+const m: any = Module; const realLoad = m._load; let held: unknown = null;
+m._load = function (req: string, ...rest: unknown[]) { if (/zellerBridge$/.test(req)) return { getTerminal: () => held, checkReader: async () => true, ZellerRoot: null }; return realLoad.call(this, req, ...rest); };
+test.after(() => { m._load = realLoad; });
+
+test('the screens get the same terminal object the bridge holds, and null until the reader has started', async () => {
+  const { currentTerminal } = await import('../src/alloyhost/terminal');
