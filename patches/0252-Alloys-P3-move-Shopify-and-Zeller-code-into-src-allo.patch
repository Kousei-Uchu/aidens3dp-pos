@@ -0,0 +1,59 @@
+// Location: src/lib/shopify/metaobjectBackend.ts
+// The Shopify metaobject side of the shared-state seam (CloudKit sync plan, patch 3). It is the one backend that exists
+// today, and it wraps exactly the calls sync.ts used to make by hand, so swapping the seam in changes no behaviour.
+//
+// The CloudKit backend (patch 4) implements the same interface with record types instead of metaobject types. Nothing above
+// this file should import metaobjects directly any more, so a cut-over is one line and a rollback is that line back.
+import * as meta from './metaobjects';
+import { SHARED_TYPES, type BackendListOptions, type BackendPage, type BackendRow, type SharedBackend, type SharedType } from '../../lib/syncBackend';
+
+/** The shop's name for a shared type, mapped onto the metaobject type that stores it. */
+const META_TYPE: Record<SharedType, string> = {
+  cart: meta.TYPES.cart,
+  layout: meta.TYPES.layout,
+  sale: meta.TYPES.sale,
+  rollup: meta.TYPES.rollup,
+  settings: meta.TYPES.settings,
+};
+
+/** The MetaRow the metaobject helpers return, as the backend's own row. They are the same shape, so this is a copy. */
+const asRow = (r: meta.MetaRow): BackendRow => ({ id: r.id, handle: r.handle, updatedAt: r.updatedAt, f: r.f });
+
+/** The metaobject backend: today's transport, behind the seam patch 4 will sit beside. */
+export const metaobjectBackend: SharedBackend = {
+  kind: 'metaobject',
+
+  async ensure(): Promise<void> {
+    // The definition write is the same one Settings ▸ Set up shared storage calls, so a first run and that button do the same thing.
+    await meta.ensureDefinitions();
+  },
+
+  async get(type: SharedType, handle: string): Promise<BackendRow | null> {
+    const row = await meta.getByHandle(META_TYPE[type], handle);
+    return row ? asRow(row) : null;
+  },
+
+  async put(type: SharedType, handle: string, fields: Record<string, string | number | undefined | null>): Promise<BackendRow> {
+    return asRow(await meta.upsert(META_TYPE[type], handle, fields));
+  },
+
+  async list(type: SharedType, options: BackendListOptions = {}): Promise<BackendPage> {
+    const { rows, next } = await meta.list(META_TYPE[type], { first: options.first, after: options.after });
+    return { rows: rows.map(asRow), next };
+  },
+
+  async remove(id: string): Promise<void> {
+    await meta.remove(id);
+  },
+
+  // A sale's `sale_json` field is added to the definition on demand; until it exists the row still uploads without it.
+  async detailReady(type: SharedType): Promise<boolean> {
+    return type === 'sale' ? meta.ensureSaleDetailField() : true;
+  },
+};
+
+/** Every shared type has a metaobject behind it. Exported so a test can prove the map is complete. */
+export const metaTypeFor = (type: SharedType): string => META_TYPE[type];
+
+/** The types this backend covers, in the order the plan lists them. */
+export const metaBackendTypes = (): SharedType[] => [...SHARED_TYPES];
diff --git a/src/alloys/shopify/metaobjects.ts b/src/alloys/shopify/metaobjects.ts
new file mode 100644
index 0000000..f1db665
--- /dev/null
+++ b/src/alloys/shopify/metaobjects.ts
@@ -0,0 +1,81 @@
+// Shared state between registers lives in Shopify metaobjects (research doc §5): saved carts, layout, sales log,
+// daily rollups, shared settings. Webhooks need a server, so registers POLL these.
+import { gql, throwUserErrors, ShopifyUserError } from './client';
+
+export const TYPES = { cart: 'pos_saved_cart', layout: 'pos_layout', sale: 'pos_sale', rollup: 'pos_daily_rollup', settings: 'pos_settings' } as const;
+type F = [key: string, name: string, type: string];
+const S = 'single_line_text_field', M = 'multi_line_text_field', J = 'json', I = 'number_integer', T = 'date_time';
+
+const DEFS: { type: string; name: string; display?: string; fields: F[] }[] = [
+  { type: TYPES.cart, name: 'POS saved cart', display: 'name', fields: [['cart_uuid', 'Cart UUID', S], ['name', 'Name', S], ['note', 'Note', M], ['customer_json', 'Customer', J],
+    ['employee', 'Employee', S], ['register_id', 'Register', S], ['status', 'Status', S], ['lines_json', 'Lines', J], ['discount_json', 'Cart discount', J],
+    ['created_at', 'Created', T], ['updated_at', 'Updated', T], ['version', 'Version', I], ['locked_by', 'Locked by', S], ['locked_at', 'Locked at', T]] },
+  { type: TYPES.layout, name: 'POS layout', display: 'layout_key', fields: [['layout_key', 'Key', S], ['layout_json', 'Layout', J], ['version', 'Version', I], ['updated_by', 'Updated by', S], ['updated_at', 'Updated', T]] },
+  { type: TYPES.sale, name: 'POS sale', display: 'sale_uuid', fields: [['sale_uuid', 'Sale UUID', S], ['order_gid', 'Order', S], ['register_id', 'Register', S], ['employee', 'Employee', S],
+    ['ts', 'Time', T], ['entry_type', 'Type', S], ['items_cents', 'Items', I], ['discounts_cents', 'Discounts', I], ['total_cents', 'Total', I], ['cogs_cents', 'COGS', I],
+    ['fees_cents', 'Fees', I], ['rounding_cents', 'Rounding', I], ['refund_of', 'Refund of', S], ['status', 'Status', S], ['tenders_json', 'Tenders', J], ['lines_json', 'Lines', J],
+    ['customer_gid', 'Customer', S], ['receipt_link', 'Receipt link', S], ['sale_json', 'Sale data', J]] },
+  { type: TYPES.rollup, name: 'POS daily rollup', display: 'rollup_key', fields: [['rollup_key', 'Key', S], ['register_id', 'Register', S], ['date', 'Date', S], ['totals_json', 'Totals', J]] },
+  { type: TYPES.settings, name: 'POS settings', display: 'settings_key', fields: [['settings_key', 'Key', S], ['settings_json', 'Settings', J], ['version', 'Version', I]] },
+];
+
+export async function ensureDefinitions(): Promise<void> {
+  for (const d of DEFS) {
+    const res = await gql(`mutation($d: MetaobjectDefinitionCreateInput!){ metaobjectDefinitionCreate(definition: $d) { metaobjectDefinition { id } userErrors { field message code } } }`,
+      { d: { type: d.type, name: d.name, displayNameKey: d.display, fieldDefinitions: d.fields.map(([key, name, type]) => ({ key, name, type })) } });
+    const errs = (res.metaobjectDefinitionCreate.userErrors as any[]) ?? [];
+    const real = errs.filter(e => !/taken|already/i.test(`${e.code} ${e.message}`));
+    if (real.length) throw new ShopifyUserError(`Metaobject setup (${d.type}): ${real[0].message}`, real);
+  }
+  await ensureSaleDetailField(); // an older shop's sale definition gets the field the shop-wide sales view needs
+}
+
+/**
+ * Makes sure the sale definition carries the `sale_json` field another till reads to see this till's sales in full (the shop-wide
+ * assistant view). A definition made before that field existed is updated once; one that already has it does nothing. The answer
+ * is remembered for the rest of the app session, and a failure returns false without throwing, so a sale still uploads (without
+ * the detail) when the field cannot be added.
+ */
+let saleDetailReady: boolean | null = null;
+export async function ensureSaleDetailField(): Promise<boolean> {
+  if (saleDetailReady !== null) return saleDetailReady;
+  try {
+    const d = await gql(`query($t:String!){ metaobjectDefinitionByType(type:$t){ id fieldDefinitions { key } } }`, { t: TYPES.sale });
+    const def = d.metaobjectDefinitionByType as { id: string; fieldDefinitions: { key: string }[] } | null;
+    if (!def) { saleDetailReady = false; return false; }
+    if ((def.fieldDefinitions ?? []).some(f => f.key === 'sale_json')) { saleDetailReady = true; return true; }
+    const res = await gql(`mutation($id:ID!,$d:MetaobjectDefinitionUpdateInput!){ metaobjectDefinitionUpdate(id:$id, definition:$d) { userErrors { field message code } } }`,
+      { id: def.id, d: { fieldDefinitions: [{ create: { key: 'sale_json', name: 'Sale data', type: 'json' } }] } });
+    const errs = (res.metaobjectDefinitionUpdate.userErrors as any[]) ?? [];
+    saleDetailReady = !errs.some(e => !/taken|already/i.test(`${e.code} ${e.message}`));
+  } catch { saleDetailReady = false; }
+  return saleDetailReady;
+}
+
+export type MetaRow = { id: string; handle: string; updatedAt: string; f: Record<string, string> };
+const toRow = (n: any): MetaRow => ({ id: n.id, handle: n.handle, updatedAt: n.updatedAt, f: Object.fromEntries((n.fields as any[]).map(x => [x.key, x.value ?? ''])) });
+
+export const handleOf = (s: string) => s.toLowerCase().replace(/[^a-z0-9-]/g, '-').slice(0, 100);
+
+export async function upsert(type: string, handle: string, fields: Record<string, string | number | undefined | null>): Promise<MetaRow> {
+  const d = await gql(`mutation($h: MetaobjectHandleInput!, $m: MetaobjectUpsertInput!){ metaobjectUpsert(handle: $h, metaobject: $m) { metaobject { id handle updatedAt fields { key value } } userErrors { field message code } } }`,
+    { h: { type, handle: handleOf(handle) }, m: { fields: Object.entries(fields).filter(([, v]) => v !== undefined && v !== null).map(([key, v]) => ({ key, value: String(v) })) } });
+  throwUserErrors(d.metaobjectUpsert.userErrors, `Saving ${type}`);
+  return toRow(d.metaobjectUpsert.metaobject);
+}
+
+export async function getByHandle(type: string, handle: string): Promise<MetaRow | null> {
+  const d = await gql(`query($h: MetaobjectHandleInput!){ metaobjectByHandle(handle: $h) { id handle updatedAt fields { key value } } }`, { h: { type, handle: handleOf(handle) } });
+  return d.metaobjectByHandle ? toRow(d.metaobjectByHandle) : null;
+}
+
+export async function list(type: string, o: { first?: number; after?: string | null; reverse?: boolean } = {}): Promise<{ rows: MetaRow[]; next: string | null }> {
+  const d = await gql(`query($t:String!,$n:Int!,$a:String,$r:Boolean){ metaobjects(type:$t, first:$n, after:$a, sortKey:"updated_at", reverse:$r) {
+    pageInfo { hasNextPage endCursor } nodes { id handle updatedAt fields { key value } } } }`, { t: type, n: o.first ?? 50, a: o.after ?? null, r: o.reverse ?? true });
+  return { rows: d.metaobjects.nodes.map(toRow), next: d.metaobjects.pageInfo.hasNextPage ? d.metaobjects.pageInfo.endCursor : null };
+}
+
+export async function remove(id: string) {
+  const d = await gql(`mutation($id:ID!){ metaobjectDelete(id:$id){ deletedId userErrors { field message } } }`, { id });
+  throwUserErrors(d.metaobjectDelete.userErrors, 'Deleting');
+}
diff --git a/src/alloys/shopify/orderModel.ts b/src/alloys/shopify/orderModel.ts
