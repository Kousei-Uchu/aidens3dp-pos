+// Location: src/lib/secrets.ts
+// The shared secrets for the pass, gift-claim and receipt servers. Keychain only. Alloys P3: these lived at the bottom of the Shopify
+// client but belong to the app's own servers, not to Shopify, so they moved here. src/lib/shopify/client.ts still re-exports them.
+import * as SecureStore from 'expo-secure-store';
+import { isTraining } from './trainingGuard';
