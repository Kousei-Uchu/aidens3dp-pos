diff --git a/tests/alloyp7c.test.ts b/tests/alloyp7c.test.ts
new file mode 100644
index 0000000..b76b4bf
--- /dev/null
+++ b/tests/alloyp7c.test.ts
@@ -0,0 +1,73 @@
+// Location: tests/alloyp7c.test.ts
+// Alloys P7c: a shop can run on Pure Tillium with no Shopify at all, and can go back. Runs the real registry and the app's own router, the
+// catalogue import, the order outbox call and the Settings/Setup wording, with a fake Shopify that fails the test if anything reaches it.
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as fake from './helpers/fakeShopify';
+import { useApp } from '../src/state/store';
+import { appRouter } from '../src/alloyhost/appRouter';
+import { saveSelection, clearSelection, LOCAL_LOCATION } from '../src/alloyhost/choice';
+import { catalogueName } from '../src/alloyhost/names';
+import { needFeature } from '../src/alloyhost/need';
+import { alloyReady } from '../src/alloyhost/ready';
+import { ALLOYS } from '../src/alloys';
+import { buildPicker, choose, pickerReady } from '../src/alloykit/picker';
+import { localStoreUseMemory } from '../src/alloyhost/persistentStore';
+localStoreUseMemory();
+import { stepWording, SETUP_STEPS, setupContext } from '../src/lib/setupFlow';
+import { pickShared } from '../src/lib/sharedSettings';
+import { listAllItems } from '../src/alloyhost/catalogue';
+import { refreshDue } from '../src/lib/catalogueRefresh';
+import { readFileSync } from 'node:fs';
+
+const sel = { catalogue: 'tillium', stock: 'tillium', customers: 'tillium', orders: 'tillium', giftCards: 'tillium', discounts: 'tillium', cardTerminal: 'zeller' } as any;
+const sale = (uuid: string): any => ({ uuid, type: 'sale', ts: '2026-11-21T01:00:00Z', registerId: 'r', registerName: 'F', lines: [{ variantId: 'V', title: 'D', qty: 1, baseUnitCents: 500, grossCents: 500, discountCents: 0, netCents: 500, costCents: 0, discountLabels: [], kind: 'item' }], itemsCents: 500, discountCents: 0, netCents: 500, tipCents: 0, totalCents: 500, cogsCents: 0, feesCents: 0, roundingCents: 0, tenders: [{ id: 't', kind: 'cash', amountCents: 500 }], deals: [] });
+
+test('the picker offers Pure Tillium for the shop Elements, and a single-register shop can leave Shared state off', () => {
+  const rows = buildPicker(ALLOYS, {}); const by = Object.fromEntries(rows.map(r => [r.element, r]));
+  for (const e of ['catalogue', 'stock', 'customers', 'orders', 'giftCards', 'discounts']) assert.ok(by[e].options.some(o => o.alloyId === 'tillium'), e);
+  assert.ok(by.catalogue.options.find(o => o.alloyId === 'tillium')!.limits[0].includes('this iPad only'));
+  let draft: any = {}; for (const e of ['catalogue', 'orders']) draft = (choose(draft, e as any, 'tillium', ALLOYS) as any).selection;
+  assert.equal(pickerReady(buildPicker(ALLOYS, draft)).ok, true);
+});
+
+test('saved choice: the till runs on Pure Tillium end to end with nothing sent to Shopify', async () => {
+  fake.install(); useApp.getState().patchSettings({ locationId: 'gid://shopify/Location/9', locationName: 'Shop' });
+  saveSelection(sel);
+  assert.equal(useApp.getState().settings.locationId, LOCAL_LOCATION, 'the built-in location is set so stock and the refresh work'); assert.deepEqual(useApp.getState().settings.priorLocation, { id: 'gid://shopify/Location/9', name: 'Shop' });
+  assert.equal(catalogueName(), 'Pure Tillium'); for (const e of ['catalogue', 'orders', 'stock', 'giftCards'] as const) assert.equal(alloyReady(e), true, e);
+  const ref = await needFeature('catalogue', 'createItem')({ title: 'Dino', priceCents: 1200, stock: 6 });
+  const vs = await listAllItems(); assert.deepEqual(vs.map(v => [v.id, v.priceCents, v.stock]), [[ref.variantId, 1200, 6]], 'what the catalogue import and refresh read');
+  await needFeature('stock', 'adjust')({ itemId: ref.inventoryItemId, delta: -1, reason: 'other', key: 'k' }); assert.equal((await listAllItems())[0].stock, 5);
+  const sync = readFileSync('src/lib/sync.ts', 'utf8'); assert.ok(sync.includes("if (!s.settings.locationId) throw new Error('Pick a location first") && sync.includes('const loc = s.settings.locationId; if (!loc) return;'), 'the import and refresh need only a location to be set, and the built-in one is');
+  const recent = new Date().toISOString();
+  assert.equal(refreshDue(recent, 'gid://shopify/Location/9', LOCAL_LOCATION, Date.now(), 0), true, 'after switching, the next poll reloads the catalogue from the new connection');
+  assert.equal(refreshDue(recent, LOCAL_LOCATION, LOCAL_LOCATION, Date.now(), 0), false, 'and then follows the usual half-hour timer');
+  const o = await needFeature('orders', 'record')(sale('s1'), { key: 's1' }); assert.match(o.name!, /^#T10/);
+  assert.equal((await needFeature('orders', 'list')({ query: 'tag:pos', limit: 25 })).rows[0].id, o.id);
+  assert.equal(fake.gqlCalls().length, 0, 'not one Shopify call');
+});
+
+test('going back to today\'s setup restores the Shopify location, and the local one never reaches other registers', () => {
+  clearSelection(); assert.equal(useApp.getState().settings.locationId, 'gid://shopify/Location/9'); assert.equal(useApp.getState().settings.locationName, 'Shop'); assert.equal(useApp.getState().settings.priorLocation, undefined);
+  assert.equal(appRouter.current().source, 'legacy'); assert.equal(catalogueName(), 'Shopify');
+  saveSelection(sel); for (const kind of ['metaobject', 'cloudkit'] as const) { const out: any = pickShared(useApp.getState().settings, kind); assert.ok(!('locationId' in out) && !('locationName' in out), kind); }
+  clearSelection(); assert.equal((pickShared(useApp.getState().settings, 'cloudkit') as any).locationId, 'gid://shopify/Location/9', 'a Shopify location is shared as before');
+  clearSelection();
+});
+
+test('a shop that was on Pure Tillium with no earlier location comes back with none', () => {
+  useApp.getState().patchSettings({ locationId: undefined, locationName: undefined, priorLocation: undefined });
+  saveSelection(sel); assert.equal(useApp.getState().settings.locationId, LOCAL_LOCATION); clearSelection();
+  assert.equal(useApp.getState().settings.locationId, undefined);
+});
+
+test('setup: Shopify keeps its wording, another connection is named and the step is done without a Shopify login', () => {
+  const step = SETUP_STEPS.find(s => s.id === 'shopify')!;
+  assert.deepEqual(stepWording(step, 'Shopify'), { title: 'Connect Shopify', summary: step.summary });
+  assert.deepEqual(stepWording(step, 'Pure Tillium'), { title: "Choose where the shop's data lives", summary: 'This register is using Pure Tillium. Check the choice under Settings ▸ Connections.' });
+  assert.equal(stepWording(SETUP_STEPS.find(s => s.id === 'pin')!, 'Pure Tillium').title, 'Create the owner PIN');
+  saveSelection(sel); assert.equal(setupContext({}, alloyReady('catalogue')).shopify, true); clearSelection();
+  assert.equal(setupContext({}, alloyReady('catalogue')).shopify, false, 'with today\'s setup and no Shopify login it is still not done');
+});
