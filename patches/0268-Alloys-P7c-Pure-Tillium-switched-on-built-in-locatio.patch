 // a choice is saved: with none saved the router keeps reading today's behaviour (legacySelection).
+import { legacySelection } from '../alloykit/selection';
 import { OFF, type ConnectReport, type Selection } from '../alloykit/types';
 import { ALLOYS } from '../alloys';
 import { useApp } from '../state/store';
@@ -8,9 +9,26 @@ import { appCtxFor } from './appRouter';
 import { readSavedSelection } from './savedSelection';
 export { readSavedSelection };
 
-export const saveSelection = (sel: Selection): void => { useApp.getState().patchSettings({ alloySelection: { ...sel } }); };
+/** The one location the till uses when the catalogue's connection has none of its own (Pure Tillium). Stock and the catalogue refresh both gate on a location being set. */
+export const LOCAL_LOCATION = 'local';
+
+/**
+ * Keeps `settings.locationId` honest for the connection now in use: a connection with locations (Shopify) gets back the location that was
+ * set aside, one without gets the built-in one, and a real location is set aside, never thrown away, so switching back is lossless.
+ */
+export function reconcileLocation(sel: Selection): void {
+  const st = useApp.getState(); const cur = st.settings.locationId; const id = sel.catalogue;
+  const a = id && id !== OFF ? ALLOYS.find(x => x.id === id) : undefined;
+  if (!a) return;
+  if (a.needsLocation) {
+    if (cur === LOCAL_LOCATION) { const p = st.settings.priorLocation; st.patchSettings({ locationId: p?.id, locationName: p?.name, priorLocation: undefined }); }
+  } else if (cur !== LOCAL_LOCATION) {
+    st.patchSettings({ priorLocation: cur ? { id: cur, name: st.settings.locationName } : st.settings.priorLocation, locationId: LOCAL_LOCATION, locationName: 'This iPad' });
+  }
+}
+export const saveSelection = (sel: Selection): void => { useApp.getState().patchSettings({ alloySelection: { ...sel } }); reconcileLocation(sel); };
 /** Goes back to reading today's behaviour. */
-export const clearSelection = (): void => { useApp.getState().patchSettings({ alloySelection: undefined }); };
+export const clearSelection = (): void => { useApp.getState().patchSettings({ alloySelection: undefined }); reconcileLocation(legacySelection({ shopifyConnected: true, sharedBackend: 'metaobject', zellerPaired: true })); };
 export const isOff = (v: string | undefined): boolean => v === OFF;
 
 /** Asks one Alloy to check its sign-in and say what it can do. Never throws: a failure is a report with a problem in plain words. */
