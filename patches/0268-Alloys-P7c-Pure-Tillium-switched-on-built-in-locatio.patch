+// Location: src/alloyhost/names.ts
+// Alloys P7c: what the app calls the service that holds the shop's catalogue, for screens that used to say "Shopify". Today's setup says
+// "Shopify", as it always has; a saved choice says the name of the Alloy it uses.
+import { ALLOYS } from '../alloys';
+import { appRouter } from './appRouter';
+import type { Router } from './router';
+
+export function catalogueName(router: Router = appRouter): string {
+  if (router.current().source === 'legacy') return 'Shopify';
+  const id = router.alloyId('catalogue');
+  return ALLOYS.find(a => a.id === id)?.name ?? 'Shopify';
+}
