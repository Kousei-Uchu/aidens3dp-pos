+// Location: tests/alloyconformance.test.ts
+// Alloys P4b: the conformance suite (dev_docs/ALLOYS.md). Every registered Alloy is held to the same checks, then the Shopify Alloy is run
+// against the fake Shopify to show that each Element function reaches the same Shopify call the app makes today and maps the result.
+import './helpers/fakeShopify'; // installs the module stubs (Keychain, crypto) before anything below loads the Shopify client
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import * as fake from './helpers/fakeShopify';
+import { ALLOYS } from '../src/alloys';
+import { ELEMENT_FUNCTIONS, ELEMENT_IDS } from '../src/alloykit/elements';
+import { featuresOf, validateSelection, legacySelection } from '../src/alloykit/selection';
+import { ALLOY_CONTRACT, type Alloy, type Ctx, type ElementId } from '../src/alloykit/types';
+import { isAlloyNetworkError, isAlloyUserError } from '../src/alloykit/errors';
+import { makeCtx } from '../src/alloyhost/ctx';
+import { memoryStore } from '../src/alloyhost/store';
+import { createRouter } from '../src/alloyhost/router';
+import shopifyAlloy from '../src/alloys/shopify/alloy';
+
+test('the registry lists Shopify, Zeller and iCloud once each, with unique lowercase ids', () => {
+  assert.deepEqual(ALLOYS.map(a => a.id), ['shopify', 'zeller', 'icloud']);
+  for (const a of ALLOYS) assert.match(a.id, /^[a-z][a-z0-9-]*$/);
+});
+
+for (const a of ALLOYS) {
+  test(`conformance: ${a.id} has the format's fields and unique, well-formed settings`, () => {
+    assert.equal(a.contract, ALLOY_CONTRACT); assert.ok(a.name.trim()); assert.ok(a.blurb.trim()); assert.equal(typeof a.connect, 'function');
+    const keys = a.settings.map(s => s.key); assert.equal(new Set(keys).size, keys.length, 'setting keys are unique');
+    for (const s of a.settings) { assert.ok(s.label.trim()); assert.ok(!(s.secret && s.pickFrom), 'a secret is typed, never picked from a list'); }
+  });
+  test(`conformance: ${a.id} offers only real Elements, each with every required function and no function the app does not know`, () => {
+    assert.ok(Object.keys(a.elements).length > 0, 'an Alloy must offer at least one Element');
+    for (const [el, impl] of Object.entries(a.elements) as [ElementId, NonNullable<Alloy['elements'][ElementId]>][]) {
+      assert.ok(ELEMENT_IDS.includes(el), `${el} is an Element`);
+      const names = Object.keys(impl.api); const { required, optional } = ELEMENT_FUNCTIONS[el];
+      for (const r of required) assert.equal(typeof (impl.api as any)[r], 'function', `${a.id}.${el} is missing ${r}`);
+      for (const n of names) assert.ok([...required, ...optional].includes(n), `${a.id}.${el} has ${n}, which is not in the contract`);
+      assert.deepEqual(featuresOf(a, el), names.sort());
+      for (const l of impl.limits ?? []) assert.ok(l.trim().length > 0 && !/[–—]/.test(l), 'limits are plain one-line text');
+    }
+  });
+}
+
+test('the legacy selection of an existing install is fully supported by the registered Alloys', () => {
+  const sel = legacySelection({ shopifyConnected: true, sharedBackend: 'metaobject', zellerPaired: true });
+  assert.deepEqual(validateSelection(sel, ALLOYS), { ok: true, problems: [], off: ['stock', 'discounts', 'customers', 'giftCards', 'tapToPay'].filter(e => !sel[e as ElementId]) });
+  assert.equal(validateSelection(legacySelection({ shopifyConnected: true, sharedBackend: 'cloudkit', zellerPaired: false }), ALLOYS).ok, true);
+});
+
+test('Shopify supplies the six shop Elements and shared state; Zeller the card terminal; iCloud shared state only', () => {
+  const els = (id: string) => Object.keys(ALLOYS.find(a => a.id === id)!.elements).sort();
+  assert.deepEqual(els('shopify'), ['catalogue', 'customers', 'discounts', 'giftCards', 'orders', 'sharedState', 'stock']);
+  assert.deepEqual(els('zeller'), ['cardTerminal']); assert.deepEqual(els('icloud'), ['sharedState']);
+});
+
+// ── the Shopify Alloy against the fake Shopify ──
+const ctx = (settings: Record<string, string> = { locationId: 'L1' }): Ctx => makeCtx('shopify', { secrets: {}, settings: { shopify: settings }, store: memoryStore(), uid: () => 'k', fetchImpl: fetch });
+const ok = (field: string, extra: Record<string, unknown> = {}) => fake.data({ [field]: { ...extra, userErrors: [] } });
+const api = shopifyAlloy.elements;
+const orderNode = (o: any = {}) => ({ id: 'O1', name: '#1001', createdAt: '2026-11-01T00:00:00Z', displayFinancialStatus: 'PAID', displayFulfillmentStatus: 'FULFILLED', note: null, tags: ['pos'],
+  totalPriceSet: { shopMoney: { amount: '18.00' } }, totalRefundedSet: { shopMoney: { amount: '0.00' } }, customer: null, customAttributes: [],
+  lineItems: { nodes: [{ id: 'LI1', title: 'D', variantTitle: null, quantity: 1, refundableQuantity: 1, variant: { id: 'V1' }, originalUnitPriceSet: { shopMoney: { amount: '5.00' } }, discountedUnitPriceSet: { shopMoney: { amount: '5.00' } }, customAttributes: [] }] },
+  transactions: [{ id: 'T1', kind: 'SALE', status: 'SUCCESS', gateway: 'Cash', amountSet: { shopMoney: { amount: '5.00' } } }], ...o });
+
+test('shopify: stock functions use the settings location and the same Shopify mutations; no location is a plain-words user error before anything is sent', async () => {
+  fake.install(); await fake.signIn();
+  fake.on('inventoryAdjustQuantities', ok('inventoryAdjustQuantities'));
+  await api.stock!.api.adjust(ctx(), { itemId: 'I1', delta: -1, reason: 'damaged', key: 'k1' });
+  assert.deepEqual(fake.lastCall().variables.i.changes, [{ delta: -1, inventoryItemId: 'I1', locationId: 'L1' }]);
+  fake.on('inventorySetQuantities', ok('inventorySetQuantities'));
+  await api.stock!.api.set!(ctx(), { itemId: 'I1', quantity: 9, reason: 'cycle_count_available', key: 'k2' });
+  assert.equal(fake.lastCall().variables.i.quantities[0].quantity, 9);
