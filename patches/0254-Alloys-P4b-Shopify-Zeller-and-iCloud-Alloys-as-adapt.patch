+});
+
+test('shopify: items, customers and discounts reach the same calls; names are split first and last', async () => {
+  fake.install(); await fake.signIn();
+  fake.on('productCreate', ok('productCreate', { product: { id: 'P1', variants: { nodes: [{ id: 'V1', inventoryItem: { id: 'I1' } }] } } }));
+  fake.on('productVariantsBulkUpdate', ok('productVariantsBulkUpdate')); fake.on('inventoryActivate', ok('inventoryActivate'));
+  assert.deepEqual(await api.catalogue!.api.createItem!(ctx(), { title: 'Dragon', priceCents: 100 }), { productId: 'P1', variantId: 'V1', inventoryItemId: 'I1' });
+  fake.on('productVariantsBulkUpdate', ok('productVariantsBulkUpdate'));
+  await api.catalogue!.api.updateItem!(ctx(), { productId: 'P1', variantId: 'V1' }, { priceCents: 250 });
+  assert.deepEqual(fake.lastCall().variables, { pid: 'P1', v: [{ id: 'V1', price: '2.50' }] });
