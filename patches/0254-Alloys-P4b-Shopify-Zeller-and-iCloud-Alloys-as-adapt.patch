+  assert.deepEqual(fake.lastCall().variables, { q: 'name:#1001', after: null, first: 5 });
+});
+
+test('shopify: refund reads the order, restocks by default at the settings location, and passes per-tender amounts and the key through', async () => {
+  fake.install(); await fake.signIn();
