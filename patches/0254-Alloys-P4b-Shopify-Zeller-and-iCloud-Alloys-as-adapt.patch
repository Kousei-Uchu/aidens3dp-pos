+  await assert.rejects(() => api.stock!.api.adjust(ctx({}), { itemId: 'I1', delta: 1, reason: 'correction', key: 'k' }), (e: any) => isAlloyUserError(e) && /Choose the Shopify location/.test(e.message));
+  assert.equal(fake.calls.length, before);
+});
+
+test('shopify: changesSince returns the levels and a cursor stamped before the call; no cursor asks for everything', async () => {
+  fake.install(); await fake.signIn();
+  fake.on('inventoryItems', fake.data({ inventoryItems: { pageInfo: { hasNextPage: false }, nodes: [{ id: 'I1', inventoryLevel: { quantities: [{ name: 'available', quantity: 4 }] } }] } }));
+  const t0 = Date.now();
