+// Alloys P4b: the Shopify Alloy. It presents today's Shopify code (the files beside this one) through the Element contracts, and changes
+// none of it. Transport is still the app's existing Shopify client (Keychain login, token, retries); moving that onto `ctx.http` is a
+// later step, so this adapter ignores `ctx` for the network and uses it only for settings (the location). Nothing calls it before P5.
+import { AlloyNetworkError, AlloyUserError } from '../../alloykit/errors';
+import type { Alloy, ConnectReport, Ctx, ElementId, GiftCard, OrderRef } from '../../alloykit/types';
+import { fetchAutoDiscounts, fetchCollections, fetchManualPresets, fetchShop, fetchStockDelta, fetchVariants } from './catalogue';
+import { ShopifyNetworkError, ShopifyUserError, hasCreds, tokenScopes } from './client';
+import { createCustomer, searchRemote, updateCustomer } from './customers';
+import { createGiftCard, creditGiftCard, creditGiftCardOnce, debitGiftCard, debitGiftCardOnce, giftCardHistory, lookupGiftCard, type GiftCardInfo } from './giftcards';
+import { adjustStock, setStock } from './inventory';
+import { metaobjectBackend } from './metaobjectBackend';
+import { createOrderForSale, findOrderBySale, fulfillOrder, getOrder, listOrders, refundOrderInShopify } from './orders';
+import { createItem, updateVariant } from './products';
+
+/** Shopify's own errors become the two kinds an Alloy throws. Anything else (practice mode, a bad argument) passes through unchanged. */
+export async function translate<T>(run: () => Promise<T>): Promise<T> {
+  try { return await run(); }
+  catch (e) {
+    if (e instanceof ShopifyNetworkError) throw new AlloyNetworkError(e.message, e);
+    if (e instanceof ShopifyUserError) throw new AlloyUserError(e.message);
+    throw e;
+  }
+}
+const loc = (ctx: Ctx): string => {
+  const id = ctx.setting('locationId');
+  if (!id) throw new AlloyUserError('Choose the Shopify location for this shop first.', 'locationId');
+  return id;
+};
+const splitName = (name: string) => { const [first, ...rest] = name.trim().split(/\s+/); return { firstName: first || undefined, lastName: rest.join(' ') || undefined }; };
+const toCard = (g: GiftCardInfo): GiftCard => g;
+
+/** Scopes each Element needs from the Shopify app. `write_x` also satisfies `read_x`. */
+const NEEDS: Partial<Record<ElementId, string[]>> = {
+  catalogue: ['read_products', 'write_products'], stock: ['read_inventory', 'write_inventory', 'read_locations'], discounts: ['read_discounts'],
+  customers: ['read_customers', 'write_customers'], orders: ['read_orders', 'write_orders', 'read_fulfillments', 'write_fulfillments'],
+  giftCards: ['read_gift_cards', 'write_gift_cards', 'write_gift_card_transactions'],
+  sharedState: ['read_metaobjects', 'write_metaobjects', 'read_metaobject_definitions', 'write_metaobject_definitions'],
+};
+const has = (granted: string[], need: string) => granted.includes(need) || (need.startsWith('read_') && granted.includes(need.replace('read_', 'write_')));
+
+const alloy: Alloy = {
+  id: 'shopify',
+  name: 'Shopify',
+  blurb: 'Products, stock, customers, orders and gift cards from your Shopify shop.',
+  contract: 1,
+  settings: [
+    { key: 'domain', label: 'Shop address', placeholder: 'your-shop.myshopify.com' },
+    { key: 'clientId', label: 'Client ID' },
+    { key: 'clientSecret', label: 'Client secret', secret: true },
+    { key: 'locationId', label: 'Location', pickFrom: 'locationId', help: 'Stock and orders are counted at this Shopify location. All registers share it.' },
+  ],
+  async connect(): Promise<ConnectReport> {
+    if (!hasCreds()) return { ok: false, problem: 'Enter the shop address, client ID and client secret.' };
+    try {
+      const shop = await fetchShop();
+      const granted = tokenScopes(); const missing: Partial<Record<ElementId, string[]>> = {};
+      for (const [el, needs] of Object.entries(NEEDS) as [ElementId, string[]][]) { const m = needs.filter(n => !has(granted, n)); if (m.length) missing[el] = m; }
+      return { ok: true, missing, lists: { locationId: shop.locations } };
+    } catch (e) {
+      if (e instanceof ShopifyNetworkError) return { ok: false, problem: 'Could not reach Shopify. Check the internet connection and try again.' };
+      if (e instanceof ShopifyUserError) return { ok: false, problem: e.message };
+      throw e;
+    }
+  },
+  elements: {
+    catalogue: {
+      needs: NEEDS.catalogue,
+      api: {
+        // The import is one bulk job, so it comes back as a single page.
+        listItems: (ctx) => translate(async () => ({ rows: await fetchVariants(loc(ctx)), next: null })),
+        listCollections: () => translate(async () => ({ rows: await fetchCollections(), next: null })),
+        createItem: (ctx, input) => translate(() => createItem(input, loc(ctx))),
+        updateItem: (_ctx, item, patch) => translate(() => updateVariant(item.productId, item.variantId, patch)),
+      },
+    },
+    stock: {
+      needs: NEEDS.stock,
+      limits: ['One Shopify location is counted, shared by every register.'],
+      api: {
+        async changesSince(ctx, cursor) {
+          const since = new Date().toISOString(); // taken before the call, so nothing changed during it is missed next time
+          const delta = await translate(() => fetchStockDelta(cursor ?? '1970-01-01T00:00:00Z', loc(ctx)));
+          return { levels: Object.entries(delta).map(([itemId, quantity]) => ({ itemId, quantity })), cursor: since };
+        },
+        adjust: (ctx, a) => translate(() => adjustStock(a.itemId, loc(ctx), a.delta, a.reason, a.key)),
+        set: (ctx, a) => translate(() => setStock(a.itemId, loc(ctx), a.quantity, a.reason, a.key)),
+      },
+    },
+    discounts: { needs: NEEDS.discounts, api: { listAutomatic: () => translate(fetchAutoDiscounts), listPresets: () => translate(fetchManualPresets) } },
+    customers: {
+      needs: NEEDS.customers,
+      api: {
+        search: (_ctx, q) => translate(() => searchRemote(q)),
+        create: (_ctx, c) => translate(() => createCustomer({ ...splitName(c.name), email: c.email, phone: c.phone, note: c.note })),
+        update: (_ctx, id, c) => translate(() => updateCustomer(id, { ...splitName(c.name), email: c.email, phone: c.phone, note: c.note })),
+      },
+    },
+    orders: {
+      needs: NEEDS.orders,
+      api: {
+        // Looks the sale up by its tag first, so a retry after a lost reply never makes a second order.
+        record: (ctx, sale) => translate(async (): Promise<OrderRef> => { const o = await createOrderForSale(sale, { locationId: ctx.setting('locationId') || undefined, markFulfilled: true }); return { id: o.id, name: o.name }; }),
+        find: (_ctx, uuid) => translate(async () => { const o = await findOrderBySale(uuid); return o ? { id: o.id, name: o.name } : null; }),
+        list: (_ctx, p) => translate(async () => {
+          const r = await listOrders({ query: p.query, after: p.after, first: p.limit });
+          return { rows: r.orders.map(o => ({ ref: { id: o.id, name: o.name }, ts: o.createdAt, totalCents: o.totalCents, customerName: o.customer?.name, fulfilled: o.fulfillment === 'FULFILLED' })), next: r.next };
+        }),
+        fulfil: (_ctx, ref) => translate(() => fulfillOrder(ref.id)),
+        refund: (ctx, ref, items, o) => translate(async () => {
+          const order = await getOrder(ref.id);
+          const id = await refundOrderInShopify(order, items.map(i => ({ lineItemId: i.lineId, quantity: i.qty, restock: o.restock ?? true })), o.amounts, o.note, ctx.setting('locationId') || undefined, o.key);
+          return { id };
+        }),
+      },
+    },
+    giftCards: {
+      needs: NEEDS.giftCards,
+      api: {
+        lookup: (_ctx, code) => translate(async () => { const g = await lookupGiftCard(code); return g ? toCard(g) : null; }),
+        create: (_ctx, a) => translate(async () => toCard(await createGiftCard(a.valueCents, a.code, a.saleUuid, a.customerId, a.recipient))),
+        debit: (_ctx, id, cents, note) => translate(() => debitGiftCard(id, cents, note)),
+        credit: (_ctx, id, cents, note) => translate(() => creditGiftCard(id, cents, note)),
+        debitOnce: (_ctx, id, cents, note) => translate(() => debitGiftCardOnce(id, cents, note)),
+        creditOnce: (_ctx, id, cents, note) => translate(() => creditGiftCardOnce(id, cents, note)),
+        history: (_ctx, id) => translate(() => giftCardHistory(id)),
+      },
+    },
+    sharedState: { needs: NEEDS.sharedState, api: { backend: () => metaobjectBackend } },
+  },
+};
+export default alloy;
