+  await api.customers!.api.create!(ctx(), { name: 'Ann Lee Smith', email: 'a@x.com' });
+  assert.deepEqual(fake.lastCall().variables, { i: { firstName: 'Ann', lastName: 'Lee Smith', email: 'a@x.com' } });
+  fake.on('codeDiscountNodes', fake.data({ codeDiscountNodes: { pageInfo: { hasNextPage: false }, nodes: [] } }));
+  assert.deepEqual(await api.discounts!.api.listPresets(ctx()), []);
+});
+
+test('shopify: record uses the settings location and returns an OrderRef; find, list and refund map the order', async () => {
+  fake.install(); await fake.signIn();
+  fake.on('orders(first: 1', fake.data({ orders: { nodes: [] } }));
+  fake.on('orderCreate', ok('orderCreate', { order: { id: 'O1', name: '#1001' } }));
+  const sale: any = { uuid: 'aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee', type: 'sale', ts: '2026-11-01T00:00:00Z', lines: [], tenders: [], itemsCents: 0, discountCents: 0, netCents: 0, tipCents: 0, totalCents: 0, roundingCents: 0, cogsCents: 0, feesCents: 0, deals: [] };
+  assert.deepEqual(await api.orders!.api.record(ctx(), sale, { key: 'k' }), { id: 'O1', name: '#1001' });
+  assert.equal(fake.lastCall().variables.order.fulfillment.locationId, 'L1');
