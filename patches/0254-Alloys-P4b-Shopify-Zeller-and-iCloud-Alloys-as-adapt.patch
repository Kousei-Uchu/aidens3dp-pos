+// Location: src/alloys/zeller/alloy.ts
+// Alloys P4b: the Zeller Alloy. Card payments on a Zeller reader, through the terminal object the app already uses (`TerminalLike`).
+// The native reader code lives in src/zellerBridge.tsx, which pulls in the Zeller SDK, so it is loaded only when asked for (a node test or
+// a build without the SDK can still load this file). Nothing calls it before P5.
+import { AlloyUserError } from '../../alloykit/errors';
+import type { Alloy } from '../../alloykit/types';
+
+type Bridge = { getTerminal(): import('./terminal').TerminalLike | null; ZellerRoot: unknown; checkReader(): Promise<boolean> };
+const bridge = (): Bridge => require('../../zellerBridge') as Bridge;
+
+const alloy: Alloy = {
+  id: 'zeller',
+  name: 'Zeller',
+  blurb: 'Card payments and refunds on a Zeller reader.',
+  contract: 1,
+  settings: [],
+  async connect() {
+    try { return (await bridge().checkReader()) ? { ok: true } : { ok: false, problem: 'No Zeller reader is paired yet. Pair one in Settings.' }; }
+    catch { return { ok: false, problem: 'The Zeller reader could not be checked on this device.' }; }
+  },
+  host: () => bridge().ZellerRoot,
+  elements: {
+    cardTerminal: {
+      limits: ['Needs the Zeller SDK and a paired reader on this iPad.'],
+      api: {
+        // In practice mode the bridge hands back the pretend terminal, so the cashier can rehearse a card payment.
+        terminal: () => { const t = bridge().getTerminal(); if (!t) throw new AlloyUserError('The Zeller reader is not paired.'); return t; },
+      },
+    },
+  },
+};
+export default alloy;
