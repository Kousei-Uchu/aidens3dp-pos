+  await assert.rejects(() => api.stock!.api.adjust(ctx(), { itemId: 'I', delta: 1, reason: 'correction', key: 'k' }), (e: any) => isAlloyUserError(e) && e.message === 'Nope');
+  fake.on('inventoryAdjustQuantities', { status: 200 });
