+// Location: src/alloys/icloud.ts
+// Alloys P4b: the iCloud Alloy (Option A: one file). It holds the Shared state Element over CloudKit, the same backend the app already uses
+// when iCloud sync is on. The CloudKit module is native, so it is loaded only when the backend is asked for. A Customers Element for iCloud
+// is not built yet; the build policy that would gate it (`icloudCustomers`) is already in place. Nothing calls this before P5.
+import type { Alloy } from '../alloykit/types';
+import type { SharedBackend } from '../lib/syncBackend';
+
+const alloy: Alloy = {
+  id: 'icloud',
+  name: 'iCloud',
+  blurb: 'Share carts, layouts, sales and settings between your iPads through iCloud. No server needed.',
+  contract: 1,
+  settings: [],
+  async connect() { return { ok: true }; },
+  elements: {
+    sharedState: {
+      limits: ['Every register must be signed in to the same Apple account.'],
+      api: { backend: () => (require('../lib/cloudkit/cloudkitBackend') as { cloudkitBackend: SharedBackend }).cloudkitBackend },
+    },
+  },
+};
+export default alloy;
