+});
+
+test('shopify: gift card functions map to the same calls (create passes the recipient, debitOnce skips what is already done)', async () => {
+  fake.install(); await fake.signIn();
+  const card = { id: 'GC1', lastCharacters: 'ABCD', balance: { amount: '20.00' }, initialValue: { amount: '50.00' }, enabled: true, expiresOn: null, note: null, customer: null };
+  fake.on('customers(first: 20', fake.data({ customers: { nodes: [{ id: 'U9', email: 'f@x.com', displayName: 'F' }] } }));
+  fake.on('giftCardCreate', ok('giftCardCreate', { giftCard: card }));
+  const g = await api.giftCards!.api.create(ctx(), { valueCents: 5000, code: 'ABCD1234EFGH5678', saleUuid: 'S', recipient: { email: 'f@x.com', name: 'Fay' } });
+  assert.equal(g.id, 'GC1'); assert.equal(g.balanceCents, 2000); assert.equal(fake.lastCall().variables.i.recipientAttributes.id, 'U9');
