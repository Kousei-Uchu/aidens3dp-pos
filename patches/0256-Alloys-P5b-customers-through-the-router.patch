+// Location: src/alloyhost/need.ts
+// Alloys P5b: how a screen asks for an Element's function and gets a plain error when it is not there. When the app is still on the legacy
+// selection the words are exactly what the Shopify code said before the router existed (not set up, or the practice-mode message), so a
+// screen that shows `e.message` shows the same text. Once someone has chosen their own setup, the message names the Element instead.
+import { ElementOffError, type Bound, type Router } from './router';
+import { appRouter } from './appRouter';
+import { isTraining } from '../lib/trainingGuard';
+import type { ElementApi, ElementId } from '../alloykit/types';
+
+export const NOT_SET_UP = 'Shopify is not set up - open More ▸ Settings ▸ Shopify.';
+export class NoSuchFeatureError extends Error { constructor(readonly element: ElementId, readonly fn: string) { super(`The connection chosen for ${element} cannot do that (${fn}).`); this.name = 'NoSuchFeatureError'; } }
+
+/** `label` is the service named in the legacy messages ("Shopify"). */
+export function needFeature<E extends ElementId, K extends keyof Bound<ElementApi[E]>>(
+  element: E, fn: K, label = 'Shopify', router: Router = appRouter, training: () => boolean = isTraining,
+): NonNullable<Bound<ElementApi[E]>[K]> {
+  const api = router.api(element);
+  if (!api) {
+    if (router.current().source === 'legacy') throw new Error(training() ? `Training mode: ${label} is switched off.` : NOT_SET_UP);
+    throw new ElementOffError(element);
+  }
+  const f = api[fn];
+  if (typeof f !== 'function') throw new NoSuchFeatureError(element, String(fn));
+  return f as NonNullable<Bound<ElementApi[E]>[K]>;
+}
