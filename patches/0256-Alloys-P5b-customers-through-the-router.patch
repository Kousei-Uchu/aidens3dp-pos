+// Location: tests/alloyp5customers.test.ts
+// Alloys P5b: the customer screens reach Shopify through the router. Pins that the Shopify calls are the same as before, that the messages
+// a screen shows when Shopify is not there are the old words, and that no screen imports the Shopify customer file any more.
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import * as fake from './helpers/fakeShopify';
+import { setTrainingGuard } from '../src/lib/trainingGuard';
+import { OFF } from '../src/alloykit/types';
+
+const node = { id: 'U1', displayName: 'Ann Lee', email: 'a@x.com', phone: null, numberOfOrders: '2', amountSpent: { amount: '10.00' }, note: null };
+const ok = (field: string, extra: Record<string, unknown> = {}) => fake.data({ [field]: { ...extra, userErrors: [] } });
+
+test('search, create and update through the router make the same Shopify calls as the screens used to, and return the same customers', async () => {
+  fake.install(); await fake.signIn();
+  const { needFeature } = await import('../src/alloyhost/need'); const direct = await import('../src/lib/shopify/customers');
+  fake.on('customers(first: 20', fake.data({ customers: { nodes: [node] } }));
+  const viaRouter = await needFeature('customers', 'search')('ann');
