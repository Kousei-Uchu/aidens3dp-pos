 import type { Alloy, Ctx } from '../alloykit/types';
 import { appCtxFor } from './appRouter';
 import { readAllPages } from './catalogue';
@@ -38,3 +39,60 @@ export async function dryRun(fromId: string, toId: string, onProgress?: (s: stri
   const to = await readSide(toId, onProgress, alloys, ctxFor); if (!to.ok) return to;
   return { ok: true, plan: buildPlan(from.side, to.side) };
 }
+
+// ---- P8b: the run ----
+
+export type SmeltResult = {
+  ok: boolean;
+  created: { items: number; collections: number; customers: number };
+  failed: { what: string; why: string }[];
+  /** Set when the run stopped early, in plain words. Running it again carries on from where it got to. */
+  stopped?: string;
+};
+const MAX_IN_A_ROW = 5; const MAX_LISTED = 20;
+const splitName = (n: string) => { const t = n.trim(); const i = t.indexOf(' '); return i < 0 ? { firstName: t } : { firstName: t.slice(0, i), lastName: t.slice(i + 1).trim() || undefined }; };
+const why = (e: unknown) => typeof e === 'string' ? e : (e instanceof Error && e.message ? e.message : 'unknown problem');
+
+/**
+ * Does what the plan says, in the destination only. The source is never touched. Safe to run again after a stop: the plan is rebuilt from
+ * what the destination now holds, and anything already copied matches and is skipped. Refused in practice mode, because this writes to the
+ * destination directly rather than through the router's practice guard.
+ */
+export async function runPlan(plan: SmeltPlan, onProgress?: (s: string) => void, alloys: Alloy[] = ALLOYS, ctxFor: (id: string) => Ctx = appCtxFor, training: () => boolean = isTraining): Promise<SmeltResult> {
+  const res: SmeltResult = { ok: false, created: { items: 0, collections: 0, customers: 0 }, failed: [] };
+  const fail = (what: string, e: unknown) => { if (res.failed.length < MAX_LISTED) res.failed.push({ what, why: why(e) }); };
+  if (training()) { res.stopped = 'Practice mode is on, so nothing was copied. Turn it off first.'; return res; }
+  const a = alloys.find(x => x.id === plan.to.id);
+  if (!a) { res.stopped = `This version of the app has no connection called "${plan.to.id}".`; return res; }
+  if (a.ready && !a.ready()) { res.stopped = `${a.name} is not set up yet.`; return res; }
+  const ctx = ctxFor(a.id); const cat = a.elements.catalogue?.api; const cu = a.elements.customers?.api;
+
+  let row = 0; let streak = 0;
+  for (const it of plan.work.items) {
+    row++; onProgress?.(`Copying items to ${a.name}: ${row} of ${plan.work.items.length}`);
+    try { await cat!.createItem!(ctx, it.input); res.created.items++; streak = 0; }
+    catch (e) { fail(it.input.title, e); if (++streak >= MAX_IN_A_ROW) { res.stopped = `Stopped after ${MAX_IN_A_ROW} items in a row failed (${why(e)}). Run it again to carry on.`; return res; } }
+  }
+
+  if (plan.work.collections.length) {
+    let have: Variant[] | null = null;
+    try { have = await readAllPages(r => cat!.listItems(ctx, r)); } catch (e) { fail('Collections', `could not read ${a.name} to find the items: ${why(e)}`); }
+    if (have) {
+      const byKey = new Map<string, string>(); for (const v of have) for (const k of itemKeys(v)) byKey.set(k, v.productId);
+      let c = 0;
+      for (const col of plan.work.collections) {
+        c++; onProgress?.(`Copying collections: ${c} of ${plan.work.collections.length}`);
+        const ids = [...new Set(col.memberKeys.map(ks => ks.map(k => byKey.get(k)).find(Boolean)).filter((x): x is string => !!x))];
+        try { await cat!.createCollection!(ctx, { title: col.title, productIds: ids }); res.created.collections++; } catch (e) { fail(`Collection ${col.title}`, e); }
+      }
+    }
+  }
+
+  row = 0; streak = 0;
+  for (const c of plan.work.customers) {
+    row++; if (row % 10 === 1) onProgress?.(`Copying customers: ${row} of ${plan.work.customers.length}`);
+    try { await cu!.create!(ctx, { ...splitName(c.name), email: c.email, phone: c.phone, note: c.note }); res.created.customers++; streak = 0; }
+    catch (e) { fail(c.name || 'A customer', e); if (++streak >= MAX_IN_A_ROW) { res.stopped = `Stopped after ${MAX_IN_A_ROW} customers in a row failed (${why(e)}). Run it again to carry on.`; return res; } }
+  }
+  res.ok = res.failed.length === 0; return res;
+}
