+   "title": "The gift card claim page",
+   "parent": "gift",
+   "summary": "Configure the optional claim Worker so someone can add a name and email to a gift card sold without a recipient.",
+   "tags": [
+    "gift card",
+    "claim",
+    "qr",
+    "email",
