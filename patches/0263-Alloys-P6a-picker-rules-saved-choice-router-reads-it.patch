@@ -0,0 +1,76 @@
+// Location: tests/alloypicker.test.ts
+// Alloys P6a: the picker's rules (no screen), the saved choice, and the router reading it. Pins that an install that never chose behaves
+// exactly as before, that a saved choice takes over, and that the rules (required Elements cannot be Off, an Alloy must support the Element,
+// missing permissions are named) hold.
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { buildPicker, choose, pickerReady, pickerWarnings, alloysInUse } from '../src/alloykit/picker';
+import { OFF, type Alloy } from '../src/alloykit/types';
+import { useApp } from '../src/state/store';
+
+const alloys = async (): Promise<Alloy[]> => (await import('../src/alloys')).ALLOYS;
+
+test('with nothing chosen the three required Elements block, and optional ones read as off with what is lost', async () => {
+  const rows = buildPicker(await alloys(), {});
+  const by = Object.fromEntries(rows.map(r => [r.element, r]));
+  for (const e of ['catalogue', 'orders', 'sharedState']) { assert.equal(by[e].state, 'unchosen'); assert.match(by[e].warning!, /is needed/); }
+  assert.equal(by.stock.state, 'off'); assert.equal(by.stock.warning, 'Items are not tracked and stock screens are hidden.');
+  const r = pickerReady(rows); assert.equal(r.ok, false); assert.deepEqual(r.blocking.map(x => x.element).sort(), ['catalogue', 'orders', 'sharedState']);
+});
+
+test('each Element lists only the Alloys that can do it, with the features they really have', async () => {
+  const rows = buildPicker(await alloys(), {});
+  const by = Object.fromEntries(rows.map(r => [r.element, r]));
+  assert.deepEqual(by.sharedState.options.map(o => o.alloyId).sort(), ['icloud', 'shopify']);
+  assert.deepEqual(by.cardTerminal.options.map(o => o.alloyId), ['zeller']);
+  assert.deepEqual(by.catalogue.options.map(o => o.alloyId), ['shopify']);
+  assert.ok(by.orders.options[0].features.includes('refund') && by.orders.options[0].features.includes('fulfil'));
+  assert.ok(by.stock.options[0].limits[0].includes('One Shopify location'));
+});
+
+test('a full Shopify and Zeller choice is ready; missing permissions are named but do not block', async () => {
+  const sel = { catalogue: 'shopify', stock: 'shopify', discounts: 'shopify', customers: 'shopify', orders: 'shopify', giftCards: 'shopify', sharedState: 'shopify', cardTerminal: 'zeller' };
+  const ok = buildPicker(await alloys(), sel); assert.equal(pickerReady(ok).ok, true); assert.deepEqual(pickerWarnings(ok).map(w => w.element).sort(), ['tapToPay']);
+  const rows = buildPicker(await alloys(), sel, { shopify: { ok: true, missing: { giftCards: ['write_gift_cards'] } } });
