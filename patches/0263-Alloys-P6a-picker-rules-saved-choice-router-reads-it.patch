@@ -0,0 +1,13 @@
+// Location: src/alloyhost/savedSelection.ts
+// Alloys P6a: reads the saved choice of Alloy per Element from settings. Kept apart from choice.ts so the router can read it without a cycle.
+import type { Selection } from '../alloykit/types';
+import { useApp } from '../state/store';
+
+/** The saved choice, or undefined when this install has never chosen (an empty object counts as never chosen). */
+export function readSavedSelection(settings: { alloySelection?: Record<string, string> } = useApp.getState().settings): Selection | undefined {
+  const s = settings.alloySelection;
+  if (!s || typeof s !== 'object') return undefined;
+  const out: Selection = {};
+  for (const [k, v] of Object.entries(s)) if (typeof v === 'string' && v) (out as Record<string, string>)[k] = v;
+  return Object.keys(out).length ? out : undefined;
+}
diff --git a/src/alloykit/picker.ts b/src/alloykit/picker.ts
new file mode 100644
index 0000000..0b06ce2
--- /dev/null
+++ b/src/alloykit/picker.ts
@@ -0,0 +1,78 @@
+// Location: src/alloykit/picker.ts
+// Alloys P6a: the rules behind the setup picker and the Settings screen, with no screen in them. For each Element: which Alloys can do it,
+// what each offers and needs, what is chosen, and the plain-words warning when something is missing. `choose` is the only way a selection
+// changes, so the rules (required Elements cannot be Off, an Alloy must really support the Element) hold wherever the picker is shown.
+import { ELEMENTS, REQUIRED_ELEMENTS } from './elements';
+import { alloyFor, applyPolicy, featuresOf, supports } from './selection';
+import { ALLOY_POLICY, type AlloyPolicy } from './policy';
+import { OFF, type Alloy, type ConnectReport, type ElementId, type Selection } from './types';
+
+export type PickerOption = {
+  alloyId: string; name: string; blurb: string;
+  /** Optional functions this Alloy really has for the Element (an Alloy cannot claim more than it has). */
+  features: string[]; limits: string[];
+  /** Permissions the service says its login lacks for this Element, from the last connect. */
+  missing: string[];
+};
+export type PickerState = 'ok' | 'unchosen' | 'off' | 'unknown_alloy' | 'unsupported' | 'missing_permissions';
+export type PickerRow = {
+  element: ElementId; label: string; blurb: string; required: boolean; whenOff: string;
+  options: PickerOption[]; chosen: string | undefined; state: PickerState; warning?: string;
+};
+export type Reports = Record<string, ConnectReport | undefined>;
+
+const list = (xs: string[]) => xs.join(', ');
+
+export function buildPicker(allAlloys: Alloy[], sel: Selection, reports: Reports = {}, policy: AlloyPolicy = ALLOY_POLICY): PickerRow[] {
+  const alloys = applyPolicy(allAlloys, policy);
+  return ELEMENTS.map(info => {
+    const options: PickerOption[] = alloys.filter(a => supports(a, info.id)).map(a => ({
+      alloyId: a.id, name: a.name, blurb: a.blurb, features: featuresOf(a, info.id), limits: a.elements[info.id]?.limits ?? [],
+      missing: reports[a.id]?.missing?.[info.id] ?? [],
+    }));
+    const v = sel[info.id];
+    const row: PickerRow = { element: info.id, label: info.label, blurb: info.blurb, required: info.required, whenOff: info.whenOff, options, chosen: v === OFF ? undefined : v, state: 'ok' };
+    if (!v || v === OFF) {
+      if (info.required) { row.state = 'unchosen'; row.warning = `${info.label} is needed. Choose where it comes from before taking sales.`; }
+      else { row.state = 'off'; row.warning = info.whenOff || undefined; }
+      return row;
+    }
+    const a = alloyFor(alloys, v);
+    if (!a) { row.state = 'unknown_alloy'; row.warning = `${info.label} is set to "${v}", which this version of the app does not have. Choose another.`; return row; }
+    if (!supports(a, info.id)) { row.state = 'unsupported'; row.warning = `${a.name} cannot do ${info.label}. Choose another.`; return row; }
+    const missing = reports[a.id]?.missing?.[info.id];
+    if (missing?.length) { row.state = 'missing_permissions'; row.warning = `${a.name} has not given this app permission for ${info.label} (${list(missing)}). Add them in ${a.name}, then check again.`; }
+    return row;
+  });
+}
+
+export type ChooseResult = { ok: true; selection: Selection } | { ok: false; reason: string };
+
+/** Sets one Element's Alloy (or Off). The only way the picker changes a selection. */
+export function choose(sel: Selection, element: ElementId, alloyId: string, allAlloys: Alloy[], policy: AlloyPolicy = ALLOY_POLICY): ChooseResult {
+  const label = ELEMENTS.find(e => e.id === element)!.label;
+  if (alloyId === OFF) {
+    if (REQUIRED_ELEMENTS.includes(element)) return { ok: false, reason: `${label} cannot be switched off. The till needs it.` };
+    return { ok: true, selection: { ...sel, [element]: OFF } };
+  }
+  const a = alloyFor(applyPolicy(allAlloys, policy), alloyId);
+  if (!a) return { ok: false, reason: `This version of the app has no connection called "${alloyId}".` };
+  if (!supports(a, element)) return { ok: false, reason: `${a.name} cannot do ${label}.` };
+  return { ok: true, selection: { ...sel, [element]: alloyId } };
+}
+
+/** What setup needs before it lets the person carry on: nothing required left unchosen or broken. */
+export function pickerReady(rows: PickerRow[]): { ok: boolean; blocking: PickerRow[] } {
+  const blocking = rows.filter(r => r.required && r.state !== 'ok' && r.state !== 'missing_permissions');
+  return { ok: blocking.length === 0, blocking };
+}
+/** Warnings to show (not blocking): optional Elements that are off, and chosen Elements the login lacks permission for. */
+export const pickerWarnings = (rows: PickerRow[]): { element: ElementId; text: string; blocking: boolean }[] =>
+  rows.filter(r => r.warning).map(r => ({ element: r.element, text: r.warning!, blocking: r.required && r.state !== 'missing_permissions' }));
+
+/** The Alloys the selection uses, in the order they appear, so Settings can show each one's sign-in fields once. */
+export function alloysInUse(sel: Selection, alloys: Alloy[]): Alloy[] {
+  const ids: string[] = [];
+  for (const { id } of ELEMENTS) { const v = sel[id]; if (v && v !== OFF && !ids.includes(v)) ids.push(v); }
+  return ids.map(i => alloyFor(alloys, i)).filter((a): a is Alloy => !!a);
+}
