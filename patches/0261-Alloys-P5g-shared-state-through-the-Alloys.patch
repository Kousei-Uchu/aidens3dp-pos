+// Location: src/alloyhost/sharedState.ts
+// Alloys P5g: how the app reaches one Alloy's shared-state backend by name. The sync seam keeps its own "active backend", and the
+// migration reads one backend while writing the other, so neither can follow the router's single selection. They ask here instead, which
+// finds the Alloy that holds that kind of backend and asks it. The backends themselves are unchanged (the same objects as before).
+import { ALLOYS } from '../alloys';
+import type { SharedBackend } from '../lib/syncBackend';
+import { appCtxFor } from './appRouter';
+
+export type BackendKind = 'metaobject' | 'cloudkit';
+/** Which Alloy holds each kind of backend. */
+export const ALLOY_OF_KIND: Record<BackendKind, string> = { metaobject: 'shopify', cloudkit: 'icloud' };
+
+export function backendFor(kind: BackendKind): SharedBackend {
+  const id = ALLOY_OF_KIND[kind];
+  const impl = ALLOYS.find(a => a.id === id)?.elements.sharedState;
+  if (!impl) throw new Error(`No shared state is built for ${id}.`);
+  return impl.api.backend(appCtxFor(id));
+}
