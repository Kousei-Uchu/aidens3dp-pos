+++ b/tests/alloyp5shared.test.ts
@@ -0,0 +1,41 @@
+// Location: tests/alloyp5shared.test.ts
+// Alloys P5g: shared state. The migration, the order recovery job and the sync seam reach a backend by kind; that now goes through the
+// Alloy that holds it. Pins that each kind still gives the very same backend object, that the router's own answer agrees with it for the
+// backend in use, and that nothing outside the Alloys imports a backend file directly any more.
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import Module from 'node:module';
+
+test('the Shopify kind gives the same metaobject backend object the app always used', async () => {
+  const { loadBackend } = await import('../src/lib/cloudkit/lazyBackend'); const { metaobjectBackend } = await import('../src/lib/shopify/metaobjectBackend');
+  assert.equal(await loadBackend('metaobject'), metaobjectBackend);
+  const { backendFor, ALLOY_OF_KIND } = await import('../src/alloyhost/sharedState');
+  assert.equal(backendFor('metaobject'), metaobjectBackend); assert.deepEqual(ALLOY_OF_KIND, { metaobject: 'shopify', cloudkit: 'icloud' });
+});
+
+test('the iCloud kind gives the CloudKit backend, loaded only when asked for', async () => {
+  const sentinel = { kind: 'cloudkit', marker: 'x' }; const m: any = Module; const real = m._load; let loaded = 0;
+  m._load = function (req: string, ...rest: unknown[]) { if (/cloudkit\/cloudkitBackend$/.test(req)) { loaded++; return { cloudkitBackend: sentinel }; } return real.call(this, req, ...rest); };
+  try {
+    const { backendFor } = await import('../src/alloyhost/sharedState'); const { loadBackend } = await import('../src/lib/cloudkit/lazyBackend');
+    assert.equal(loaded, 0, 'importing the helpers does not load CloudKit');
+    assert.equal(backendFor('cloudkit') as any, sentinel); assert.equal(await loadBackend('cloudkit') as any, sentinel); assert.equal(loaded, 2);
+  } finally { m._load = real; }
+});
+
+test('the router answers with the same backend for the one in use (Shopify metaobjects when no CloudKit sync is on)', async () => {
+  const { appRouter } = await import('../src/alloyhost/appRouter'); const { metaobjectBackend } = await import('../src/lib/shopify/metaobjectBackend');
+  const { activeBackendKind } = await import('../src/lib/syncBackend');
+  assert.notEqual(activeBackendKind(), 'cloudkit');
+  assert.equal(appRouter.api('sharedState')!.backend(), metaobjectBackend);
+});
+
+test('lazyBackend and the seam no longer import a backend file directly; writes still stop on the guard', () => {
+  const lazy = readFileSync('src/lib/cloudkit/lazyBackend.ts', 'utf8');
+  assert.ok(!/import\('\.\/cloudkitBackend'\)|metaobjectBackend'\)/.test(lazy));
+  assert.ok(lazy.includes('if (!backendWritable()) throw new BackendBlockedError'));
+  const sync = readFileSync('src/lib/sync.ts', 'utf8');
+  assert.ok(!/shopify\/metaobjectBackend|cloudkit\/cloudkitBackend'\)\)\.cloudkitBackend/.test(sync));
+});
