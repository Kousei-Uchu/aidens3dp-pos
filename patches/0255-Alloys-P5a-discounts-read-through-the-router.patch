+// Location: src/alloyhost/appRouter.ts
+// Alloys P5: the one router the app uses. It is built once from the registry and reads the app's live state each time it is asked, so a
+// change of location or login is seen straight away. Until the picker (P6) saves a choice, the selection is always the legacy one:
+// exactly today's behaviour (Shopify for the shop Elements while a Shopify login exists, the shared backend in use, the Zeller reader).
+import { ALLOYS } from '../alloys';
+import { hasCreds } from '../lib/shopify/client';
+import { uid } from '../lib/ids';
+import { isTraining } from '../lib/trainingGuard';
+import { activeBackendKind } from '../lib/syncBackend';
+import { useApp } from '../state/store';
+import { makeCtx } from './ctx';
+import { createRouter } from './router';
+import { memoryStore } from './store';
+
+const store = memoryStore(); // Shopify keeps nothing here; Pure Tillium (P7) gets a persistent one
+
+export const appRouter = createRouter({
+  alloys: ALLOYS,
+  selection: () => undefined, // P6 reads the saved choice from settings here
+  legacyFacts: () => ({ shopifyConnected: hasCreds(), sharedBackend: activeBackendKind() === 'cloudkit' ? 'cloudkit' : 'metaobject', zellerPaired: true }),
+  ctxFor: id => makeCtx(id, { secrets: {}, settings: { shopify: { locationId: useApp.getState().settings.locationId ?? '' } }, store, uid }),
+  isTraining,
+});
