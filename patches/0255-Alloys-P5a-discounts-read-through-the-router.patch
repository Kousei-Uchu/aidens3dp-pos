+// Location: src/alloyhost/discounts.ts
+// Alloys P5a: the app's way to read discounts. It asks the router for the Discounts Element instead of calling Shopify, and an Element that
+// is Off or unset reads as "no discounts" (only discounts typed at the till are then available). The two reads run one after the other,
+// in the order the import has always made them.
+import type { AutoDiscount, ManualPreset } from '../lib/types';
+import type { Router } from './router';
+import { appRouter } from './appRouter';
+
+export async function loadDiscounts(router: Router = appRouter): Promise<{ autos: AutoDiscount[]; presets: ManualPreset[] }> {
+  const d = router.api('discounts');
+  if (!d) return { autos: [], presets: [] };
+  const autos = await d.listAutomatic();
+  const presets = await d.listPresets();
+  return { autos, presets };
+}
