+// Location: tests/alloyp5discounts.test.ts
+// Alloys P5a: discounts are read through the router. Pins that the result is the same as calling Shopify directly (today's behaviour),
+// that an Element that is off reads as "no discounts", and that sync.ts no longer reaches Shopify for them itself.
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import * as fake from './helpers/fakeShopify';
+import { setTrainingGuard } from '../src/lib/trainingGuard';
+import { OFF } from '../src/alloykit/types';
+
+const autoNode = { id: 'D1', automaticDiscount: { __typename: 'DiscountAutomaticBasic', title: '10% off', status: 'ACTIVE', startsAt: 's', endsAt: null, minimumRequirement: null,
+  customerGets: { value: { __typename: 'DiscountPercentage', percentage: 0.1 }, items: { __typename: 'AllDiscountItems', allItems: true } } } };
+const presetNode = { id: 'M1', codeDiscount: { __typename: 'DiscountCodeBasic', title: 'Mates', status: 'ACTIVE', customerGets: { value: { __typename: 'DiscountPercentage', percentage: 0.15 } } } };
+const queue = () => {
+  fake.on('automaticDiscountNodes', fake.data({ automaticDiscountNodes: { pageInfo: { hasNextPage: false }, nodes: [autoNode] } }));
+  fake.on('codeDiscountNodes', fake.data({ codeDiscountNodes: { pageInfo: { hasNextPage: false }, nodes: [presetNode] } }));
+};
+
+test('through the router (legacy default, Shopify connected) the result equals calling Shopify directly, automatic first, then presets', async () => {
+  fake.install(); await fake.signIn(); queue();
+  const { loadDiscounts } = await import('../src/alloyhost/discounts');
+  const viaRouter = await loadDiscounts();
+  const order = fake.gqlCalls().map(c => c.query.includes('automaticDiscountNodes') ? 'auto' : 'presets');
+  fake.install(); await fake.signIn(); queue();
+  const shop = await import('../src/lib/shopify/catalogue');
+  const direct = { autos: await shop.fetchAutoDiscounts(), presets: await shop.fetchManualPresets() };
+  assert.deepEqual(viaRouter, direct); assert.equal(direct.autos.length, 1); assert.equal(direct.presets.length, 1);
+  assert.deepEqual(order, ['auto', 'presets']);
+});
+
+test('no Shopify login: discounts read as empty and nothing is sent', async () => {
+  fake.install();
+  const client = await import('../src/lib/shopify/client'); await client.clearCreds();
+  const { loadDiscounts } = await import('../src/alloyhost/discounts');
+  assert.deepEqual(await loadDiscounts(), { autos: [], presets: [] }); assert.equal(fake.calls.length, 0);
+});
+
+test('practice mode reads as no login, so discounts are empty and nothing is sent', async () => {
+  fake.install(); await fake.signIn();
+  const { loadDiscounts } = await import('../src/alloyhost/discounts');
+  setTrainingGuard(true);
+  try { assert.deepEqual(await loadDiscounts(), { autos: [], presets: [] }); } finally { setTrainingGuard(false); }
+  assert.equal(fake.calls.length, 0);
+});
+
+test('a router with the Discounts Element off reads as no discounts, even with Shopify connected', async () => {
+  fake.install(); await fake.signIn();
+  const { createRouter } = await import('../src/alloyhost/router'); const { ALLOYS } = await import('../src/alloys');
+  const { makeCtx } = await import('../src/alloyhost/ctx'); const { memoryStore } = await import('../src/alloyhost/store'); const { loadDiscounts } = await import('../src/alloyhost/discounts');
+  const r = createRouter({ alloys: ALLOYS, selection: () => ({ catalogue: 'shopify', orders: 'shopify', sharedState: 'shopify', discounts: OFF }), legacyFacts: () => ({ shopifyConnected: true, sharedBackend: 'metaobject', zellerPaired: true }),
+    ctxFor: id => makeCtx(id, { secrets: {}, settings: {}, store: memoryStore(), uid: () => 'k' }), isTraining: () => false });
+  assert.deepEqual(await loadDiscounts(r), { autos: [], presets: [] }); assert.equal(fake.calls.length, 0);
+});
+
+test('sync.ts reads discounts only through loadDiscounts (twice: the import and the half-hourly refresh)', () => {
+  const src = readFileSync('src/lib/sync.ts', 'utf8');
+  assert.equal((src.match(/loadDiscounts\(\)/g) ?? []).length, 2);
+  assert.equal(/fetchAutoDiscounts|fetchManualPresets/.test(src), false);
+});
