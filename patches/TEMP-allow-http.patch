 app.json | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/app.json b/app.json
index c922a41..690aeeb 100644
--- a/app.json
+++ b/app.json
@@ -18,7 +18,7 @@
         "UIRequiresFullScreen": false,
         "UIStatusBarHidden": true,
         "UIViewControllerBasedStatusBarAppearance": false,
-        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true },
+        "NSAppTransportSecurity": { "NSAllowsLocalNetworking": true, "NSAllowsArbitraryLoads": true },
         "NSLocalNetworkUsageDescription": "Used to copy your old Square sales history from your PC or from another register, and to reach the AI assistant's model if you run it on a computer on the same Wi-Fi."
       },
       "appleTeamId": "HD264P8365"
