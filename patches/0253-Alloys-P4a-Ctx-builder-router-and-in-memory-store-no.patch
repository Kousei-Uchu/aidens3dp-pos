index 0000000..272b086
--- /dev/null
+++ b/src/alloyhost/ctx.ts
@@ -0,0 +1,58 @@
+// Location: src/alloyhost/ctx.ts
+// Alloys P4a: builds the `Ctx` the app hands to an Alloy. The Alloy never sees fetch, the Keychain or settings directly, only this.
+// Secrets are read ahead of time into a plain object (the Keychain is async, `ctx.secret` is not), and each Alloy sees only its own.
+import { AlloyNetworkError, AlloyUserError } from '../alloykit/errors';
+import type { Ctx, Http, LocalStore } from '../alloykit/types';
+
+export type CtxDeps = {
+  /** Secrets and settings by Alloy id, then key. Missing means empty text, never undefined. */
+  secrets: Record<string, Record<string, string>>;
+  settings: Record<string, Record<string, string>>;
+  store: LocalStore;
+  uid: () => string;
+  log?: (alloyId: string, message: string) => void;
+  fetchImpl?: typeof fetch;
+};
+
+/**
+ * One HTTP helper. A network failure, a timeout-style error or a 5xx is an AlloyNetworkError (retryable, the sale stays queued);
+ * a 4xx is an AlloyUserError (the service refused, retrying will not help). The body is sent as JSON when it is an object.
+ */
+export function makeHttp(fetchImpl: typeof fetch = fetch): Http {
+  return {
+    async json<T>(url: string, init: { method?: string; headers?: Record<string, string>; body?: unknown; query?: Record<string, string | undefined> } = {}): Promise<T> {
+      let full = url;
+      if (init.query) {
+        const q = Object.entries(init.query).filter(([, v]) => v !== undefined).map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v as string)}`).join('&');
+        if (q) full += (url.includes('?') ? '&' : '?') + q;
+      }
+      const headers: Record<string, string> = { ...(init.headers ?? {}) };
+      let body: string | undefined;
+      if (init.body !== undefined) {
+        if (typeof init.body === 'string') body = init.body;
+        else { body = JSON.stringify(init.body); if (!Object.keys(headers).some(h => h.toLowerCase() === 'content-type')) headers['Content-Type'] = 'application/json'; }
+      }
+      let res: Response;
+      try { res = await fetchImpl(full, { method: init.method ?? (body === undefined ? 'GET' : 'POST'), headers, body }); }
+      catch (e) { throw new AlloyNetworkError(`Could not reach ${new URL(full).host}`, e); }
+      if (res.status >= 500) throw new AlloyNetworkError(`${new URL(full).host} answered ${res.status}`);
+      let text = ''; try { text = await res.text(); } catch { /* an empty body is fine */ }
+      if (!res.ok) throw new AlloyUserError(`${new URL(full).host} refused the request (${res.status})${text ? `: ${text.slice(0, 200)}` : ''}`);
+      if (!text) return undefined as T;
+      try { return JSON.parse(text) as T; } catch (e) { throw new AlloyNetworkError(`${new URL(full).host} sent a reply that was not JSON`, e); }
+    },
+  };
+}
+
+/** The Ctx for one Alloy. Each call to `idempotencyKey` is new; the app passes its own stable keys where a retry must repeat one. */
+export function makeCtx(alloyId: string, d: CtxDeps): Ctx {
+  const http = makeHttp(d.fetchImpl);
+  return {
+    http,
+    secret: key => d.secrets[alloyId]?.[key] ?? '',
+    setting: key => d.settings[alloyId]?.[key] ?? '',
+    store: d.store,
+    idempotencyKey: d.uid,
+    log: m => d.log?.(alloyId, m),
+  };
+}
diff --git a/src/alloyhost/router.ts b/src/alloyhost/router.ts
new file mode 100644
index 0000000..6f9f37e
--- /dev/null
+++ b/src/alloyhost/router.ts
@@ -0,0 +1,88 @@
+// Location: src/alloyhost/router.ts
+// Alloys P4a: how the app reaches an Element. The app asks the router for "the catalogue", the router looks up which Alloy is selected,
+// gives it that Alloy's Ctx and returns the Element's functions with the Ctx already applied. Nothing in the app calls this yet (P5 moves
+// the callers over one Element per patch), so adding it changes nothing at runtime.
+import { ELEMENTS, REQUIRED_ELEMENTS } from '../alloykit/elements';
+import type { AlloyPolicy } from '../alloykit/policy';
+import { applyPolicy, alloyFor, legacySelection, type LegacyFacts } from '../alloykit/selection';
+import { OFF, type Alloy, type Ctx, type ElementApi, type ElementId, type Selection } from '../alloykit/types';
+
+/** An Element's functions with the leading Ctx argument already supplied. */
+export type Bound<A> = { [K in keyof A]: NonNullable<A[K]> extends (ctx: Ctx, ...a: infer P) => infer R ? (...a: P) => R : A[K] };
+
+/** The functions that change something outside the till, per Element. In practice mode these refuse instead of running. Reads are not listed. */
+export const WRITES: { [E in ElementId]: string[] } = {
+  catalogue: ['createItem', 'updateItem'],
+  stock: ['adjust', 'set'],
+  discounts: [],
+  customers: ['create', 'update'],
+  orders: ['record', 'fulfil', 'refund'],
+  giftCards: ['create', 'debit', 'credit'],
+  sharedState: [],   // the shared backend has its own guard (BackendBlockedError); the router does not wrap it
+  cardTerminal: [],  // practice mode swaps the terminal itself (trainingTerminal), also outside the router
+  tapToPay: [],
+};
+
+export class ElementOffError extends Error {
+  constructor(readonly element: ElementId) { super(`${element} is switched off or has no Alloy selected.`); this.name = 'ElementOffError'; }
+}
+export class PracticeBlockedError extends Error {
+  constructor(readonly element: ElementId, readonly fn: string) { super(`Practice mode: ${element}.${fn} would change something outside the till, so it was not sent.`); this.name = 'PracticeBlockedError'; }
+}
+
+export type RouterDeps = {
+  alloys: Alloy[];
+  /** The saved selection, or undefined for an install that has never chosen (it then reads as today's behaviour). */
+  selection: () => Selection | undefined;
+  legacyFacts: () => LegacyFacts;
+  ctxFor: (alloyId: string) => Ctx;
+  isTraining: () => boolean;
+  /** The build's policy; defaults to ALLOY_POLICY. Tests pass their own. */
+  policy?: AlloyPolicy;
+};
+
+export type Router = {
+  /** The selection in force and where it came from. */
+  current(): { selection: Selection; source: 'saved' | 'legacy' };
+  /** The Alloy id that handles an Element, or null when Off or unset. */
+  alloyId(element: ElementId): string | null;
+  /** Whether an Element is on, and (with `fn`) whether the selected Alloy implements an optional function of it. */
+  has(element: ElementId, fn?: string): boolean;
+  /** The Element's bound functions, or null when it is Off, unset, or the selected Alloy cannot do it. */
+  api<E extends ElementId>(element: E): Bound<ElementApi[E]> | null;
+  /** As `api`, but throws ElementOffError instead of returning null. */
+  need<E extends ElementId>(element: E): Bound<ElementApi[E]>;
+  /** Required Elements with no working choice (the app must not run sales until this is empty). */
+  missingRequired(): ElementId[];
+};
+
+export function createRouter(d: RouterDeps): Router {
+  const alloys = () => applyPolicy(d.alloys, d.policy);
+  const current = () => { const saved = d.selection(); return saved ? { selection: saved, source: 'saved' as const } : { selection: legacySelection(d.legacyFacts()), source: 'legacy' as const }; };
+  const impl = (element: ElementId) => {
+    const v = current().selection[element]; if (!v || v === OFF) return null;
+    const a = alloyFor(alloys(), v); const e = a?.elements[element];
+    return a && e ? { alloy: a, api: e.api as unknown as Record<string, unknown> } : null;
+  };
+  const router: Router = {
+    current,
+    alloyId: element => impl(element)?.alloy.id ?? null,
+    has: (element, fn) => { const i = impl(element); return !!i && (!fn || typeof i.api[fn] === 'function'); },
+    api<E extends ElementId>(element: E) {
+      const i = impl(element); if (!i) return null;
+      const ctx = d.ctxFor(i.alloy.id); const bound: Record<string, unknown> = {};
+      for (const k of Object.keys(i.api)) {
+        const f = i.api[k]; if (typeof f !== 'function') { bound[k] = f; continue; }
+        if (WRITES[element].includes(k)) bound[k] = (...a: unknown[]) => { if (d.isTraining()) return Promise.reject(new PracticeBlockedError(element, k)); return (f as (...x: unknown[]) => unknown)(ctx, ...a); };
+        else bound[k] = (...a: unknown[]) => (f as (...x: unknown[]) => unknown)(ctx, ...a);
+      }
+      return bound as Bound<ElementApi[E]>;
+    },
+    need<E extends ElementId>(element: E) { const a = router.api(element); if (!a) throw new ElementOffError(element); return a; },
+    missingRequired: () => REQUIRED_ELEMENTS.filter(e => !impl(e)),
+  };
+  return router;
+}
+
+/** Every Element id, for screens that list them. Re-exported so the app side needs only this file. */
+export const ALL_ELEMENTS = ELEMENTS;
