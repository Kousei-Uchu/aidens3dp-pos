+test('router, policy: with iCloud customers disabled the router treats a saved icloud customers choice as off', () => {
+  const icloud = alloy('icloud', { customers: { api: { search: async () => [] } } });
+  const base = { sel: { catalogue: 'shopify', orders: 'shopify', sharedState: 'shopify', customers: 'icloud' } as Selection, alloys: [alloy('shopify'), icloud] };
