+// Location: tests/alloyrouter.test.ts
+// Alloys P4a: the Ctx builder and the router, with made-up Alloys. Nothing in the app calls them yet.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { makeCtx, makeHttp } from '../src/alloyhost/ctx';
+import { memoryStore } from '../src/alloyhost/store';
+import { createRouter, ElementOffError, PracticeBlockedError, WRITES } from '../src/alloyhost/router';
+import { ALLOY_CONTRACT, OFF, type Alloy, type Ctx, type Selection } from '../src/alloykit/types';
+import { isAlloyNetworkError, isAlloyUserError } from '../src/alloykit/errors';
+import { ELEMENTS } from '../src/alloykit/elements';
+
+const res = (status: number, body: string) => ({ ok: status < 400, status, text: async () => body }) as unknown as Response;
+const FACTS = { shopifyConnected: true, sharedBackend: 'metaobject' as const, zellerPaired: true };
+
+test('http: query is appended and encoded, undefined values dropped, object bodies sent as JSON with a content type', async () => {
+  const seen: any[] = [];
+  const http = makeHttp((async (url: any, init: any) => { seen.push([String(url), init]); return res(200, '{"a":1}'); }) as any);
+  assert.deepEqual(await http.json('https://x.test/p?z=1', { query: { q: 'a b', skip: undefined, n: '2' } }), { a: 1 });
+  assert.equal(seen[0][0], 'https://x.test/p?z=1&q=a%20b&n=2'); assert.equal(seen[0][1].method, 'GET');
+  await http.json('https://x.test/p', { body: { k: 1 } });
+  assert.equal(seen[1][1].method, 'POST'); assert.equal(seen[1][1].body, '{"k":1}'); assert.equal(seen[1][1].headers['Content-Type'], 'application/json');
+  await http.json('https://x.test/p', { method: 'PUT', body: 'raw', headers: { 'content-type': 'text/plain' } });
+  assert.equal(seen[2][1].body, 'raw'); assert.equal(seen[2][1].headers['Content-Type'], undefined);
+});
+
+test('http: network failure and 5xx are retryable network errors; 4xx is a user error carrying the reply; empty body is undefined; non-JSON is a network error', async () => {
+  const mk = (f: () => Promise<Response>) => makeHttp((async () => f()) as any);
+  await assert.rejects(() => mk(async () => { throw new Error('offline'); }).json('https://x.test/'), (e: any) => isAlloyNetworkError(e) && /Could not reach x\.test/.test(e.message));
+  await assert.rejects(() => mk(async () => res(503, '')).json('https://x.test/'), (e: any) => isAlloyNetworkError(e) && /503/.test(e.message));
+  await assert.rejects(() => mk(async () => res(401, 'bad key')).json('https://x.test/'), (e: any) => isAlloyUserError(e) && /\(401\): bad key/.test(e.message));
+  assert.equal(await mk(async () => res(204, '')).json('https://x.test/'), undefined);
+  await assert.rejects(() => mk(async () => res(200, '<html>')).json('https://x.test/'), isAlloyNetworkError);
+});
+
+test('ctx: each Alloy sees only its own secrets and settings; missing is empty text; keys come from the app; log is tagged', () => {
+  const logs: string[] = []; let n = 0;
+  const deps = { secrets: { a: { token: 'T' }, b: { token: 'OTHER' } }, settings: { a: { loc: 'L1' } }, store: memoryStore(), uid: () => `k${++n}`, log: (id: string, m: string) => logs.push(`${id}:${m}`) };
+  const a = makeCtx('a', deps), b = makeCtx('b', deps);
+  assert.equal(a.secret('token'), 'T'); assert.equal(b.secret('token'), 'OTHER'); assert.equal(a.secret('nope'), ''); assert.equal(b.setting('loc'), '');
+  assert.equal(a.setting('loc'), 'L1'); assert.equal(a.idempotencyKey(), 'k1'); assert.equal(b.idempotencyKey(), 'k2');
+  a.log('hi'); assert.deepEqual(logs, ['a:hi']);
+});
+
+test('memoryStore: typed collections that copy what they hold', async () => {
+  const s = memoryStore(); const v = { n: 1 };
+  await s.put('c', 'x', v); v.n = 2;
+  assert.deepEqual(await s.get('c', 'x'), { n: 1 }); assert.equal(await s.get('c', 'nope'), null); assert.equal(await s.get('other', 'x'), null);
+  await s.put('c', 'y', { n: 3 }); assert.deepEqual(await s.list('c'), [{ n: 1 }, { n: 3 }]);
+  await s.remove('c', 'x'); assert.deepEqual(await s.list('c'), [{ n: 3 }]);
+});
+
+// ── router ──
+const calls: any[] = [];
+const alloy = (id: string, extra: Partial<Alloy['elements']> = {}): Alloy => ({
+  id, name: id, blurb: '', contract: ALLOY_CONTRACT, settings: [], connect: async () => ({ ok: true }),
+  elements: {
+    catalogue: { api: { listItems: async (c: Ctx, p: any) => { calls.push([id, 'listItems', c.setting('who'), p]); return { rows: [], next: null }; }, listCollections: async () => ({ rows: [], next: null }), createItem: async (c: Ctx, i: any) => { calls.push([id, 'createItem', i]); return {} as any; } } },
+    orders: { api: { record: async (c: Ctx, s: any, o: any) => { calls.push([id, 'record', o.key]); return { id: 'O' }; } } },
+    sharedState: { api: { backend: () => ({ kind: 'metaobject' }) as any } },
+    ...extra,
+  },
+});
+const mkRouter = (over: { sel?: Selection | undefined; training?: boolean; alloys?: Alloy[]; policy?: { icloudCustomers: 'allowed' | 'disabled' } } = {}) => createRouter({
+  alloys: over.alloys ?? [alloy('shopify'), alloy('tillium')],
+  selection: () => ('sel' in over ? over.sel : undefined), legacyFacts: () => FACTS,
+  ctxFor: id => makeCtx(id, { secrets: {}, settings: { shopify: { who: 'S' }, tillium: { who: 'T' } }, store: memoryStore(), uid: () => 'key' }),
+  isTraining: () => !!over.training, policy: over.policy,
+});
+
+test('router: an install that never chose reads as today (Shopify for shop Elements, Shopify shared state, Zeller terminal) and says so', () => {
+  const r = mkRouter();
+  assert.equal(r.current().source, 'legacy'); assert.equal(r.alloyId('catalogue'), 'shopify'); assert.equal(r.alloyId('sharedState'), 'shopify');
+  assert.equal(r.alloyId('cardTerminal'), null, 'zeller is not in this test registry, so the choice is unsupported and reads as off');
+});
+
+test('router: a saved selection wins; Off and unset are both "no Element"; api() is null for them and need() throws', () => {
+  const r = mkRouter({ sel: { catalogue: 'tillium', orders: OFF, sharedState: 'shopify' } });
+  assert.equal(r.current().source, 'saved'); assert.equal(r.alloyId('catalogue'), 'tillium');
+  assert.equal(r.api('orders'), null); assert.equal(r.api('stock'), null); assert.equal(r.has('orders'), false);
+  assert.throws(() => r.need('orders'), (e: any) => e instanceof ElementOffError && e.element === 'orders');
+  assert.deepEqual(r.missingRequired(), ['orders']);
+  assert.deepEqual(mkRouter({ sel: { catalogue: 'tillium', orders: 'tillium', sharedState: 'shopify' } }).missingRequired(), []);
+});
+
+test('router: a saved choice of an unknown Alloy, or one that cannot do the Element, is off (never a crash)', () => {
+  const r = mkRouter({ sel: { catalogue: 'ghost', stock: 'tillium', orders: 'shopify', sharedState: 'shopify' } });
+  assert.equal(r.api('catalogue'), null); assert.equal(r.api('stock'), null); assert.deepEqual(r.missingRequired(), ['catalogue']);
+});
+
+test('router: functions come back with the selected Alloy\'s Ctx already applied, and arguments pass through', async () => {
+  calls.length = 0;
+  const r = mkRouter({ sel: { catalogue: 'tillium', orders: 'shopify', sharedState: 'shopify' } });
