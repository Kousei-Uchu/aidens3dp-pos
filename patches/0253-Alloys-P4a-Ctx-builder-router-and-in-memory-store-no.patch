+++ b/src/alloyhost/store.ts
@@ -0,0 +1,16 @@
+// Location: src/alloyhost/store.ts
+// Alloys P4a: a LocalStore (typed collections) held in memory. Tests use it, and so does anything that must not persist (practice mode).
+// The persistent one for Pure Tillium (AsyncStorage) arrives with P7 behind the same type.
+import type { LocalStore } from '../alloykit/types';
+
+export function memoryStore(): LocalStore {
+  const data = new Map<string, Map<string, string>>();
+  const coll = (c: string) => { let m = data.get(c); if (!m) { m = new Map(); data.set(c, m); } return m; };
+  // Values are stored as JSON so a caller can never mutate what is "saved" by keeping a reference, the same as a real store.
+  return {
+    async get<T>(c: string, id: string) { const v = coll(c).get(id); return v === undefined ? null : JSON.parse(v) as T; },
+    async put<T>(c: string, id: string, value: T) { coll(c).set(id, JSON.stringify(value)); },
+    async remove(c: string, id: string) { coll(c).delete(id); },
+    async list<T>(c: string) { return [...coll(c).values()].map(v => JSON.parse(v) as T); },
+  };
+}
