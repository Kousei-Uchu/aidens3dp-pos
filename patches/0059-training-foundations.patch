+  assert.equal(sb.settings.receipt.serverUrl, ''); assert.equal(sb.settings.passServerUrl, ''); assert.equal(sb.settings.giftClaimUrl, ''); assert.equal(sb.settings.bundlesJson, ''); assert.deepEqual(sb.settings.adjustPerms, {});
