diff --git a/src/ui/ChatMarkdown.tsx b/src/ui/ChatMarkdown.tsx
new file mode 100644
index 0000000..de07112
--- /dev/null
+++ b/src/ui/ChatMarkdown.tsx
@@ -0,0 +1,72 @@
+// Location: src/ui/ChatMarkdown.tsx
+// Draws an assistant reply (patch 0165): the same blocks as the Help screen, but smaller and tighter to sit in a chat bubble.
+// Text can be selected and copied. Links are never tappable here (see lib/chatMarkdown.ts). Text follows the display mode's size.
+import React from 'react';
+import { Platform, ScrollView, Text, View } from 'react-native';
+import type { Align, Block, Inline, ListItem } from '../lib/mdBlocks';
+import { chatBlocks } from '../lib/chatMarkdown';
+import { useTheme } from './theme';
+import { useUi } from './uiProfile';
+
+const MONO = Platform.select({ ios: 'Menlo', default: 'monospace' });
+const half = (n: number) => Math.round(n * 2) / 2;
+const alignOf = (a: Align) => (a === 'center' ? 'center' : a === 'right' ? 'right' : 'left');
+
+export default function ChatMarkdown({ text, color }: { text: string; color?: string }) {
+  const { c } = useTheme(); const k = useUi().textScale;
+  const blocks = React.useMemo<Block[]>(() => chatBlocks(text), [text]);
+  const ink = color ?? c.text; const size = half(15 * k); const line = half(size * 1.42);
+  const spans = (xs: Inline[], base: { size?: number; weight?: '400' | '700' } = {}) => xs.map((x, i) => {
+    const fs = base.size ?? size;
+    switch (x.t) {
+      case 'bold': return <Text key={i} style={{ fontSize: fs, fontWeight: '700', color: ink }}>{x.s}</Text>;
+      case 'italic': return <Text key={i} style={{ fontSize: fs, fontStyle: 'italic', color: ink }}>{x.s}</Text>;
+      case 'code': return <Text key={i} style={{ fontFamily: MONO, fontSize: half(fs * 0.9), color: ink, backgroundColor: c.fill }}>{` ${x.s} `}</Text>;
+      default: return <Text key={i} style={{ fontSize: fs, color: ink, fontWeight: base.weight }}>{x.s}</Text>;
+    }
+  });
+  const list = (items: ListItem[], ordered: boolean, depth: number): React.ReactNode => (
+    <View style={{ gap: 4, paddingLeft: depth ? 14 : 0 }}>
+      {items.map((it, i) => (
+        <View key={i} style={{ flexDirection: 'row', gap: 8, alignItems: 'flex-start' }}>
+          <Text style={{ fontSize: size, lineHeight: line, minWidth: ordered ? 20 : 10, color: ordered ? c.accent : c.sub, fontWeight: ordered ? '700' : '400' }}>{ordered ? `${i + 1}.` : depth ? '◦' : '•'}</Text>
+          <View style={{ flex: 1, gap: 4 }}>
+            <Text selectable style={{ fontSize: size, lineHeight: line, color: ink }}>{spans(it.inline)}</Text>
+            {it.children.length ? list(it.children, false, depth + 1) : null}
+          </View>
+        </View>
+      ))}
+    </View>
+  );
+  return (
+    <View style={{ gap: 8 }}>
+      {blocks.map((b, bi) => {
+        switch (b.k) {
+          case 'heading': { const hs = half((b.level === 2 ? 18 : b.level === 3 ? 16.5 : 15.5) * k); return <Text key={bi} selectable accessibilityRole="header" style={{ marginTop: bi ? 4 : 0, fontSize: hs, lineHeight: half(hs * 1.3), fontWeight: '700', color: ink }}>{spans(b.inline, { size: hs, weight: '700' })}</Text>; }
+          case 'para': return <Text key={bi} selectable style={{ fontSize: size, lineHeight: line, color: ink }}>{spans(b.inline)}</Text>;
+          case 'list': return <View key={bi}>{list(b.items, b.ordered, 0)}</View>;
+          case 'table': {
+            const fs = half(13.5 * k); const cols = b.head.length;
+            return (
+              <ScrollView key={bi} horizontal showsHorizontalScrollIndicator={false} style={{ borderWidth: 1, borderColor: c.line, borderRadius: 10 }}>
+                <View style={{ minWidth: cols * 96 }}>
+                  {[b.head, ...b.rows].map((row, ri) => (
+                    <View key={ri} style={{ flexDirection: 'row', backgroundColor: ri === 0 ? c.fill : 'transparent', borderTopWidth: ri === 0 ? 0 : 1, borderTopColor: c.line }}>
+                      {row.map((cell, ci) => (
+                        <View key={ci} style={{ flex: 1, minWidth: 96, padding: 8, borderLeftWidth: ci === 0 ? 0 : 1, borderLeftColor: c.line }}>
+                          <Text selectable style={{ fontSize: fs, lineHeight: half(fs * 1.35), color: ink, textAlign: alignOf(b.align[ci] ?? 'left') }}>{spans(cell, { size: fs, weight: ri === 0 ? '700' : undefined })}</Text>
+                        </View>
+                      ))}
+                    </View>
+                  ))}
+                </View>
+              </ScrollView>
+            );
+          }
+          case 'code': return <ScrollView key={bi} horizontal style={{ backgroundColor: c.fill, borderRadius: 10 }} contentContainerStyle={{ padding: 10 }}><Text selectable style={{ fontFamily: MONO, fontSize: half(12.5 * Math.min(k, 1.25)), color: ink }}>{b.text}</Text></ScrollView>;
+          default: return null;
+        }
+      })}
+    </View>
+  );
+}
diff --git a/tests/chatmarkdown.test.ts b/tests/chatmarkdown.test.ts
new file mode 100644
index 0000000..8a44a11
--- /dev/null
+++ b/tests/chatmarkdown.test.ts
@@ -0,0 +1,48 @@
+// Location: tests/chatmarkdown.test.ts
+// How the assistant's replies are read as Markdown for the chat (patch 0165): the tidying, the blocks, and that no link is ever tappable.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { chatBlocks, tidyMarkdown, unlink } from '../src/lib/chatMarkdown';
+import { inlineText, parseInline, type Block } from '../src/lib/mdBlocks';
+
+const kinds = (bs: Block[]) => bs.map(b => b.k);
+const allInline = (bs: Block[]) => bs.flatMap(b => (b.k === 'heading' || b.k === 'para' ? b.inline : b.k === 'list' ? b.items.flatMap(function f(i: any): any[] { return [...i.inline, ...i.children.flatMap(f)]; }) : b.k === 'table' ? [...b.head.flat(), ...b.rows.flat(2)] : []));
+
+test('a single # heading and the deeper ones are read as headings', () => {
+  const b = chatBlocks('# Refunds\n\n##### Small print\n\nText.');
+  assert.deepEqual(kinds(b), ['heading', 'heading', 'para']);
+  assert.equal((b[0] as any).level, 2); assert.equal((b[1] as any).level, 4);
+});
+test('__bold__, _italic_ and ~~strike~~ are tidied, and snake_case words and sums are left alone', () => {
+  const t = tidyMarkdown('This is __bold__ and _slanted_ and ~~gone~~. Use sales_report for 2 * 3 * 4 and my_var_name.');
+  assert.equal(t, 'This is **bold** and *slanted* and gone. Use sales_report for 2 * 3 * 4 and my_var_name.');
+  const xs = parseInline(t); assert.ok(xs.some(x => x.t === 'bold' && x.s === 'bold')); assert.ok(xs.some(x => x.t === 'italic' && x.s === 'slanted'));
+});
+test('quotes show as text, and rules are dropped', () => {
+  const b = chatBlocks('> Take the card first.\n\n---\n\nThen the cash.');
+  assert.deepEqual(kinds(b), ['para', 'para']); assert.equal(inlineText((b[0] as any).inline), 'Take the card first.');
+});
+test('lists, numbered lists and tables come through', () => {
+  const b = chatBlocks('Steps:\n\n1. Tap **Cart**\n2. Tap Charge\n\n* one\n  * nested\n\n| Item | Stock |\n|---|---:|\n| Cow | 5 |');
+  assert.deepEqual(kinds(b), ['para', 'list', 'list', 'table']);
+  assert.equal((b[1] as any).ordered, true); assert.equal((b[2] as any).items[0].children.length, 1); assert.equal((b[3] as any).rows[0].length, 2);
+});
+test('nothing inside a code fence is tidied, and an unclosed fence still ends', () => {
+  const t = tidyMarkdown('```\n# not a heading\n__x__\n---\n```\n\n# Real');
+  assert.equal(t, '```\n# not a heading\n__x__\n---\n```\n\n## Real');
+  assert.deepEqual(kinds(chatBlocks('```\nopen ended\n# x')), ['code']);
+});
+test('a diagram is shown as code, never drawn', () => {
+  const b = chatBlocks('```mermaid\nflowchart TD\n A-->B\n```'); assert.deepEqual(kinds(b), ['code']); assert.equal((b[0] as any).lang, 'mermaid');
+});
+test('no link is ever tappable: the words stay and the address goes, in every kind of block', () => {
+  const b = chatBlocks('See [Reports](#/sales/reports) or [here](https://evil.example/pay).\n\n- [Item](#/stock)\n\n## [Head](https://x.example)\n\n| a |\n|---|\n| [cell](#/p) |');
+  const xs = allInline(b); assert.ok(xs.length > 4);
+  assert.ok(xs.every((x: any) => x.t !== 'page' && x.t !== 'url'));
+  assert.match(xs.map((x: any) => x.s).join(' '), /Reports/); assert.doesNotMatch(JSON.stringify(b), /evil\.example|#\/|https/);
+  assert.deepEqual(unlink(parseInline('[a](#/b)')), [{ t: 'text', s: 'a' }]);
+});
+test('plain text, empty text and odd input never throw', () => {
+  assert.deepEqual(kinds(chatBlocks('Just words.')), ['para']); assert.deepEqual(chatBlocks(''), []); assert.deepEqual(chatBlocks(undefined as any), []);
+  assert.doesNotThrow(() => chatBlocks('**unclosed *and ` weird | pipes\n|\n#\n- \n> '));
+});
