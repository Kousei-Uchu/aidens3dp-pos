+    "kind": {
+      "type": "string",
+      "enum": ["app", "tab", "page", "sheet", "overlay", "view", "list", "action"],
+      "description": "What sort of place this node is. Used to word guidance and to reason about layers."
+    },
+    "label": {
+      "type": "string",
+      "description": "What a person calls this place. Falls back to the screen name."
+    },
+    "tab": {
+      "type": "string",
+      "description": "The bottom-bar tab this place belongs to, when it belongs to one."
+    },
+    "route": {
+      "type": "string",
+      "description": "The pushed page this place is, when it is a page."
+    },
+    "roles": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "Which staff roles may reach this place (cashier, manager, owner). Empty or missing means anyone."
+    },
+    "summary": {
+      "type": "string",
+      "description": "One plain line about what this place is for."
+    }
+  },
+  "edgeMetadata": {
+    "say": {
+      "type": "string",
+      "description": "The words said while pointing at the control on this transition. Guidance prefixes the fix wording with this."
+    },
+    "gesture": {
+      "type": "string",
+      "description": "tap, double, triple, hold, swipe-left, swipe-right, swipe-up, swipe-down, scroll-up, scroll-down. Left out is a tap."
+    },
+    "spot": {
+      "type": "string",
+      "description": "The UI spot id this transition taps, when it has one. The runtime also learns this from the action payload."
+    },
+    "roles": {
+      "type": "array",
+      "items": { "type": "string" },
+      "description": "Which roles may take this transition. Empty or missing means anyone."
+    }
+  }
+}
