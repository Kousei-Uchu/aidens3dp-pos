+/** Where each dynamic (per record) spot lives, by its id prefix. */
+export const PREFIX_SCREEN: { prefix: string; screen: string }[] = [
+  { prefix: 'grid.item:', screen: 'tab_checkout' },
+  { prefix: 'grid.cat:', screen: 'tab_checkout' },
