+    legacyFacts: () => ({ shopifyConnected: false, sharedBackend: 'metaobject', zellerPaired: false }), ctxFor: id => makeCtx(id, { secrets: {}, settings: {}, store, uid: () => `u${++n}`.padStart(8, '0') }), isTraining: () => training });
+  assert.equal(router.current().source, 'saved'); assert.deepEqual(router.missingRequired(), ['sharedState']);
+  const ref = await router.api('catalogue')!.createItem!({ title: 'Dino', priceCents: 1000, stock: 4 });
+  const rec = await router.api('orders')!.record(sale({ lines: [{ ...sale().lines[0], variantId: ref.variantId }] }), { key: 'k' });
+  assert.equal((await router.api('orders')!.list!({ query: 'tag:pos', limit: 5 })).rows[0].id, rec.id);
+  training = true;
+  await assert.rejects(router.api('orders')!.record(sale({ uuid: 'p' }), { key: 'p' }), (e: any) => e instanceof PracticeBlockedError);
+  await assert.rejects(router.api('stock')!.adjust({ itemId: ref.inventoryItemId, delta: 1, reason: 'other', key: 'z' }), (e: any) => e instanceof PracticeBlockedError);
+  assert.equal((await router.api('catalogue')!.listItems({})).rows[0].stock, 4, 'reads still work and nothing changed');
+});
