diff --git a/src/alloys/tillium/alloy.ts b/src/alloys/tillium/alloy.ts
new file mode 100644
index 0000000..d102414
--- /dev/null
+++ b/src/alloys/tillium/alloy.ts
@@ -0,0 +1,208 @@
+// Location: src/alloys/tillium/alloy.ts
+// Alloys P7a: Pure Tillium. A built-in Alloy that keeps the shop's catalogue, stock, customers, orders, gift cards and discounts in the
+// device's own store (`ctx.store`), with no outside service. It follows the same contract as Shopify, so the till cannot tell which one it
+// is talking to. It imports nothing from the app but types and money; ids come from `ctx.idempotencyKey()`.
+// It is not offered in the picker until its store is persistent (P7b); until then `PURE_TILLIUM_READY` in the registry stays false.
+import { AlloyUserError } from '../../alloykit/errors';
+import type {
+  Alloy, Ctx, CustomerInput, GiftCard, GiftCardTxn, ItemInput, ItemPatch, ItemRef, OrderDetail, OrderRef, StockLevel,
+} from '../../alloykit/types';
+import type { AutoDiscount, Collection, Customer, ManualPreset, SaleRecord, Tender, Variant } from '../../lib/types';
+
+const C = { items: 'items', collections: 'collections', stock: 'stock', ops: 'ops', customers: 'customers', orders: 'orders', bySale: 'orderBySale', meta: 'meta', cards: 'giftCards', cardByCode: 'giftCardByCode', txns: 'giftTxns', auto: 'discountsAuto', presets: 'discountPresets' } as const;
+const GATEWAY: Record<Tender['kind'], string> = { card: 'Zeller', cash: 'Cash', gift_card: 'Gift card', exchange_credit: 'Exchange credit' };
+const now = () => new Date().toISOString();
+const newId = (ctx: Ctx, kind: string) => `tl_${kind}_${ctx.idempotencyKey().replace(/-/g, '')}`;
+const normCode = (raw: string) => raw.trim().replace(/^shopify-giftcard-v\d+-/i, '').replace(/[^a-zA-Z0-9]/g, '').toUpperCase();
+const digits = (s: string) => s.replace(/\D/g, '');
+
+type StockRow = { itemId: string; quantity: number; at: string };
+type Op = { key: string; result?: unknown };
+type CardRow = GiftCard & { code: string; saleUuid?: string };
+type TxnRow = GiftCardTxn & { cardId: string };
+
+async function once<T>(ctx: Ctx, key: string, run: () => Promise<T>): Promise<T> {
+  const seen = await ctx.store.get<Op>(C.ops, key);
+  if (seen) return seen.result as T;
+  const result = await run(); await ctx.store.put<Op>(C.ops, key, { key, result }); return result;
+}
+const itemByInventoryId = async (ctx: Ctx, inventoryItemId: string) => (await ctx.store.list<Variant>(C.items)).find(v => v.inventoryItemId === inventoryItemId) ?? null;
+
+async function writeStock(ctx: Ctx, itemId: string, f: (current: number) => number, reason: string, key: string, delta?: number) {
+  const item = await itemByInventoryId(ctx, itemId);
+  if (!item) throw new AlloyUserError('That item is not in the catalogue.', 'itemId');
+  const row = await ctx.store.get<StockRow>(C.stock, itemId);
+  const quantity = f(row?.quantity ?? 0);
+  await ctx.store.put<StockRow>(C.stock, itemId, { itemId, quantity, at: now() });
+  await ctx.store.put(C.ops, `log:${key}`, { key: `log:${key}`, result: { itemId, delta, quantity, reason } });
+}
+
+// ── Catalogue ─────────────────────────────────────────────────────────────────────────────
+const catalogue = {
+  async listItems(ctx: Ctx) {
+    const stock = new Map((await ctx.store.list<StockRow>(C.stock)).map(s => [s.itemId, s.quantity]));
+    const rows = (await ctx.store.list<Variant>(C.items)).map(v => { const q = v.inventoryItemId ? stock.get(v.inventoryItemId) : undefined; return q === undefined ? { ...v, tracked: false, stock: null } : { ...v, tracked: true, stock: q }; });
+    return { rows, next: null };
+  },
+  async listCollections(ctx: Ctx) { return { rows: await ctx.store.list<Collection>(C.collections), next: null }; },
+  async createItem(ctx: Ctx, input: ItemInput): Promise<ItemRef> {
+    if (!input.title.trim()) throw new AlloyUserError('Give the item a name.', 'title');
+    if (!Number.isInteger(input.priceCents) || input.priceCents < 0) throw new AlloyUserError('The price must be zero or more.', 'priceCents');
+    const ref: ItemRef = { productId: newId(ctx, 'p'), variantId: newId(ctx, 'v'), inventoryItemId: newId(ctx, 'i') };
+    const v: Variant = { id: ref.variantId, productId: ref.productId, productTitle: input.title.trim(), variantTitle: '', sku: input.sku || undefined, barcode: input.barcode || undefined, priceCents: input.priceCents, costCents: input.costCents,
+      inventoryItemId: ref.inventoryItemId, tracked: input.stock !== undefined, stock: input.stock ?? null, tags: [], active: true, status: 'ACTIVE', updatedAt: now() };
+    await ctx.store.put(C.items, v.id, v);
+    if (input.stock !== undefined) await ctx.store.put<StockRow>(C.stock, ref.inventoryItemId, { itemId: ref.inventoryItemId, quantity: input.stock, at: now() });
+    if (input.collectionId) { const col = await ctx.store.get<Collection>(C.collections, input.collectionId); if (col) await ctx.store.put(C.collections, col.id, { ...col, productIds: [...col.productIds, ref.productId] }); }
+    return ref;
+  },
+  async updateItem(ctx: Ctx, item: { productId: string; variantId: string }, patch: ItemPatch) {
+    const v = await ctx.store.get<Variant>(C.items, item.variantId);
+    if (!v || v.productId !== item.productId) throw new AlloyUserError('That item is not in the catalogue.', 'variantId');
+    await ctx.store.put(C.items, v.id, { ...v, ...Object.fromEntries(Object.entries(patch).filter(([, x]) => x !== undefined)), updatedAt: now() });
+  },
+};
+
+// ── Stock ─────────────────────────────────────────────────────────────────────────────────
+const stock = {
+  async changesSince(ctx: Ctx, cursor: string | null) {
+    const taken = now(); // before the read, so nothing changed during it is missed next time
+    const levels: StockLevel[] = (await ctx.store.list<StockRow>(C.stock)).filter(s => !cursor || s.at >= cursor).map(s => ({ itemId: s.itemId, quantity: s.quantity }));
+    return { levels, cursor: taken };
+  },
+  adjust: (ctx: Ctx, a: { itemId: string; delta: number; reason: string; key: string }) => once(ctx, `adj:${a.key}`, () => writeStock(ctx, a.itemId, c => c + a.delta, a.reason, a.key, a.delta)),
+  set: (ctx: Ctx, a: { itemId: string; quantity: number; reason: string; key: string }) => once(ctx, `set:${a.key}`, () => writeStock(ctx, a.itemId, () => a.quantity, a.reason, a.key)),
+};
+
+// ── Discounts ─────────────────────────────────────────────────────────────────────────────
+const discounts = {
+  async listAutomatic(ctx: Ctx): Promise<AutoDiscount[]> { const t = now(); return (await ctx.store.list<AutoDiscount>(C.auto)).filter(d => !d.endsAt || d.endsAt > t); },
+  listPresets: (ctx: Ctx): Promise<ManualPreset[]> => ctx.store.list<ManualPreset>(C.presets),
+};
+
+// ── Customers ─────────────────────────────────────────────────────────────────────────────
+const nameOf = (c: CustomerInput) => [c.firstName, c.lastName].map(s => s?.trim()).filter(Boolean).join(' ');
+const customers = {
+  async search(ctx: Ctx, q: string): Promise<Customer[]> {
+    const t = q.trim().toLowerCase(); if (!t) return [];
+    const d = digits(t);
+    return (await ctx.store.list<Customer>(C.customers)).filter(c => c.name.toLowerCase().includes(t) || (c.email ?? '').toLowerCase().includes(t) || (d.length >= 3 && digits(c.phone ?? '').includes(d))).slice(0, 25);
+  },
+  listAll: (ctx: Ctx) => ctx.store.list<Customer>(C.customers),
+  async create(ctx: Ctx, c: CustomerInput): Promise<Customer> {
+    const name = nameOf(c) || c.email?.trim() || c.phone?.trim();
+    if (!name) throw new AlloyUserError('Enter a name, email or phone.');
+    const row: Customer = { id: newId(ctx, 'c'), name: nameOf(c) || name, email: c.email?.trim() || undefined, phone: c.phone?.trim() || undefined, note: c.note || undefined, orders: 0, spentCents: 0 };
+    await ctx.store.put(C.customers, row.id, row); return row;
+  },
+  async update(ctx: Ctx, id: string, c: CustomerInput): Promise<Customer> {
+    const cur = await ctx.store.get<Customer>(C.customers, id); if (!cur) throw new AlloyUserError('That customer was not found.');
+    const name = nameOf(c);
+    const row: Customer = { ...cur, ...(name ? { name } : {}), ...(c.email !== undefined ? { email: c.email.trim() || undefined } : {}), ...(c.phone !== undefined ? { phone: c.phone.trim() || undefined } : {}), ...(c.note !== undefined ? { note: c.note || undefined } : {}) };
+    await ctx.store.put(C.customers, id, row); return row;
+  },
+};
+
+// ── Orders ────────────────────────────────────────────────────────────────────────────────
+const money = (n: number) => Math.round(n);
+async function nextNumber(ctx: Ctx): Promise<number> { const m = await ctx.store.get<{ n: number }>(C.meta, 'orderCounter'); const n = (m?.n ?? 1000) + 1; await ctx.store.put(C.meta, 'orderCounter', { n }); return n; }
+const refOf = (o: OrderDetail): OrderRef => ({ id: o.id, name: o.name });
+
+function toOrder(sale: SaleRecord, id: string, name: string): OrderDetail {
+  return {
+    id, name, createdAt: sale.ts, financial: 'PAID', fulfillment: 'FULFILLED', totalCents: sale.totalCents, refundedCents: 0, note: sale.note, tags: ['pos'],
+    customer: sale.customer ? { id: sale.customer.id, name: sale.customer.name, email: sale.customer.email, phone: sale.customer.phone } : undefined,
+    attrs: { pos_sale_uuid: sale.uuid, ...(sale.receiptLink ? { pos_receipt_link: sale.receiptLink } : {}) },
+    lines: sale.lines.map((l, i) => ({ id: `${id}:${i + 1}`, title: l.title, variantTitle: l.variantTitle || undefined, qty: l.qty, refundableQty: l.qty, unitCents: money(l.netCents / Math.max(1, l.qty)), originalUnitCents: l.baseUnitCents, variantId: l.variantId, costCents: l.costCents, discount: l.discountLabels.length ? l.discountLabels.join(', ') : undefined })),
+    tenders: sale.tenders, saleUuid: sale.uuid, receiptLink: sale.receiptLink ?? sale.tenders.find(t => t.card?.receiptLink)?.card?.receiptLink,
+    transactions: sale.tenders.map((t, i) => ({ id: `${id}:t${i + 1}`, kind: 'SALE', status: 'SUCCESS', gateway: GATEWAY[t.kind], amountCents: t.amountCents })),
+    registerName: sale.registerName, staff: sale.staff, roundingCents: sale.roundingCents, adjustments: sale.adjustments,
+  };
+}
+const orders = {
+  async record(ctx: Ctx, sale: SaleRecord): Promise<OrderRef> {
+    const seen = await ctx.store.get<{ id: string }>(C.bySale, sale.uuid);
+    if (seen) { const o = await ctx.store.get<OrderDetail>(C.orders, seen.id); if (o) return refOf(o); }
+    const n = await nextNumber(ctx); const o = toOrder(sale, newId(ctx, 'o'), `#T${n}`);
+    await ctx.store.put(C.orders, o.id, o); await ctx.store.put(C.bySale, sale.uuid, { id: o.id });
+    if (sale.customer) { const c = await ctx.store.get<Customer>(C.customers, sale.customer.id); if (c) await ctx.store.put(C.customers, c.id, { ...c, orders: (c.orders ?? 0) + 1, spentCents: (c.spentCents ?? 0) + sale.netCents }); }
+    return refOf(o);
+  },
+  async find(ctx: Ctx, saleUuid: string): Promise<OrderRef | null> { const s = await ctx.store.get<{ id: string }>(C.bySale, saleUuid); const o = s ? await ctx.store.get<OrderDetail>(C.orders, s.id) : null; return o ? refOf(o) : null; },
+  async list(ctx: Ctx, p: { after?: string | null; limit?: number; query?: string }) {
+    const q = p.query ?? ''; const limit = p.limit ?? 10; const from = p.after ? parseInt(p.after, 10) || 0 : 0;
+    let all = (await ctx.store.list<OrderDetail>(C.orders)).sort((a, b) => (a.createdAt < b.createdAt ? 1 : a.createdAt > b.createdAt ? -1 : b.name.localeCompare(a.name)));
+    if (/fulfillment_status:unfulfilled/.test(q)) all = all.filter(o => o.fulfillment === 'UNFULFILLED');
+    else if (/fulfillment_status:fulfilled/.test(q)) all = all.filter(o => o.fulfillment === 'FULFILLED');
+    const rows = all.slice(from, from + limit);
+    return { rows, next: from + limit < all.length ? String(from + limit) : null };
+  },
+  async fulfil(ctx: Ctx, ref: OrderRef) {
+    const o = await ctx.store.get<OrderDetail>(C.orders, ref.id); if (!o) throw new AlloyUserError('That order was not found.');
+    await ctx.store.put(C.orders, o.id, { ...o, fulfillment: 'FULFILLED' });
+  },
+  refund: (ctx: Ctx, order: OrderDetail, items: { lineId: string; qty: number }[], o: { amounts: Partial<Record<Tender['kind'], number>>; note: string; key: string; restock?: boolean }) => once(ctx, `refund:${o.key}`, async () => {
+    const cur = await ctx.store.get<OrderDetail>(C.orders, order.id); if (!cur) throw new AlloyUserError('That order was not found.');
+    const lines = cur.lines.map(l => { const r = items.find(i => i.lineId === l.id); if (!r) return l; if (r.qty > l.refundableQty) throw new AlloyUserError(`Only ${l.refundableQty} of ${l.title} can still be returned.`); return { ...l, refundableQty: l.refundableQty - r.qty }; });
+    const id = newId(ctx, 'r'); const txs = [...cur.transactions];
+    for (const [kind, cents] of Object.entries(o.amounts) as [Tender['kind'], number][]) if (cents > 0) txs.push({ id: `${id}:${kind}`, kind: 'REFUND', status: 'SUCCESS', gateway: GATEWAY[kind], amountCents: cents });
+    const refundedCents = cur.refundedCents + Object.values(o.amounts).reduce<number>((a, b) => a + (b ?? 0), 0);
+    const all = lines.every(l => l.refundableQty === 0) || refundedCents >= cur.totalCents;
+    await ctx.store.put(C.orders, cur.id, { ...cur, lines, transactions: txs, refundedCents, financial: all ? 'REFUNDED' : 'PARTIALLY_REFUNDED' });
+    if (o.restock ?? true) for (const r of items) { const l = cur.lines.find(x => x.id === r.lineId); const v = l?.variantId ? await ctx.store.get<Variant>(C.items, l.variantId) : null; if (v?.inventoryItemId && (await ctx.store.get<StockRow>(C.stock, v.inventoryItemId))) await writeStock(ctx, v.inventoryItemId, c => c + r.qty, 'restock', `${o.key}:${r.lineId}`, r.qty); }
+    return { id };
+  }),
+};
+
+// ── Gift cards ────────────────────────────────────────────────────────────────────────────
+const publicCard = ({ code: _c, saleUuid: _s, ...card }: CardRow): GiftCard => card;
+const cardOf = async (ctx: Ctx, id: string) => { const c = await ctx.store.get<CardRow>(C.cards, id); if (!c) throw new AlloyUserError('That gift card was not found.'); return c; };
+async function move(ctx: Ctx, id: string, cents: number, note: string, kind: 'credit' | 'debit') {
+  if (!Number.isInteger(cents) || cents <= 0) throw new AlloyUserError('The amount must be more than zero.');
+  const card = await cardOf(ctx, id);
+  if (kind === 'debit' && cents > card.balanceCents) throw new AlloyUserError('The gift card balance is too low.');
+  await ctx.store.put(C.cards, id, { ...card, balanceCents: card.balanceCents + (kind === 'credit' ? cents : -cents) });
+  const tid = newId(ctx, 'gt'); await ctx.store.put<TxnRow>(C.txns, tid, { id: tid, cardId: id, at: now(), cents, kind, note });
+}
+const history = async (ctx: Ctx, id: string): Promise<GiftCardTxn[]> => (await ctx.store.list<TxnRow>(C.txns)).filter(t => t.cardId === id).sort((a, b) => (a.at < b.at ? 1 : -1)).map(({ cardId: _c, ...t }) => t);
+async function moveOnce(ctx: Ctx, id: string, cents: number, note: string, kind: 'credit' | 'debit') {
+  const same = (await history(ctx, id)).filter(t => t.kind === kind && t.note === note);
+  if (same.length) { if (same.some(t => t.cents === cents)) return; throw new AlloyUserError('That gift card change was already made for a different amount.'); }
+  await move(ctx, id, cents, note, kind);
+}
+const giftCards = {
+  async lookup(ctx: Ctx, raw: string): Promise<GiftCard | null> { const code = normCode(raw); if (code.length < 4) return null; const link = await ctx.store.get<{ id: string }>(C.cardByCode, code); const c = link ? await ctx.store.get<CardRow>(C.cards, link.id) : null; return c ? publicCard(c) : null; },
+  async create(ctx: Ctx, a: { valueCents: number; code: string; saleUuid: string }): Promise<GiftCard> {
+    const code = normCode(a.code); if (code.length < 4) throw new AlloyUserError('The gift card code is too short.');
+    const existing = await ctx.store.get<{ id: string }>(C.cardByCode, code);
+    if (existing) { const c = await cardOf(ctx, existing.id); if (c.saleUuid === a.saleUuid) return publicCard(c); throw new AlloyUserError('That gift card code is already in use.'); }
+    if (!Number.isInteger(a.valueCents) || a.valueCents <= 0) throw new AlloyUserError('The gift card value must be more than zero.');
+    const card: CardRow = { id: newId(ctx, 'g'), last4: code.slice(-4), balanceCents: a.valueCents, initialCents: a.valueCents, enabled: true, verified: true, code, saleUuid: a.saleUuid };
+    await ctx.store.put(C.cards, card.id, card); await ctx.store.put(C.cardByCode, code, { id: card.id }); return publicCard(card);
+  },
+  debit: (ctx: Ctx, id: string, cents: number, note: string) => move(ctx, id, cents, note, 'debit'),
+  credit: (ctx: Ctx, id: string, cents: number, note: string) => move(ctx, id, cents, note, 'credit'),
+  debitOnce: (ctx: Ctx, id: string, cents: number, note: string) => moveOnce(ctx, id, cents, note, 'debit'),
+  creditOnce: (ctx: Ctx, id: string, cents: number, note: string) => moveOnce(ctx, id, cents, note, 'credit'),
+  history: async (ctx: Ctx, id: string) => (await history(ctx, id)).slice(0, 30),
+  allHistory: (ctx: Ctx, id: string) => history(ctx, id),
+  async outstanding(ctx: Ctx) { const live = (await ctx.store.list<CardRow>(C.cards)).filter(c => c.enabled && c.balanceCents > 0); return { cards: live.length, cents: live.reduce((a, c) => a + c.balanceCents, 0) }; },
+};
+
+const alloy: Alloy = {
+  id: 'tillium',
+  name: 'Pure Tillium',
+  blurb: 'Keeps your catalogue, stock, customers, orders and gift cards on your own devices, with no outside service.',
+  contract: 1,
+  settings: [],
+  async connect() { return { ok: true, name: 'Pure Tillium' }; },
+  elements: {
+    catalogue: { limits: ['Held on this device. Without a second register or iCloud, the data lives only here: back it up.'], api: catalogue },
+    stock: { api: stock },
+    discounts: { api: discounts },
+    customers: { api: customers },
+    orders: { limits: ['Orders are kept on this device. There is no online order page.'], api: orders },
+    giftCards: { api: giftCards },
+  },
+};
+export default alloy;
