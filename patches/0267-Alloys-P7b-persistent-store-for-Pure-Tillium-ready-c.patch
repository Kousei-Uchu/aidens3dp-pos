+import shopify from '../src/alloys/shopify/alloy';
+import icloud from '../src/alloys/icloud';
+
+const fakeKV = (): KV & { data: Map<string, string>; failNext: boolean } => {
+  const data = new Map<string, string>(); const kv: any = { data, failNext: false,
+    async getItem(k: string) { return data.get(k) ?? null; },
+    async setItem(k: string, v: string) { if (kv.failNext) { kv.failNext = false; throw new Error('Storage is full'); } data.set(k, v); },
+    async removeItem(k: string) { data.delete(k); }, async getAllKeys() { return [...data.keys()]; },
+    async multiGet(keys: string[]) { return keys.map(k => [k, data.get(k) ?? null] as const); } };
+  return kv;
+};
+let n = 0; const uid = () => `u${++n}`.padStart(8, '0');
+const ctxOn = (kv: KV) => makeCtx('tillium', { secrets: {}, settings: {}, store: asyncStorageStore(kv), uid });
+const api = (k: string) => (tillium.elements as any)[k].api;
+const sale = (uuid: string, o: any = {}): any => ({ uuid, type: 'sale', ts: '2026-11-21T01:00:00Z', registerId: 'r', registerName: 'F', lines: [{ variantId: 'V', title: 'D', qty: 1, baseUnitCents: 500, grossCents: 500, discountCents: 0, netCents: 500, costCents: 0, discountLabels: [], kind: 'item' }], itemsCents: 500, discountCents: 0, netCents: 500, tipCents: 0, totalCents: 500, cogsCents: 0, feesCents: 0, roundingCents: 0, tenders: [{ id: 't', kind: 'cash', amountCents: 500 }], deals: [], ...o });
+
+test('the store keeps one record per key, lists a collection, copies values and keeps collections apart', async () => {
+  const kv = fakeKV(); const s = asyncStorageStore(kv);
+  const v = { a: 1 }; await s.put('items', 'x', v); v.a = 2; assert.deepEqual(await s.get('items', 'x'), { a: 1 });
+  await s.put('items', 'y', { a: 3 }); await s.put('items2', 'z', { a: 9 }); await s.put('other', 'x:with:colons', { a: 4 });
+  assert.deepEqual((await s.list<any>('items')).map(r => r.a), [1, 3]); assert.deepEqual((await s.list<any>('items2')).map(r => r.a), [9]);
+  assert.deepEqual((await s.list<any>('other')).map(r => r.a), [4]); assert.deepEqual([...kv.data.keys()].sort(), ['tl1:items2:z', 'tl1:items:x', 'tl1:items:y', 'tl1:other:x:with:colons']);
+  await s.remove('items', 'x'); assert.equal(await s.get('items', 'x'), null); assert.deepEqual(await s.list('nothing'), []);
+});
+
+test('a failed write is an error the Alloy sees, never a silent loss', async () => {
+  const kv = fakeKV(); const ctx = ctxOn(kv); kv.failNext = true;
+  await assert.rejects(api('catalogue').createItem(ctx, { title: 'A', priceCents: 1 }), /Storage is full/);
+  assert.equal((await api('catalogue').listItems(ctx, {})).rows.length, 0);
+  await api('catalogue').createItem(ctx, { title: 'A', priceCents: 1 }); assert.equal((await api('catalogue').listItems(ctx, {})).rows.length, 1, 'the next write works');
+});
+
+test('Alloys keep to their own corner of the store', async () => {
+  const base = memoryStore(); const a = scopedStore(base, 'one'); const b = scopedStore(base, 'two');
+  await a.put('items', 'x', { who: 'one' }); await b.put('items', 'x', { who: 'two' });
+  assert.deepEqual(await a.get('items', 'x'), { who: 'one' }); assert.deepEqual((await b.list<any>('items')).map(r => r.who), ['two']);
+  const c1 = makeCtx('one', { secrets: {}, settings: {}, store: base, uid }); await c1.store.put('items', 'y', { q: 1 }); assert.deepEqual(await base.get('one.items', 'y'), { q: 1 });
+});
+
+test('a restart loses nothing: items, stock, customers, orders, order numbers and gift cards are all still there', async () => {
+  const kv = fakeKV(); let ctx = ctxOn(kv);
+  const ref = await api('catalogue').createItem(ctx, { title: 'Dino', priceCents: 500, stock: 7 });
+  const cust = await api('customers').create(ctx, { firstName: 'Ann', email: 'a@x.com' });
+  const first = await api('orders').record(ctx, sale('s1', { lines: [{ ...sale('x').lines[0], variantId: ref.variantId }], customer: { id: cust.id, name: 'Ann' } }), { key: 'k1' });
+  const card = await api('giftCards').create(ctx, { valueCents: 2000, code: 'WXYZ1234', saleUuid: 's1' }); await api('giftCards').debit(ctx, card.id, 500, 'sale');
+  await api('stock').adjust(ctx, { itemId: ref.inventoryItemId, delta: -2, reason: 'other', key: 'adj1' });
+
+  ctx = ctxOn(kv); // a fresh store over the same storage: the app was closed and reopened
+  const items = (await api('catalogue').listItems(ctx, {})).rows; assert.deepEqual([items.length, items[0].productTitle, items[0].stock], [1, 'Dino', 5]);
+  assert.equal((await api('customers').search(ctx, 'ann'))[0].orders, 1);
+  assert.deepEqual(await api('orders').find(ctx, 's1'), first);
+  assert.deepEqual(await api('orders').record(ctx, sale('s1'), { key: 'k1' }), first, 'recording the same sale again after a restart finds it');
+  assert.equal((await api('orders').record(ctx, sale('s2'), { key: 'k2' })).name, '#T1002', 'order numbers carry on');
+  assert.equal((await api('giftCards').lookup(ctx, 'WXYZ1234')).balanceCents, 1500);
+  await api('stock').adjust(ctx, { itemId: ref.inventoryItemId, delta: -2, reason: 'other', key: 'adj1' });
+  assert.equal((await api('catalogue').listItems(ctx, {})).rows[0].stock, 5, 'a repeated adjustment is still recognised after a restart');
+});
+
+test('writes take turns: parallel sales get distinct numbers and parallel adjustments all count', async () => {
+  const ctx = ctxOn(fakeKV());
+  const recs = await Promise.all(Array.from({ length: 12 }, (_, i) => api('orders').record(ctx, sale(`p${i}`), { key: `k${i}` })));
+  assert.equal(new Set(recs.map((r: any) => r.name)).size, 12); assert.equal(new Set(recs.map((r: any) => r.id)).size, 12);
+  const ref = await api('catalogue').createItem(ctx, { title: 'A', priceCents: 1, stock: 0 });
+  await Promise.all(Array.from({ length: 20 }, (_, i) => api('stock').adjust(ctx, { itemId: ref.inventoryItemId, delta: 1, reason: 'other', key: `a${i}` })));
+  assert.equal((await api('catalogue').listItems(ctx, {})).rows[0].stock, 20);
+  const gc = await api('giftCards').create(ctx, { valueCents: 1000, code: 'CODE9999', saleUuid: 'g' });
+  const res = await Promise.allSettled(Array.from({ length: 5 }, (_, i) => api('giftCards').debit(ctx, gc.id, 300, `d${i}`)));
+  assert.deepEqual([res.filter(r => r.status === 'fulfilled').length, (await api('giftCards').lookup(ctx, 'CODE9999')).balanceCents], [3, 100], 'never spends more than the card holds');
+  await assert.rejects(api('orders').record(ctx, { uuid: 'bad' } as any, { key: 'x' }), () => true); await api('orders').record(ctx, sale('after'), { key: 'ka' });
+});
+
+const fullSel = (a: string) => ({ catalogue: a, stock: a, customers: a, orders: a, giftCards: a, discounts: a, sharedState: 'icloud' }) as any;
+const ALL = [tillium, shopify, icloud];
+const routerFor = (sel: any, alloys = [tillium, shopify, icloud]) => createRouter({ alloys, selection: () => sel, legacyFacts: () => ({ shopifyConnected: false, sharedBackend: 'metaobject', zellerPaired: false }), ctxFor: id => makeCtx(id, { secrets: {}, settings: {}, store: memoryStore(), uid }), isTraining: () => false });
+
+test('ready: today\'s setup answers exactly "is Shopify signed in" for every part; a saved choice asks the Alloy', () => {
+  for (const el of ['orders', 'sharedState', 'giftCards'] as const) {
+    assert.equal(alloyReady(el, routerFor(undefined), () => true), true); assert.equal(alloyReady(el, routerFor(undefined), () => false), false);
+  }
+  const t = routerFor(fullSel('tillium'));
+  assert.equal(alloyReady('orders', t, () => false, ALL), true, 'Pure Tillium needs no Shopify login');
+  assert.equal(alloyReady('giftCards', t, () => false, ALL), true);
+  assert.equal(alloyReady('cardTerminal', t, () => true, ALL), false, 'a part nobody supplies is not ready');
+  assert.equal(alloyReady('orders', routerFor(fullSel('shopify')), () => true, ALL), false, 'Shopify chosen but not signed in here (its own check, not the argument)');
+  assert.equal(alloyReady('orders', routerFor({ ...fullSel('tillium'), orders: 'off' }), () => true, ALL), false);
+});
+
+test('ready: iCloud is ready only once Cloud sync is the backend in use', async () => {
+  assert.equal(typeof icloud.ready, 'function'); assert.equal(icloud.ready!(), false, 'no CloudKit backend is active in a fresh node run');
+  assert.equal(tillium.ready, undefined); assert.equal(typeof shopify.ready, 'function');
+});
+
+test('the sync code no longer asks about Shopify credentials directly', () => {
+  const sync = readFileSync('src/lib/sync.ts', 'utf8');
+  assert.ok(!/hasCreds/.test(sync)); assert.equal((sync.match(/alloyReady\('sharedState'\)/g) ?? []).length, 8); assert.equal((sync.match(/alloyReady\('orders'\)/g) ?? []).length, 2);
+  for (const f of ['src/screens/Transactions.tsx', 'src/screens/Reports.tsx']) assert.ok(!/hasCreds/.test(readFileSync(f, 'utf8')), f);
+});
