+// Location: src/alloyhost/ready.ts
+// Alloys P7b: "can this part of the till do work right now?", which the sync code used to answer with `hasCreds()` (Shopify is signed in).
+// Today's setup (nothing saved) still answers exactly that for every part, so nothing changes. Once a choice is saved it asks the Alloy that
+// supplies the part, so a shop on Pure Tillium is not held back for want of a Shopify login.
+import { ALLOYS } from '../alloys';
+import type { Alloy, ElementId } from '../alloykit/types';
+import { hasCreds } from '../lib/shopify/client';
+import { appRouter } from './appRouter';
+import type { Router } from './router';
+
+export function alloyReady(element: ElementId, router: Router = appRouter, shopifySignedIn: () => boolean = hasCreds, alloys: Alloy[] = ALLOYS): boolean {
+  if (router.current().source === 'legacy') return shopifySignedIn();
+  const id = router.alloyId(element); if (!id || !router.has(element)) return false;
+  const a = alloys.find(x => x.id === id);
+  return !!a && (a.ready ? a.ready() : true);
+}
