index 0000000..853383b
--- /dev/null
+++ b/src/alloyhost/persistentStore.ts
@@ -0,0 +1,44 @@
+// Location: src/alloyhost/persistentStore.ts
+// Alloys P7b: the LocalStore that survives a restart, over AsyncStorage, for Pure Tillium. One key per record, `tl1:<collection>:<id>`, so
+// a write touches only its own record and a crash can lose at most the write in flight. Reads of a whole collection list the keys with
+// that prefix. It never swallows a failed write: an Alloy must know the record was not saved (the memory store throws nothing either, but
+// real storage can be full). Values are JSON, so what is read back is never the same object that was written.
+import type { LocalStore } from '../alloykit/types';
+
+/** The part of AsyncStorage this uses, so a test can supply its own. */
+export type KV = {
+  getItem(k: string): Promise<string | null>; setItem(k: string, v: string): Promise<void>; removeItem(k: string): Promise<void>;
+  getAllKeys(): Promise<readonly string[]>; multiGet(keys: readonly string[]): Promise<readonly (readonly [string, string | null])[]>;
+};
+const PREFIX = 'tl1:';
+const key = (collection: string, id: string) => `${PREFIX}${collection}:${id}`;
+
+export function asyncStorageStore(kv: KV): LocalStore {
+  return {
+    async get<T>(c: string, id: string) { const v = await kv.getItem(key(c, id)); return v === null ? null : JSON.parse(v) as T; },
+    async put<T>(c: string, id: string, value: T) { await kv.setItem(key(c, id), JSON.stringify(value)); },
+    async remove(c: string, id: string) { await kv.removeItem(key(c, id)); },
+    async list<T>(c: string) {
+      const p = `${PREFIX}${c}:`; const keys = (await kv.getAllKeys()).filter(k => k.startsWith(p)).sort();
+      if (!keys.length) return [];
+      const out: T[] = []; for (let i = 0; i < keys.length; i += 200) for (const [, v] of await kv.multiGet(keys.slice(i, i + 200))) if (v !== null) out.push(JSON.parse(v) as T);
+      return out;
+    },
+  };
+}
+
+/** Each Alloy gets its own corner of the store, so two Alloys can use the same collection names without meeting. */
+export function scopedStore(base: LocalStore, alloyId: string): LocalStore {
+  const c = (collection: string) => `${alloyId}.${collection}`;
+  return { get: (col, id) => base.get(c(col), id), put: (col, id, v) => base.put(c(col), id, v), remove: (col, id) => base.remove(c(col), id), list: col => base.list(c(col)) };
+}
+
+let real: LocalStore | null = null;
+/** The app's store: AsyncStorage when it can be loaded (always on a device), else memory (a node test). */
+export function appLocalStore(): LocalStore {
+  if (real) return real;
+  let AS: KV | null = null;
+  try { AS = require('@react-native-async-storage/async-storage').default as KV; } catch { AS = null; }
+  real = AS ? asyncStorageStore(AS) : require('./store').memoryStore() as LocalStore;
+  return real;
+}
