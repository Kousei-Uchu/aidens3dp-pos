+// Location: tests/alloypersist.test.ts
+// Alloys P7b: Pure Tillium's data survives a restart, two writes never collide, Alloys keep out of each other's data, and the sync code asks
+// "is this part ready" through the Alloy instead of "is Shopify signed in" (with today's setup giving the very same answer as before).
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { asyncStorageStore, scopedStore, type KV } from '../src/alloyhost/persistentStore';
+import { makeCtx } from '../src/alloyhost/ctx';
+import { createRouter } from '../src/alloyhost/router';
+import { alloyReady } from '../src/alloyhost/ready';
