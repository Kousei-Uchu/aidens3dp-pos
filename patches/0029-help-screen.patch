+  assert.equal(f!.dir, 'LR'); assert.deepEqual(f!.nodes.map(n => [n.id, n.shape, n.label]), [['A', 'box', 'Start'], ['B', 'decision', 'Ok?'], ['C', 'round', 'Done'], ['D', 'box', 'D']]);
+  assert.deepEqual(f!.edges, [{ from: 'A', to: 'B' }, { from: 'B', to: 'C', label: 'yes' }, { from: 'B', to: 'D', label: 'no' }]);
