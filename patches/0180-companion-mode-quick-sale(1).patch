", \"summary\": \"Choose an amount to sell a gift card.\", \"keywords\": [\"sell voucher\", \"gift card amount\", \"new gift card\"] }\nSCREEN sheet_gift_sell_details \"Gift card\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Gift card\", \"summary\": \"Gift card details: handover or email to the recipient.\", \"keywords\": [\"gift card email\", \"recipient\", \"handover\"] }\nSCREEN sheet_cart_menu \"Cart menu\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Cart menu\", \"summary\": \"The cart's menu: discount, whole order price, save cart, sell a gift card.\", \"keywords\": [\"three dots\", \"more options\", \"cart options\", \"cart actions\"] }\nSCREEN sheet_cart_discount \"Cart discount\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Cart discount\", \"summary\": \"Apply a discount to the whole cart.\", \"keywords\": [\"percent off\", \"discount the sale\", \"whole cart discount\", \"money off\"] }\nSCREEN sheet_order_price \"Whole order price\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Whole order price\", \"summary\": \"Set a single price for the whole order.\", \"keywords\": [\"total price\", \"override total\", \"round price\", \"agreed price\"] }\nSCREEN sheet_review \"Check the price adjustments\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Check the price adjustments\", \"summary\": \"Check the price adjustments before payment.\", \"keywords\": [\"review adjustments\", \"price changes\", \"confirm discounts\"] }\nSCREEN sheet_bundles \"Check these bundles\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Check these bundles\", \"summary\": \"Check bundle deals found in the cart before payment.\", \"keywords\": [\"bundle deal\", \"buy together\", \"multi buy\"] }\nSCREEN sheet_cart_warnings \"Customer warning\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Customer warning\", \"summary\": \"A customer warning shown at Charge when the cart holds a flagged item.\", \"keywords\": [\"warning\", \"fragile\", \"prompt\", \"reminder at charge\"] }\nSCREEN sheet_warning_list \"Warnings list\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Warnings list\", \"summary\": \"The list of warnings that were added to the list instead of shown on Charge, e.g. an item sold from a fixed display that needs putting back out.\", \"keywords\": [\"warning list\", \"restock\", \"display\", \"put another out\", \"queued warning\"] }\nSCREEN sheet_save_cart \"Save cart\" { \"kind\": \"sheet\", \"tab\": \"checkout\", \"label\": \"Save cart\", \"summary\": \"Save the cart to finish later.\", \"keywords\": [\"park\", \"hold sale\", \"put on hold\", \"save sale\"] }\n\ntab_checkout -> sheet_search [say=\"Tap Search.\"] { DO TAP { \"target\": \"find.search\" } }\nsheet_search -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\ntab_checkout -> sheet_customer [say=\"Tap the customer row.\"] { DO TAP { \"target\": \"cart.customer\" } }\npage_cart -> sheet_customer [say=\"Tap the customer row.\"] { DO TAP { \"target\": \"cart.customer\" } }\nsheet_customer -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_customer -> sheet_customer_new [say=\"Tap Create customer.\"] { DO TAP { \"target\": \"customer.create\" } }\nsheet_customer_new -> sheet_customer [say=\"Tap Back.\"] { DO TAP { \"target\": \"customer.back\" } }\ntab_checkout -> sheet_custom_amount [say=\"Tap Custom amount.\"] { DO TAP { \"target\": \"grid.action:custom\" } }\nsheet_custom_amount -> tab_checkout [say=\"Close this window first.\"] { DO TAP { \"target\": \"sheet.close\" } }\nsheet_cart_menu -> sheet_gift_sell [say=\"Tap Sell gift card.\"] { DO TAP { \"target\": \"cart.menu.gift\" } }\nsheet_gift_sell -> sheet_gift_sell_details [say=\"Tap Next.\"] { DO TAP { \"target\": \"gift.next\" } }\nsheet_gift_sell_details -> sheet_gift_sell [say=\"Tap Change amount.\"] { DO TAP { \"target\": \"gift.