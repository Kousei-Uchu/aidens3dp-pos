+// Location: src/alloyhost/smelter.ts
+// Alloys P8a: reads both sides for the Smelter and builds the plan (the dry run). Reads only: it never writes, in practice mode or out of it.
+// It talks to each Alloy directly rather than through the router, because the router answers for the one connection in use and the Smelter
+// needs the connection being left and the one being joined at the same moment.
+import { ALLOYS } from '../alloys';
+import { buildPlan, type SmeltPlan, type SmeltSide } from '../alloykit/smelter';
+import type { Alloy, Ctx } from '../alloykit/types';
+import { appCtxFor } from './appRouter';
+import { readAllPages } from './catalogue';
+import type { Collection, Customer, Variant } from '../lib/types';
+
+export type SideResult = { ok: true; side: SmeltSide } | { ok: false; problem: string };
+
+export async function readSide(id: string, onProgress?: (s: string) => void, alloys: Alloy[] = ALLOYS, ctxFor: (id: string) => Ctx = appCtxFor): Promise<SideResult> {
+  const a = alloys.find(x => x.id === id);
+  if (!a) return { ok: false, problem: `This version of the app has no connection called "${id}".` };
+  const cat = a.elements.catalogue?.api;
+  if (!cat) return { ok: false, problem: `${a.name} holds no catalogue.` };
+  const ctx = ctxFor(id);
+  try {
+    onProgress?.(`Reading items from ${a.name}…`);
+    const items: Variant[] = await readAllPages(r => cat.listItems(ctx, r), onProgress);
+    const collections: Collection[] = await readAllPages(r => cat.listCollections(ctx, r), onProgress);
+    const cu = a.elements.customers?.api;
+    onProgress?.(`Reading customers from ${a.name}…`);
+    const customers: Customer[] | null = cu?.listAll ? await cu.listAll(ctx, { onProgress }) : null;
+    return { ok: true, side: { id, name: a.name, items, collections, customers,
+      can: { createItem: !!cat.createItem, createCollection: !!cat.createCollection, createCustomer: !!cu?.create, setStock: !!a.elements.stock?.api.set } } };
+  } catch (e) { return { ok: false, problem: `Could not read ${a.name}: ${e instanceof Error && e.message ? e.message : 'unknown problem'}` }; }
+}
+
+export type DryRun = { ok: true; plan: SmeltPlan } | { ok: false; problem: string };
+
+/** What copying everything from one connection to another would do, without doing any of it. */
+export async function dryRun(fromId: string, toId: string, onProgress?: (s: string) => void, alloys: Alloy[] = ALLOYS, ctxFor: (id: string) => Ctx = appCtxFor): Promise<DryRun> {
+  if (fromId === toId) return { ok: false, problem: 'Choose two different connections.' };
+  const from = await readSide(fromId, onProgress, alloys, ctxFor); if (!from.ok) return from;
+  const to = await readSide(toId, onProgress, alloys, ctxFor); if (!to.ok) return to;
+  return { ok: true, plan: buildPlan(from.side, to.side) };
+}
