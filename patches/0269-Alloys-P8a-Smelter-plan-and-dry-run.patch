diff --git a/src/alloykit/smelter.ts b/src/alloykit/smelter.ts
new file mode 100644
index 0000000..c60187d
--- /dev/null
+++ b/src/alloykit/smelter.ts
@@ -0,0 +1,123 @@
+// Location: src/alloykit/smelter.ts
+// Alloys P8a: the Smelter's plan. The Smelter copies a shop's catalogue, stock levels and customers from one connection to another (for
+// example Shopify to Pure Tillium). This file is the plan and the dry run: given what both sides hold, it says exactly what would be created,
+// what is already there, what will be left behind and why. It reads nothing and writes nothing itself, so it is pure and cheap to test, and
+// the run in P8b takes this very plan as its work list, so what the person was shown is what happens.
+import type { Collection, Customer, Variant } from '../lib/types';
+import type { ItemInput } from './types';
+
+/** Everything the plan needs to know about one connection. `customers` is null when that connection cannot list them all. */
+export type SmeltSide = {
+  id: string; name: string;
+  items: Variant[]; collections: Collection[]; customers: Customer[] | null;
+  can: { createItem: boolean; createCollection: boolean; createCustomer: boolean; setStock: boolean };
+};
+export type SmeltItem = { sourceVariantId: string; sourceProductId: string; input: ItemInput; collectionTitles: string[] };
+export type SmeltCollection = { title: string; sourceProductIds: string[] };
+export type SmeltCustomer = { sourceId: string; name: string; email?: string; phone?: string; note?: string };
+export type PartState = 'ready' | 'nothing' | 'blocked';
+export type PartPlan = { part: 'items' | 'collections' | 'customers'; label: string; state: PartState; toCreate: number; alreadyThere: number; leftBehind: number; note: string };
+export type NotMoved = { what: string; why: string };
+export type SmeltPlan = {
+  from: { id: string; name: string }; to: { id: string; name: string };
+  parts: PartPlan[]; notMoved: NotMoved[]; warnings: string[];
+  work: { items: SmeltItem[]; collections: SmeltCollection[]; customers: SmeltCustomer[] };
+  /** Stock units that will arrive with the items, for the summary line. */
+  stockUnits: number;
+  /** True when there is something to do and nothing blocks it. */
+  canRun: boolean;
+};
+
+const norm = (s: string | undefined) => (s ?? '').trim().toLowerCase();
+const digits = (s: string | undefined) => (s ?? '').replace(/\D/g, '');
+const titleOf = (v: Variant) => (v.variantTitle && norm(v.variantTitle) !== 'default title' ? `${v.productTitle} - ${v.variantTitle}` : v.productTitle).trim();
+const live = (v: Variant) => v.active !== false && (!v.status || v.status === 'ACTIVE');
+
+/** How an item in the destination is recognised as the same as one in the source: SKU, then barcode, then name and price. */
+function itemKeys(v: Variant): string[] {
+  const k: string[] = [];
+  if (norm(v.sku)) k.push(`sku:${norm(v.sku)}`);
+  if (norm(v.barcode)) k.push(`bc:${norm(v.barcode)}`);
+  if (!k.length) k.push(`np:${norm(titleOf(v))}|${v.priceCents}`);
+  return k;
+}
+function customerKeys(c: { name: string; email?: string; phone?: string }): string[] {
+  const k: string[] = [];
+  if (norm(c.email)) k.push(`e:${norm(c.email)}`);
+  if (digits(c.phone).length >= 6) k.push(`p:${digits(c.phone).slice(-9)}`);
+  if (!k.length) k.push(`n:${norm(c.name)}`);
+  return k;
+}
+
+export function buildPlan(src: SmeltSide, dst: SmeltSide): SmeltPlan {
+  const notMoved: NotMoved[] = [
+    { what: 'Order history', why: `Past orders stay in ${src.name}. A copy would not be the real sale, so reports for earlier dates still come from ${src.name}.` },
+    { what: 'Gift cards', why: `${src.name} does not give out the full codes of cards already sold, so they could not be redeemed on ${dst.name}. Let them run down there, or keep ${src.name} for gift cards.` },
+    { what: 'Automatic discounts and presets', why: `${dst.name} has no way to create them from outside, so set them up again there.` },
+    { what: 'Pictures and sales channels', why: 'Only names, prices, codes, costs, stock and collections are copied.' },
+  ];
+  const warnings: string[] = [];
+  const parts: PartPlan[] = [];
+
+  // Items
+  const dstItemKeys = new Set(dst.items.flatMap(itemKeys));
+  const seenNow = new Set<string>();
+  const items: SmeltItem[] = []; let already = 0; let left = 0; let stockUnits = 0; let optionItems = 0; let noCode = 0;
+  const colsByProduct = new Map<string, string[]>();
+  for (const c of src.collections) for (const p of c.productIds) colsByProduct.set(p, [...(colsByProduct.get(p) ?? []), c.title]);
+  for (const v of src.items) {
+    if (!live(v)) { left++; continue; }
+    const keys = itemKeys(v);
+    if (keys.some(k => dstItemKeys.has(k) || seenNow.has(k))) { already++; continue; }
+    keys.forEach(k => seenNow.add(k));
+    if (v.variantTitle && norm(v.variantTitle) !== 'default title') optionItems++;
+    if (!norm(v.sku) && !norm(v.barcode)) noCode++;
+    const stock = v.tracked && typeof v.stock === 'number' ? v.stock : undefined;
+    if (stock && stock > 0) stockUnits += stock;
+    items.push({ sourceVariantId: v.id, sourceProductId: v.productId, collectionTitles: colsByProduct.get(v.productId) ?? [],
+      input: { title: titleOf(v), priceCents: v.priceCents, sku: v.sku, barcode: v.barcode, costCents: v.costCents, stock } });
+  }
+  const itemState: PartState = !dst.can.createItem ? 'blocked' : items.length ? 'ready' : 'nothing';
+  parts.push({ part: 'items', label: 'Items and stock', state: itemState, toCreate: items.length, alreadyThere: already, leftBehind: left,
+    note: itemState === 'blocked' ? `${dst.name} cannot create items from outside.` : items.length ? `${items.length} to copy with ${stockUnits} units of stock${left ? `; ${left} archived or draft left behind` : ''}${already ? `; ${already} already there` : ''}.` : already ? 'Everything is already there.' : 'No items to copy.' });
+  if (optionItems) warnings.push(`${optionItems} item${optionItems === 1 ? ' has' : 's have'} options (size, colour). Each becomes its own item named like "Shirt - Large".`);
+  if (noCode) warnings.push(`${noCode} item${noCode === 1 ? ' has' : 's have'} no SKU or barcode, so running this twice could copy ${noCode === 1 ? 'it' : 'them'} again if the name or price changed.`);
+  if (dst.items.length) warnings.push(`${dst.name} already holds ${dst.items.length} item${dst.items.length === 1 ? '' : 's'}. Matching ones (same SKU, barcode, or name and price) are skipped, never overwritten.`);
+
+  // Collections
+  const wantCols: SmeltCollection[] = [];
+  const dstTitles = new Set(dst.collections.map(c => norm(c.title)));
+  let colAlready = 0;
+  for (const c of src.collections) {
+    if (dstTitles.has(norm(c.title))) { colAlready++; continue; }
+    const carried = new Set(items.map(i => i.sourceProductId));
+    const ids = c.productIds.filter(p => carried.has(p));
+    wantCols.push({ title: c.title, sourceProductIds: ids });
+  }
+  const colState: PartState = !dst.can.createCollection || itemState === 'blocked' ? 'blocked' : wantCols.length ? 'ready' : 'nothing';
+  parts.push({ part: 'collections', label: 'Collections', state: colState, toCreate: wantCols.length, alreadyThere: colAlready, leftBehind: 0,
+    note: colState === 'blocked' ? (itemState === 'blocked' ? 'Collections hold items, and the items cannot be copied.' : `${dst.name} cannot create collections from outside.`) : wantCols.length ? `${wantCols.length} to copy${colAlready ? `; ${colAlready} already there` : ''}.` : 'No collections to copy.' });
+
+  // Customers
+  let custs: SmeltCustomer[] = []; let custAlready = 0; let custState: PartState; let custNote: string;
+  if (src.customers === null) { custState = 'blocked'; custNote = `${src.name} cannot list all its customers.`; }
+  else if (!dst.can.createCustomer) { custState = 'blocked'; custNote = `${dst.name} cannot create customers from outside.`; }
+  else {
+    const have = new Set((dst.customers ?? []).flatMap(customerKeys)); const seen = new Set<string>();
+    for (const c of src.customers) {
+      const ks = customerKeys(c);
+      if (ks.some(k => have.has(k) || seen.has(k))) { custAlready++; continue; }
+      ks.forEach(k => seen.add(k)); custs.push({ sourceId: c.id, name: c.name, email: c.email, phone: c.phone, note: c.note });
+    }
+    custState = custs.length ? 'ready' : 'nothing';
+    custNote = custs.length ? `${custs.length} to copy${custAlready ? `; ${custAlready} already there` : ''}. Their order counts and totals start again.` : custAlready ? 'Everyone is already there.' : 'No customers to copy.';
+  }
+  if (dst.customers === null && src.customers) warnings.push(`${dst.name} cannot list its customers, so matching ones cannot be skipped.`);
+  parts.push({ part: 'customers', label: 'Customers', state: custState, toCreate: custs.length, alreadyThere: custAlready, leftBehind: 0, note: custNote });
+  if (custState === 'blocked') custs = [];
+
+  const runnable = parts.filter(p => p.state === 'ready');
+  return { from: { id: src.id, name: src.name }, to: { id: dst.id, name: dst.name }, parts, notMoved, warnings,
+    work: { items: itemState === 'ready' ? items : [], collections: colState === 'ready' ? wantCols : [], customers: custs },
+    stockUnits: itemState === 'ready' ? stockUnits : 0, canRun: runnable.length > 0 };
+}
