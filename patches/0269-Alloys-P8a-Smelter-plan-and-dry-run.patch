+// Location: tests/alloysmelter.test.ts
+// Alloys P8a: the Smelter's plan and dry run. The plan is pure, so most of this feeds it two sides and checks what it says it would do.
+// The dry run reads both Alloys directly and is checked to write nothing.
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { buildPlan, type SmeltSide } from '../src/alloykit/smelter';
+import { dryRun, readSide } from '../src/alloyhost/smelter';
+import tillium from '../src/alloys/tillium/alloy';
+import { makeCtx } from '../src/alloyhost/ctx';
+import { memoryStore } from '../src/alloyhost/store';
+
+const v = (o: any = {}): any => ({ id: 'v1', productId: 'p1', productTitle: 'Dino', variantTitle: 'Default Title', priceCents: 1000, sku: 'D1', barcode: '', costCents: 300, stock: 4, tracked: true, active: true, status: 'ACTIVE', ...o });
+const side = (o: Partial<SmeltSide> = {}): SmeltSide => ({ id: 's', name: 'Src', items: [], collections: [], customers: [], can: { createItem: true, createCollection: true, createCustomer: true, setStock: true }, ...o });
+const part = (p: any, k: string) => p.parts.find((x: any) => x.part === k);
+
+test('items: copied with stock, archived and draft left behind', () => {
+  const p = buildPlan(side({ items: [v(), v({ id: 'v2', sku: 'D2', status: 'ARCHIVED' }), v({ id: 'v3', sku: 'D3', status: 'DRAFT' }), v({ id: 'v4', sku: 'D4', stock: 6 })] }), side({ id: 'd', name: 'Dst' }));
+  const i = part(p, 'items'); assert.deepEqual([i.state, i.toCreate, i.leftBehind], ['ready', 2, 2]);
+  assert.equal(p.stockUnits, 10); assert.equal(p.work.items[0].input.stock, 4); assert.equal(p.canRun, true);
+});
+
+test('items: matched by SKU, barcode, then name and price; duplicates in the source collapse', () => {
+  const dst = side({ id: 'd', name: 'Dst', items: [v({ id: 'x1', sku: 'D1' }), v({ id: 'x2', sku: '', barcode: 'B2', productTitle: 'Other' }), v({ id: 'x3', sku: '', productTitle: 'Plain', priceCents: 500 })] });
+  const src = side({ items: [v({ id: 'a', sku: 'd1' }), v({ id: 'b', sku: '', barcode: 'b2', productTitle: 'Renamed' }), v({ id: 'c', sku: '', productTitle: 'plain', priceCents: 500 }), v({ id: 'd', sku: '', productTitle: 'plain', priceCents: 700 }), v({ id: 'e', sku: 'N1' }), v({ id: 'f', sku: 'N1' })] });
+  const i = part(buildPlan(src, dst), 'items'); assert.deepEqual([i.toCreate, i.alreadyThere], [2, 4]);
+});
+
+test('items: options become their own named items, and untracked stock is not invented', () => {
+  const p = buildPlan(side({ items: [v({ variantTitle: 'Large', sku: 'S-L' }), v({ id: 'v9', sku: 'S-M', tracked: false, stock: null })] }), side({ id: 'd', name: 'Dst' }));
+  assert.equal(p.work.items[0].input.title, 'Dino - Large'); assert.equal(p.work.items[1].input.stock, undefined);
+  assert.ok(p.warnings.some(w => /options/.test(w)));
+});
+
+test('items without a code are warned about; a non-empty destination is warned about', () => {
+  const p = buildPlan(side({ items: [v({ sku: '', barcode: '' })] }), side({ id: 'd', name: 'Dst', items: [v({ id: 'q', sku: 'Z' })] }));
+  assert.ok(p.warnings.some(w => /no SKU or barcode/.test(w))); assert.ok(p.warnings.some(w => /already holds 1 item/.test(w)));
+});
+
+test('collections: only items that are carried, matched by title, blocked when items are', () => {
+  const src = side({ items: [v(), v({ id: 'v2', productId: 'p2', sku: 'D2', status: 'ARCHIVED' })], collections: [{ id: 'c1', title: 'Toys', productIds: ['p1', 'p2'] }, { id: 'c2', title: 'Old', productIds: [] }] as any });
+  const p = buildPlan(src, side({ id: 'd', name: 'Dst', collections: [{ id: 'z', title: ' old ', productIds: [] }] as any }));
+  assert.deepEqual(p.work.collections, [{ title: 'Toys', sourceProductIds: ['p1'] }]); assert.equal(part(p, 'collections').alreadyThere, 1);
+  const b = buildPlan(src, side({ id: 'd', name: 'Dst', can: { createItem: false, createCollection: true, createCustomer: true, setStock: true } }));
+  assert.equal(part(b, 'items').state, 'blocked'); assert.equal(part(b, 'collections').state, 'blocked'); assert.deepEqual(b.work.items, []);
+});
+
+test('customers: matched by email, phone digits, else name; blocked when a side cannot', () => {
+  const c = (o: any) => ({ id: 'c', name: 'A', ...o });
+  const src = side({ customers: [c({ id: '1', email: 'A@x.com' }), c({ id: '2', name: 'B', phone: '+61 400 111 222' }), c({ id: '3', name: 'C' }), c({ id: '4', name: 'D', email: 'd@x.com' })] });
+  const dst = side({ id: 'd', name: 'Dst', customers: [c({ id: 'z', email: 'a@x.com' }), c({ id: 'y', name: 'B', phone: '0400111222' }), c({ id: 'w', name: 'c' })] });
+  const p = buildPlan(src, dst); assert.deepEqual([part(p, 'customers').toCreate, part(p, 'customers').alreadyThere], [1, 3]);
+  assert.equal(part(buildPlan(side({ customers: null }), dst), 'customers').state, 'blocked');
+  assert.equal(part(buildPlan(src, side({ id: 'd', name: 'Dst', can: { createItem: true, createCollection: true, createCustomer: false, setStock: true } })), 'customers').state, 'blocked');
+});
+
+test('empty and fully copied cases say so, and cannot run; what is not moved is always listed', () => {
+  const p = buildPlan(side(), side({ id: 'd', name: 'Dst' })); assert.equal(p.canRun, false); assert.ok(p.parts.every(x => x.state === 'nothing'));
+  assert.deepEqual(p.notMoved.map(n => n.what), ['Order history', 'Gift cards', 'Automatic discounts and presets', 'Pictures and sales channels']);
+  const same = buildPlan(side({ items: [v()] }), side({ id: 'd', name: 'Dst', items: [v()] })); assert.equal(same.canRun, false); assert.match(part(same, 'items').note, /already there/);
+});
+
+test('dry run: reads two Alloys directly, writes nothing, refuses same side and unknown ids', async () => {
+  const src = makeCtx('tillium', { secrets: {}, settings: {}, store: memoryStore(), uid: () => 'abcdef12' });
+  const cat = (tillium.elements.catalogue as any).api; await cat.createItem(src, { title: 'Dino', priceCents: 1000, sku: 'D1', stock: 3 });
+  const dstCtx = makeCtx('other', { secrets: {}, settings: {}, store: memoryStore(), uid: () => 'abcdef12' });
+  const other: any = { ...tillium, id: 'other', name: 'Other' };
+  const ctxFor = (id: string) => (id === 'tillium' ? src : dstCtx);
+  const before = JSON.stringify(await src.store.list?.('items' as any).catch(() => null));
+  const r = await dryRun('tillium', 'other', undefined, [tillium, other], ctxFor);
+  assert.ok(r.ok); if (r.ok) { assert.equal(r.plan.work.items.length, 1); assert.equal(r.plan.stockUnits, 3); assert.equal(r.plan.work.items[0].input.title, 'Dino'); }
+  assert.equal(JSON.stringify(await src.store.list?.('items' as any).catch(() => null)), before);
+  assert.equal((await dryRun('tillium', 'tillium', undefined, [tillium], ctxFor)).ok, false);
+  const u = await readSide('nope', undefined, [tillium], ctxFor); assert.equal(u.ok, false);
+});
+
+test('dry run: a failed read becomes a plain problem, not a crash', async () => {
+  const bad: any = { ...tillium, id: 'bad', name: 'Bad', elements: { ...tillium.elements, catalogue: { ...tillium.elements.catalogue, api: { ...(tillium.elements.catalogue as any).api, listItems: async () => { throw new Error('offline'); } } } } };
+  const r = await readSide('bad', undefined, [bad], () => makeCtx('bad', { secrets: {}, settings: {}, store: memoryStore(), uid: () => 'abcdef12' }));
+  assert.ok(!r.ok && /Could not read Bad: offline/.test(r.problem));
+});
