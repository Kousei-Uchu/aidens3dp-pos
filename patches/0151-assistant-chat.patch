 export const APP_NAVSCHEMA: Record<string, unknown> = {"$schema":"https://routegraph.dev/schema/v1","schemaVersion":1,"name":"aidens3dp-pos","extends":"default","actions":{},"screenMetadata":{"kind":{"type":"string","enum":["app","tab","page","sheet","overlay","view","list","action"],"description":"What sort of place this node is. Used to word guidance and to reason about layers."},"label":{"type":"string","description":"What a person calls this place. Falls back to the screen name."},"tab":{"type":"string","description":"The bottom-bar tab this place belongs to, when it belongs to one."},"route":{"type":"string","description":"The pushed page this place is, when it is a page."},"roles":{"type":"array","items":{"type":"string"},"description":"Which staff roles may reach this place (cashier, manager, owner). Empty or missing means anyone."},"summary":{"type":"string","description":"One plain line about what this place is for."},"modules":{"type":"array","items":{"type":"string"},"description":"Which scopes this place exists in: a training module id (see src/training/index.ts), or \"real\" for the everyday till. Empty or missing means every scope, so only the places that differ carry it. Guidance never routes a run through a place outside its scope."}},"edgeMetadata":{"say":{"type":"string","description":"The words said while pointing at the control on this transition. Guidance prefixes the fix wording with this."},"gesture":{"type":"string","description":"tap, double, triple, hold, swipe-left, swipe-right, swipe-up, swipe-down, scroll-up, scroll-down. Left out is a tap."},"spot":{"type":"string","description":"The UI spot id this transition taps, when it has one. The runtime also learns this from the action payload."},"roles":{"type":"array","items":{"type":"string"},"description":"Which roles may take this transition. Empty or missing means anyone."},"modules":{"type":"array","items":{"type":"string"},"description":"Which scopes this transition exists in: a training module id, or \"real\" for the everyday till. Empty or missing means every scope. A transition is only used when the place it arrives at is also in scope."}}};
