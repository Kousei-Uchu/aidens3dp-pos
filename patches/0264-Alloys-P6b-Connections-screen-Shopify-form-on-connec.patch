--- /dev/null
+++ b/src/screens/Connections.tsx
@@ -0,0 +1,68 @@
+// Location: src/screens/Connections.tsx
+// Alloys P6b: Settings ▸ Connections. For each part of the till (Element), which connection (Alloy) supplies it. It opens on what the app
+// does today, changes nothing until Save, and never moves any data: choosing another service only changes where new work goes.
+import React, { useState } from 'react';
+import { View } from 'react-native';
+import { Btn, Chip, Section, Txt, alertMsg, confirm } from '../ui/kit';
+import { ALLOYS } from '../alloys';
+import { appRouter } from '../alloyhost/appRouter';
+import { clearSelection, connectAlloy, readSavedSelection, saveSelection } from '../alloyhost/choice';
+import { alloysInUse, buildPicker, choose, pickerReady, sameSelection, startingDraft, type Reports } from '../alloykit/picker';
+import { OFF, type Selection } from '../alloykit/types';
+
+export function Connections() {
+  const saved = readSavedSelection();
+  const [draft, setDraft] = useState<Selection>(() => startingDraft(saved, appRouter.current().selection));
+  const [reports, setReports] = useState<Reports>({}); const [busy, setBusy] = useState(false); const [note, setNote] = useState(''); const [hasSaved, setHasSaved] = useState(!!saved);
+  const rows = buildPicker(ALLOYS, draft, reports); const ready = pickerReady(rows);
+  const changed = !sameSelection(draft, readSavedSelection() ?? appRouter.current().selection);
+  const pick = (element: (typeof rows)[number]['element'], alloyId: string) => {
+    const r = choose(draft, element, alloyId, ALLOYS);
+    if (!r.ok) { alertMsg('Cannot change that', r.reason); return; }
+    setDraft(r.selection); setNote('');
+  };
+  const check = async () => {
+    setBusy(true); setNote('');
+    const next: Reports = {};
+    for (const a of alloysInUse(draft, ALLOYS)) next[a.id] = await connectAlloy(a.id);
+    setReports(next); setBusy(false);
+    const bad = Object.entries(next).filter(([, r]) => r && !r.ok).map(([id, r]) => `${ALLOYS.find(a => a.id === id)?.name ?? id}: ${r!.problem}`);
+    setNote(bad.length ? bad.join('\n') : 'Every connection in use answered.');
+  };
+  const save = async () => {
+    if (!ready.ok) { alertMsg('Not yet', 'Choose where Catalogue, Orders and Shared state come from first.'); return; }
+    if (!(await confirm('Save this choice?', 'Only where the till gets its data from changes. No data is moved or deleted. Anything already in the old service stays there.', 'Save'))) return;
+    saveSelection(draft); setHasSaved(true); setNote('Saved.');
+  };
+  const reset = async () => {
+    if (!(await confirm('Go back to the current setup?', 'The saved choice is removed and the till reads its setup the way it did before this screen existed.', 'Go back', true))) return;
+    clearSelection(); setHasSaved(false); setDraft(startingDraft(undefined, appRouter.current().selection)); setReports({}); setNote('Back to the current setup.');
+  };
+  return (
+    <View style={{ padding: 16, gap: 12 }}>
+      <Txt size={13} sub>{hasSaved ? 'Using your saved choice.' : 'Nothing saved: the till is using its current setup, shown below.'}</Txt>
+      {rows.map(r => (
+        <Section key={r.element} title={`${r.label}${r.required ? ' (needed)' : ''}`}>
+          <View style={{ padding: 16, gap: 8 }}>
+            <Txt size={13} sub>{r.blurb}</Txt>
+            <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 8 }}>
+              {r.options.map(o => <Chip key={o.alloyId} label={o.name} active={r.chosen === o.alloyId} onPress={() => pick(r.element, o.alloyId)} />)}
+              {!r.required ? <Chip label="Off" active={!r.chosen} onPress={() => pick(r.element, OFF)} /> : null}
+            </View>
+            {r.chosen ? r.options.filter(o => o.alloyId === r.chosen).map(o => (
+              <View key={o.alloyId} style={{ gap: 2 }}>
+                {o.features.length ? <Txt size={12} sub>Can also: {o.features.join(', ')}</Txt> : null}
+                {o.limits.map(l => <Txt key={l} size={12} sub>{l}</Txt>)}
+              </View>
+            )) : null}
+            {r.warning ? <Txt size={12} style={{ color: r.state === 'off' ? undefined : '#B45309' }} sub={r.state === 'off'}>{r.warning}</Txt> : null}
+          </View>
+        </Section>
+      ))}
+      <Btn title="Check connections" icon="refresh" kind="secondary" busy={busy} onPress={() => void check()} />
+      <Btn title="Save choice" onPress={() => void save()} disabled={!ready.ok || (!changed && hasSaved)} />
+      {hasSaved ? <Btn title="Go back to the current setup" kind="ghost" onPress={() => void reset()} /> : null}
+      {note ? <Txt size={13} sub>{note}</Txt> : null}
+    </View>
+  );
+}
