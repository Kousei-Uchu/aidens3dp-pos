+// Location: src/screens/CashSheet.tsx
+// Taking cash by tapping the notes and coins handed over (0019), then showing which notes and coins to give back from the drawer ledger.
+// Everything is confirmed by hand: the cashier taps what they received and confirms what they gave. No hardware is involved.
+import React, { useEffect, useMemo, useState } from 'react';
+import { View } from 'react-native';
+import { Btn, Money, Sheet, Txt } from '../ui/kit';
+import { DenomPad } from '../ui/DenomPad';
+import { useTheme } from '../ui/theme';
+import { useApp } from '../state/store';
+import { addCounts, draftCounts, summariseCounts, totalOf, type Counts, type Draft } from '../lib/cashLedger';
+import { cashStatus, planChange } from '../lib/cashSale';
+import { fmt } from '../lib/money';
+
+/** What the sheet hands back. `received` / `given` are null when the cashier chose not to track notes and coins for this sale. */
+export type CashResult = { tendered: number; received: Counts | null; given: Counts | null };
+
+export function CashSheet({ visible, onClose, due, onTake }: { visible: boolean; onClose: () => void; due: number; onTake: (r: CashResult) => void }) {
+  const { c } = useTheme(); const drawer = useApp(s => s.pos.ledger.counts);
+  const [step, setStep] = useState<'receive' | 'change'>('receive'); const [draft, setDraft] = useState<Draft>([]); const [giveDraft, setGiveDraft] = useState<Draft>([]); const [manual, setManual] = useState(false);
+  useEffect(() => { if (visible) { setStep('receive'); setDraft([]); setGiveDraft([]); setManual(false); } }, [visible]);
+
+  const received = useMemo(() => draftCounts(draft), [draft]); const got = totalOf(received); const st = cashStatus(due, got);
+  const change = st.state === 'change' ? st.change : 0;
+  const plan = useMemo(() => (step === 'change' ? planChange(addCounts(drawer, received), change) : { kind: 'none' as const }), [step, drawer, received, change]);
+  const giving = draftCounts(giveDraft); const gave = totalOf(giving);
+  const manualMode = manual || (step === 'change' && plan.kind === 'impossible');
+
+  const finish = (given: Counts | null) => onTake({ tendered: got, received, given });
+  const finishPart = () => onTake({ tendered: got, received, given: null });
+
+  const header = (
+    <View style={{ alignItems: 'center', gap: 2 }}>
+      <Txt sub>Due</Txt><Money cents={due} size={30} weight="700" />
+      {step === 'receive' ? (st.state === 'short' ? <Txt weight="600" color={c.bad}>Short by {fmt(st.shortBy)}</Txt> : st.state === 'change' ? <Txt weight="600" color={c.good}>Change to give: {fmt(st.change)}</Txt> : st.state === 'exact' ? <Txt weight="600" color={c.good}>Exact</Txt> : <Txt sub>Tap what the customer hands over</Txt>) : null}
+    </View>
+  );
+
+  return (
+    <Sheet visible={visible} onClose={onClose} title={step === 'receive' ? 'Cash received' : 'Give change'}>
+      {step === 'receive' ? (
+        <View style={{ gap: 14 }}>
+          {header}
+          <DenomPad draft={draft} onChange={setDraft} totalLabel="Received" />
+          {st.state === 'short' ? <Btn title={`Take ${fmt(got)} as part payment`} onPress={finishPart} /> : null}
+          {st.state === 'exact' && got > 0 ? <Btn title="Take cash" onPress={() => finish(null)} /> : null}
+          {st.state === 'change' ? <Btn title={`Next: give ${fmt(change)} change`} onPress={() => setStep('change')} /> : null}
+          {due > 0 && got === 0 ? <Btn title="Exact amount (don't track notes)" kind="secondary" onPress={() => onTake({ tendered: due, received: null, given: null })} /> : null}
+        </View>
+      ) : (
+        <View style={{ gap: 14 }}>
+          <View style={{ alignItems: 'center', gap: 2 }}><Txt sub>Give the customer</Txt><Money cents={change} size={38} weight="700" /><Txt size={13} sub>from {fmt(got)} received for {fmt(due)} due</Txt></View>
+          {!manualMode && plan.kind === 'exact' ? (
+            <>
+              <View style={{ backgroundColor: c.fill, borderRadius: 14, padding: 14, alignItems: 'center' }}>
+                <Txt size={13} sub weight="600">Take from the drawer</Txt>
+                <Txt size={22} weight="700" style={{ textAlign: 'center' }}>{summariseCounts(plan.counts)}</Txt>
+                {plan.truncated ? <Txt size={12} sub style={{ textAlign: 'center' }}>The drawer holds a lot, so this is a good answer, not the only one.</Txt> : null}
+              </View>
+              <Btn title="Gave this change" onPress={() => finish(plan.counts)} />
+              <Btn title="I'll give different notes and coins" kind="secondary" onPress={() => { setManual(true); setGiveDraft([]); }} />
+            </>
+          ) : (
+            <>
+              {plan.kind === 'impossible' ? <Txt size={14} color={c.bad} style={{ textAlign: 'center' }}>The drawer can't make exactly {fmt(change)} from what it holds. Tap what you actually give.</Txt> : <Txt size={14} sub style={{ textAlign: 'center' }}>Tap the notes and coins you give back.</Txt>}
+              <DenomPad draft={giveDraft} onChange={setGiveDraft} totalLabel="Given" />
+              {gave !== change ? <Txt weight="600" color={gave > change ? c.bad : c.sub} style={{ textAlign: 'center' }}>{gave > change ? `${fmt(gave - change)} too much` : `${fmt(change - gave)} still to give`}</Txt> : null}
+              <Btn title="Gave this change" disabled={gave !== change} onPress={() => finish(giving)} />
+            </>
+          )}
+          <Btn title="Give change but don't track it" kind="ghost" onPress={() => finish(null)} />
+          <Btn title="Back" kind="ghost" onPress={() => { setStep('receive'); setManual(false); }} />
+        </View>
+      )}
+    </Sheet>
+  );
+}
