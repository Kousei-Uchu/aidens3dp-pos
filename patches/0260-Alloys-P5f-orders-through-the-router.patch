+  transactions: [{ id: 'T1', kind: 'SALE', status: 'SUCCESS', gateway: 'Cash', amountSet: { shopMoney: { amount: '10.00' } } }], ...o });
+const sale: any = { uuid: 'aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee', type: 'sale', ts: '2026-11-01T00:00:00Z', lines: [], tenders: [], itemsCents: 0, discountCents: 0, netCents: 0, tipCents: 0, totalCents: 0, roundingCents: 0, cogsCents: 0, feesCents: 0, deals: [] };
+const trace = () => JSON.stringify(fake.gqlCalls().map(c => [c.query, c.variables]));
+const both = async <T>(queue: () => void, viaRouter: () => Promise<T>, direct: () => Promise<T>) => {
+  fake.install(); await fake.signIn(); useApp.getState().patchSettings({ locationId: 'L1' }); queue(); const a = await viaRouter(); const ta = trace();
+  fake.install(); await fake.signIn(); useApp.getState().patchSettings({ locationId: 'L1' }); queue(); const b = await direct(); const tb = trace();
