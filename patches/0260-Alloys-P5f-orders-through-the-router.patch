+  assert.equal(page.next, 'c'); assert.equal(page.rows[0].lines[0].refundableQty, 2); assert.equal(page.rows[0].transactions[0].gateway, 'Cash');
+  const tab = await both(q, () => needFeature('orders', 'list')({ query: 'fulfillment_status:unfulfilled', limit: 30 }), async () => { const r = await o.listOrders({ query: 'fulfillment_status:unfulfilled', first: 30 }); return { rows: r.orders, next: r.next }; });
+  assert.equal(tab.rows.length, 1);
