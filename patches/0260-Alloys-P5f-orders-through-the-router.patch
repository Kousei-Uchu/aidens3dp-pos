+  const q = () => { fake.on('fulfillmentOrders(first: 10', fake.data({ order: { fulfillmentOrders: { nodes: [{ id: 'F1', status: 'OPEN' }] } } })); fake.on('fulfillmentCreate', ok('fulfillmentCreate', { fulfillment: { id: 'X', status: 'SUCCESS' } })); };
