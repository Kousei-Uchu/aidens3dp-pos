+test('a refund works from the order on screen (no extra read), restocks as asked, at the settings location, under the given key', async () => {
+  const { needFeature } = await import('../src/alloyhost/need'); const o = await import('../src/lib/shopify/orders'); const { mapOrder } = await import('../src/lib/shopify/orderModel');
+  const order = mapOrder(node());
+  const q = () => fake.on('refundCreate', ok('refundCreate', { refund: { id: 'R1' } }));
+  for (const restock of [true, false]) {
+    const r = await both(q, () => needFeature('orders', 'refund')(order, [{ lineId: 'LI1', qty: 1 }], { amounts: { cash: 500 }, note: 'Returned Goods (POS)', key: 'rk', restock }),
+      async () => ({ id: await o.refundOrderInShopify(order, [{ lineItemId: 'LI1', quantity: 1, restock }], { cash: 500 }, 'Returned Goods (POS)', 'L1', 'rk') }));
+    assert.deepEqual(r, { id: 'R1' });
+    assert.equal(fake.gqlCalls().filter(c => !c.query.includes('refundCreate')).length, 0);
