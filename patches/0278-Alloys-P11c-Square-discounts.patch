 // Location: src/alloys/square/alloy.ts
 // Alloys P10b: the Square Alloy. Catalogue, Stock, Customers and Orders on a Square account, through Square's own REST API (v2) with a personal
 // access token. It imports nothing from the app but the kit and types; every call goes through `ctx.http`, so it is tested against a fake.
-// Not offered: gift cards, discounts and the card reader (Square's reader is not driven from here). It says so on the picker (`limits`).
+// Not offered: gift cards and the card reader (Square's reader is not driven from here). It says so on the picker (`limits`).
 import { AlloyUserError } from '../../alloykit/errors';
 import { splitLineForOrder } from '../../alloykit/orderSplit';
 import type { Alloy, ConnectReport, Ctx, CustomerInput, ItemInput, ItemPatch, ItemRef, OrderDetail, OrderRef, Page, PageReq, RefundItem, StockLevel } from '../../alloykit/types';
-import type { Collection, Customer, SaleRecord, Tender, Variant } from '../../lib/types';
+import type { Collection, Customer, ManualPreset, SaleRecord, Tender, Variant } from '../../lib/types';
 
 const VERSION = '2025-10-16';
 const base = (ctx: Ctx) => (ctx.setting('environment').toLowerCase() === 'sandbox' ? 'https://connect.squareupsandbox.com' : 'https://connect.squareup.com');
@@ -109,6 +109,25 @@ async function currencyOf(ctx: Ctx): Promise<string> {
   const r = await call<{ location?: { currency?: string } }>(ctx, `/v2/locations/${encodeURIComponent(l)}`); const c = r.location?.currency || 'AUD'; currencies.set(l, c); return c;
 }
 
+// ── Discounts ─────────────────────────────────────────────────────────────────────────────
+type SqDiscount = { id: string; is_deleted?: boolean; discount_data?: { name?: string; discount_type?: string; percentage?: string; amount_money?: Money } };
+const discounts = {
+  /** Square's own automatic pricing rules are not read: they match items in ways the till's discount engine cannot be told about. */
+  async listAutomatic(): Promise<[]> { return []; },
+  /** The fixed percentage and fixed amount discounts in the catalogue, offered as the till's manual presets. Ones that ask for a value at the time are left out. */
+  async listPresets(ctx: Ctx): Promise<ManualPreset[]> {
+    const out: ManualPreset[] = []; let cursor: string | undefined;
+    do {
+      const r = await call<{ objects?: SqDiscount[]; cursor?: string }>(ctx, '/v2/catalog/list', { query: { types: 'DISCOUNT', cursor } });
+      for (const o of r.objects ?? []) { if (o.is_deleted) continue; const d = o.discount_data ?? {}; const label = (d.name ?? '').trim(); if (!label) continue;
+        if (d.discount_type === 'FIXED_PERCENTAGE' && Number(d.percentage) > 0) out.push({ id: o.id, kind: 'pct', value: Number(d.percentage), label });
+        else if (d.discount_type === 'FIXED_AMOUNT' && cents(d.amount_money) > 0) out.push({ id: o.id, kind: 'amt', value: cents(d.amount_money), label }); }
+      cursor = r.cursor;
+    } while (cursor);
+    return out;
+  },
+};
+
 // ── Stock ─────────────────────────────────────────────────────────────────────────────────
 const stock = {
   async changesSince(ctx: Ctx, cursor: string | null): Promise<{ levels: StockLevel[]; cursor: string }> {
@@ -271,6 +290,7 @@ const alloy: Alloy = {
   elements: {
     catalogue: { api: catalogue, needs: ['ITEMS_READ', 'ITEMS_WRITE'], limits: ['Each item has one price. Square item options become separate items when copied in.'] },
     stock: { api: stock, needs: ['INVENTORY_READ', 'INVENTORY_WRITE'], limits: ['Counts are for the one location you choose.'] },
+    discounts: { api: discounts, needs: ['ITEMS_READ'], limits: ['Fixed percentage and fixed amount discounts become presets. Automatic pricing rules are not read.'] },
     customers: { api: customers, needs: ['CUSTOMERS_READ', 'CUSTOMERS_WRITE'], limits: ['Searching by name reads the customer list, so the saved copy is faster.'] },
     orders: { api: orders, needs: ['ORDERS_READ', 'ORDERS_WRITE', 'PAYMENTS_WRITE'], limits: ['Sales are recorded in Square with their payments. Refunds go back against the same payments. Square cannot refund a gift card or exchange credit onto the card itself.'] },
   },
