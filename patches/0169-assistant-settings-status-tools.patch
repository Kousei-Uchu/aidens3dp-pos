+  sync: SyncState; zeller: ZellerStatus; outbox: readonly Pick<OutboxItem, 'queuedAt' | 'tries' | 'error' | 'blocked'>[]; notices: readonly Pick<Notice, 'ts' | 'kind' | 'title' | 'read'>[];
