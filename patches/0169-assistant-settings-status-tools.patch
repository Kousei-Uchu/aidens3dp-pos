+      set_up: isConfigured(a), model: safeLine(a.model, 80) || 'none',
+      endpoint: a.baseUrl.trim() ? classifyEndpoint(a.baseUrl, a.endpointMode) : 'none', endpoint_setting: a.endpointMode,
