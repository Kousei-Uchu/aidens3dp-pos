Subject: [PATCH] Cash drawer sync: expected cash from shared ledger, trim-safe
 merge

---
 src/lib/drawerSync.ts    | 16 ++++++++++++++--
 src/screens/Drawer.tsx   |  3 ++-
 tests/drawersync.test.ts | 11 +++++++++++
 3 files changed, 27 insertions(+), 3 deletions(-)

diff --git a/src/lib/drawerSync.ts b/src/lib/drawerSync.ts
index 9b27771..08907f2 100644
--- a/src/lib/drawerSync.ts
+++ b/src/lib/drawerSync.ts
@@ -2,7 +2,7 @@
 // 0168: the cash drawer is one physical drawer for the shop, so its state is shared between registers. This is the
 // pure half of that sync: folding in the ledger entries another register wrote, without losing ours. The upload and
 // download live in src/lib/sync.ts; this file has no React, no store and no network, so it is tested on its own.
-import { applyEntry, cleanCounts, MAX_ENTRIES, type CashLedger, type LedgerEntry } from './cashLedger';
+import { applyEntry, cleanCounts, entryTotal, MAX_ENTRIES, type CashLedger, type LedgerEntry } from './cashLedger';
 import type { Shift } from '../state/store';
 
 /** What a register shares about the drawer: the shift (open/closed, float, paid in and out) and the ledger. */
@@ -11,7 +11,10 @@ export type SharedDrawer = { shift: Shift; ledger: CashLedger };
 /** Entries `remote` holds that `local` does not, oldest first, so they can be applied in the order they happened. */
 export function missingEntries(local: LedgerEntry[], remote: LedgerEntry[]): LedgerEntry[] {
   const have = new Set(local.map(e => e.id));
-  return remote.filter(e => e && typeof e.id === 'string' && e.id && !have.has(e.id)).sort((a, b) => a.ts.localeCompare(b.ts));
+  // Once our history is full the oldest entries are trimmed off. A remote copy that is behind may still hold them, and
+  // they must not look new (they are already inside our counts), so at capacity only entries newer than our oldest count.
+  const floor = local.length >= MAX_ENTRIES ? local.reduce((m, e) => (e.ts < m ? e.ts : m), local[0].ts) : '';
+  return remote.filter(e => e && typeof e.id === 'string' && e.id && typeof e.ts === 'string' && !have.has(e.id) && e.ts >= floor).sort((a, b) => a.ts.localeCompare(b.ts));
 }
 
 /**
@@ -33,3 +36,12 @@ export function mergeDrawer(local: CashLedger, remote: CashLedger): CashLedger {
   const entries = Array.from(byId.values()).sort((a, b) => b.ts.localeCompare(a.ts)).slice(0, MAX_ENTRIES);
   return { counts: cleanCounts(counts), entries };
 }
+
+/**
+ * Net cash from sales and refunds since the drawer opened, from EVERY register. Other registers' sales never reach this
+ * register's sales list, but their cash moves are in the shared ledger, so expected cash is read from there: every entry
+ * tied to a sale (cash received, change given, cash refund, a cancelled part-sale) counts, in physical cash.
+ */
+export function ledgerCashSince(ledger: CashLedger, sinceISO: string): number {
+  return ledger.entries.filter(e => e.saleUuid && e.ts >= sinceISO).reduce((sum, e) => sum + entryTotal(e), 0);
+}
diff --git a/src/screens/Drawer.tsx b/src/screens/Drawer.tsx
index 7797c3b..518099a 100644
--- a/src/screens/Drawer.tsx
+++ b/src/screens/Drawer.tsx
@@ -7,6 +7,7 @@ import { SwapCashSheet } from './SwapCash';
 import { useNav } from '../ui/nav';
 import { useApp, currentStaff } from '../state/store';
 import { drawerChanged } from '../lib/sync';
+import { ledgerCashSince } from '../lib/drawerSync';
 import { csv } from '../lib/csvStore';
 import { fmt } from '../lib/money';
 import { DENOMS, LEDGER_LABEL, applyEntry, diffCounts, draftCounts, entryTotal, newEntry, shortfall, summariseCounts, totalOf, type Draft, type LedgerKind } from '../lib/cashLedger';
@@ -16,7 +17,7 @@ import { SPOT } from '../lib/trainingSpots';
 /** Current cash drawer: float, paid in/out, count vs expected, Z-report. One shared drawer for the shop (0167), so it is
  *  synced between registers and cash is counted from every register, not just this one. */
 export const cashSince = (sinceISO: string, registerId: string | undefined, sales = useApp.getState().pos.sales) =>
-  sales.filter(s => (!registerId || s.registerId === registerId) && s.ts >= sinceISO).reduce((sum, s) => sum + s.tenders.filter(t => t.kind === 'cash').reduce((x, t) => x + (s.type === 'sale' ? t.amountCents + (t.roundingCents ?? 0) : -t.amountCents), 0), 0);
+  !registerId ? ledgerCashSince(useApp.getState().pos.ledger, sinceISO) : sales.filter(s => (!registerId || s.registerId === registerId) && s.ts >= sinceISO).reduce((sum, s) => sum + s.tenders.filter(t => t.kind === 'cash').reduce((x, t) => x + (s.type === 'sale' ? t.amountCents + (t.roundingCents ?? 0) : -t.amountCents), 0), 0);
 
 export default function Drawer() {
   const nav = useNav(); const shift = useApp(s => s.pos.shift); const sales = useApp(s => s.pos.sales); const patchPos = useApp(s => s.patchPos); const ledger = useApp(s => s.pos.ledger);
diff --git a/tests/drawersync.test.ts b/tests/drawersync.test.ts
index b757284..31296d4 100644
--- a/tests/drawersync.test.ts
+++ b/tests/drawersync.test.ts
@@ -70,3 +70,14 @@ test('merging an empty remote drawer changes nothing', () => {
   assert.deepEqual(out.counts, { '2000': 2 });
   assert.deepEqual(out.entries.map(x => x.id), ['a']);
 });
+
+test('a remote entry already trimmed from our full history is not applied again', () => {
+  const old = e('old', '2026-10-01T00:00:00Z', 'sale_in', { '2000': 1 });
+  const mine = ledger({ '2000': 5 }, Array.from({ length: MAX_ENTRIES }, (_, i) => e('m' + i, new Date(Date.UTC(2026, 9, 2, 0, 0, i)).toISOString(), 'sale_in', {})));
+  assert.deepEqual(mergeDrawer(mine, ledger({}, [old])).counts, { '2000': 5 });
+});
+test('ledgerCashSince counts sale-linked entries from any register', async () => {
+  const { ledgerCashSince } = await import('../src/lib/drawerSync');
+  const l = ledger({}, [{ ...e('a', '2026-10-18T10:00:00Z', 'sale_in', { '2000': 1 }), saleUuid: 's' }, { ...e('b', '2026-10-18T10:00:00Z', 'sale_change', { '500': -1 }), saleUuid: 's' }, e('c', '2026-10-18T10:00:00Z', 'paid_in', { '1000': 1 }), { ...e('d', '2026-10-17T10:00:00Z', 'sale_in', { '1000': 1 }), saleUuid: 'z' }]);
+  assert.equal(ledgerCashSince(l, '2026-10-18T00:00:00Z'), 1500);
+});
