-export const APP_NAVGRAPH: string = "NAVGRAPH/2\nAPP \"Aidens 3D POS\"\n\n# The line key of a per line window (its variant, or the line's own id for a\n# custom amount). The `sheet_line` template below is copied once per open line\n# at runtime, and the copy fills this in (see `ensureLineWindow` in appGraph).\nVAR ITEM_KEY : string\n\n# ============================================================================\n# The app as a graph. Screens are places a person can be. Edges are how they\n# move and what they do. Control level action nodes are registered at runtime\n# from src/lib/appControls.ts (node id = \"do:\" + spot id), so every button,\n# tile, row and gesture in the app joins this graph without hand editing.\n#\n# Node kinds (screen meta \"kind\"):\n#   tab      the five bottom bar tabs\n#   view     a mode inside Checkout (Keypad, All products; Quick Menu is the tab)\n#   page     a pushed route\n#   sheet    a window drawn over the page\n#   overlay  something drawn over everything (sign in, screensaver, practice)\n#   action   a control, a terminal node in a route\n#\n# Edge meta:\n#   say      the words said while pointing at this transition\n#   gesture  tap (default), or a swipe/hold/scroll\n#   spot     the UI spot this transition taps, when it has one\n#   roles    who may take it\n#   modules  which run the transition belongs to (a module id, or \"real\"); missing means every run\n# ============================================================================\n\n# ---------------------------------------------------------------- tabs -----\nSCREEN tab_checkout \"Checkout\" { \"kind\": \"tab\", \"tab\": \"checkout\", \"label\": \"Checkout\", \"summary\": \"Build the sale and take payment.\" }\nSCREEN tab_inventory \"Inventory\" { \"kind\": \"tab\", \"tab\": \"inventory\", \"label\": \"Inventory\" }\nSCREEN tab_transactions \"Transactions\" { \"kind\": \"tab\", \"tab\": \"transactions\", \"label\": \"Transactions\" }\nSCREEN tab_notifications \"Notifi