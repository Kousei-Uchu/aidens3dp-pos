+  const removeSlot = (i: number) => reshape({ slots: f.slots.filter((_, k) => k !== i), applyToSlot: f.applyToSlot == null || f.applyToSlot === i ? null : f.applyToSlot > i ? f.applyToSlot - 1 : f.applyToSlot });
