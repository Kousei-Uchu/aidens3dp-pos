diff --git a/src/lib/drawerCheckpoint.ts b/src/lib/drawerCheckpoint.ts
new file mode 100644
index 0000000..05cbcc4
--- /dev/null
+++ b/src/lib/drawerCheckpoint.ts
@@ -0,0 +1,57 @@
+// Location: src/lib/drawerCheckpoint.ts
+// CloudKit sync, patch 6b (pure half, part 2): the drawer checkpoint.
+// The drawer counts are a running total, so replaying only the newest 1000 entries gives the wrong answer once the
+// drawer has more history than that. A checkpoint is one small record (`drawer-checkpoint`) holding the counts at a
+// point in time plus the server stamp of the newest entry it covers. A register reads the checkpoint, then replays only
+// the entries stamped after it. The stamp is CloudKit's own creation time for the record, NOT the entry's `ts`, because
+// a register that was offline uploads entries late, with an old `ts`, and those must still be counted.
+// No React, no store, no native code. Tested in tests/drawercheckpoint.test.ts. Decisions: item 6, O3.
+import { cleanCounts, type CashLedger, type Counts, type LedgerEntry } from './cashLedger';
+import { ledgerFromEntries } from './drawerRecords';
+
+export const CHECKPOINT_RECORD = 'drawer-checkpoint';
+
+/** An entry as CloudKit returned it: the entry plus the server's creation stamp (ISO text, sorts as time). */
+export type StampedEntry = { entry: LedgerEntry; stamp: string };
+export type Checkpoint = { counts: Counts; asOfStamp: string };
+
+export function checkpointToFields(c: Checkpoint): Record<string, string> {
+  return { counts: JSON.stringify(cleanCounts(c.counts)), asOfStamp: c.asOfStamp };
+}
+/** Null when the record is unreadable, so a bad checkpoint falls back to replaying everything instead of breaking. */
+export function checkpointFromFields(f: Record<string, unknown>): Checkpoint | null {
+  if (typeof f.counts !== 'string' || typeof f.asOfStamp !== 'string' || !f.asOfStamp) return null;
+  try {
+    const counts = JSON.parse(f.counts);
+    if (!counts || typeof counts !== 'object' || Array.isArray(counts)) return null;
+    return { counts: cleanCounts(counts as Counts), asOfStamp: f.asOfStamp };
+  } catch { return null; }
+}
+
+/** The newest stamp among the entries, or '' for none. */
+export const newestStamp = (all: StampedEntry[]): string => all.reduce((m, s) => (s.stamp > m ? s.stamp : m), '');
+
+/**
+ * The shared ledger from what CloudKit holds. With a checkpoint, only entries stamped after it are replayed on top of
+ * its counts; without one (none written yet, or unreadable), every entry given is replayed from empty. `history` is the
+ * entries to show (the newest 1000 are enough, and may be older than the checkpoint); the counts never depend on how
+ * many of them were loaded.
+ */
+export function ledgerFromRemote(checkpoint: Checkpoint | null, replay: StampedEntry[], history: LedgerEntry[] = []): CashLedger {
+  const after = checkpoint ? replay.filter(s => s.stamp > checkpoint.asOfStamp) : replay;
+  const counted = ledgerFromEntries(after.map(s => s.entry), checkpoint ? checkpoint.counts : {});
+  const shown = ledgerFromEntries([...history, ...after.map(s => s.entry)]);
+  return { counts: counted.counts, entries: shown.entries };
+}
+
+/**
+ * The checkpoint to write now, from the ledger as it stands and every stamped entry it covers. Null when there is nothing
+ * to cover. Written when a shift opens or closes, when nobody is mid-sale, so no entry is in flight behind its stamp.
+ */
+export function makeCheckpoint(ledger: CashLedger, covered: StampedEntry[]): Checkpoint | null {
+  const asOfStamp = newestStamp(covered);
+  return asOfStamp ? { counts: cleanCounts(ledger.counts), asOfStamp } : null;
+}
+
+/** A checkpoint only ever moves forward: never replace one with an older one, whichever register wrote it. */
+export const shouldReplaceCheckpoint = (existing: Checkpoint | null, candidate: Checkpoint): boolean => !existing || candidate.asOfStamp > existing.asOfStamp;
diff --git a/tests/drawercheckpoint.test.ts b/tests/drawercheckpoint.test.ts
new file mode 100644
index 0000000..b88a5a9
--- /dev/null
+++ b/tests/drawercheckpoint.test.ts
@@ -0,0 +1,54 @@
+// Location: tests/drawercheckpoint.test.ts
+// CloudKit patch 6b, part 2: the drawer checkpoint. Pins that counts stay right past 1000 entries, that an entry
+// uploaded late by an offline register (old `ts`, new server stamp) is still counted, and that a checkpoint never goes back.
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { checkpointFromFields, checkpointToFields, ledgerFromRemote, makeCheckpoint, newestStamp, shouldReplaceCheckpoint, type StampedEntry } from '../src/lib/drawerCheckpoint';
+import { ledgerFromEntries } from '../src/lib/drawerRecords';
+import type { LedgerEntry } from '../src/lib/cashLedger';
+
+const en = (id: string, ts: string, kind: LedgerEntry['kind'], delta: Record<string, number>): LedgerEntry => ({ id, ts, kind, delta });
+const st = (entry: LedgerEntry, stamp: string): StampedEntry => ({ entry, stamp });
+
+test('a checkpoint round trips, and an unreadable one is null', () => {
+  const c = { counts: { '2000': 3, '500': 0 }, asOfStamp: '2026-10-31T09:00:00.000Z' };
+  assert.deepEqual(checkpointFromFields(checkpointToFields(c)), { counts: { '2000': 3 }, asOfStamp: c.asOfStamp });
+  assert.equal(checkpointFromFields({ counts: '{bad', asOfStamp: 'x' }), null);
+  assert.equal(checkpointFromFields({ counts: '[]', asOfStamp: 'x' }), null);
+  assert.equal(checkpointFromFields({ counts: '{}', asOfStamp: '' }), null);
+});
+test('with no checkpoint every entry is replayed', () => {
+  const a = st(en('a', '2026-10-31T09:00:00Z', 'open', { '2000': 2 }), 's1'), b = st(en('b', '2026-10-31T10:00:00Z', 'sale_in', { '500': 1 }), 's2');
+  assert.deepEqual(ledgerFromRemote(null, [a, b]).counts, { '2000': 2, '500': 1 });
+});
+test('with a checkpoint only later entries are replayed on top of its counts', () => {
+  const old = st(en('a', '2026-10-31T09:00:00Z', 'open', { '2000': 2 }), 's1'), fresh = st(en('b', '2026-10-31T10:00:00Z', 'sale_in', { '500': 1 }), 's3');
+  const out = ledgerFromRemote({ counts: { '2000': 2 }, asOfStamp: 's2' }, [old, fresh], [old.entry]);
+  assert.deepEqual(out.counts, { '2000': 2, '500': 1 }); // the old entry is not counted twice
+  assert.deepEqual(out.entries.map(x => x.id), ['b', 'a']);
+});
+test('an entry an offline register uploads late is counted even though its ts is old', () => {
+  const late = st(en('late', '2026-10-31T08:00:00Z', 'sale_in', { '1000': 1 }), 's9'); // ts before the checkpoint, stamp after it
+  assert.deepEqual(ledgerFromRemote({ counts: { '2000': 1 }, asOfStamp: 's5' }, [late]).counts, { '2000': 1, '1000': 1 });
+});
+test('counts stay right when history is longer than the 1000 the app loads', () => {
+  const all = Array.from({ length: 1500 }, (_, i) => st(en(`e${i}`, new Date(Date.UTC(2026, 9, 1, 0, 0, i)).toISOString(), 'sale_in', { '500': 1 }), `s${String(i).padStart(5, '0')}`));
+  const truth = ledgerFromEntries(all.map(s => s.entry)).counts; // { '500': 1500 }
+  const cp = makeCheckpoint({ counts: ledgerFromEntries(all.slice(0, 1400).map(s => s.entry)).counts, entries: [] }, all.slice(0, 1400));
+  const newest1000 = all.slice(500).map(s => s.entry);
+  const out = ledgerFromRemote(cp, all.slice(1400), newest1000);
+  assert.deepEqual(out.counts, truth);
+  assert.equal(out.entries.length, 1000);
+});
+test('makeCheckpoint covers up to the newest stamp, and is null when nothing is covered', () => {
+  assert.equal(makeCheckpoint({ counts: {}, entries: [] }, []), null);
+  const covered = [st(en('a', 't', 'open', { '500': 1 }), 's1'), st(en('b', 't', 'paid_in', { '500': 1 }), 's7')];
+  assert.equal(newestStamp(covered), 's7');
+  assert.deepEqual(makeCheckpoint({ counts: { '500': 2 }, entries: [] }, covered), { counts: { '500': 2 }, asOfStamp: 's7' });
+});
+test('a checkpoint never goes backwards', () => {
+  const now = { counts: {}, asOfStamp: 's5' };
+  assert.equal(shouldReplaceCheckpoint(null, now), true);
+  assert.equal(shouldReplaceCheckpoint(now, { counts: {}, asOfStamp: 's4' }), false);
+  assert.equal(shouldReplaceCheckpoint(now, { counts: {}, asOfStamp: 's6' }), true);
+});
