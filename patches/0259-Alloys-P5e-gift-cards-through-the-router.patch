diff --git a/tests/alloyp5giftcards.test.ts b/tests/alloyp5giftcards.test.ts
new file mode 100644
index 0000000..fdb9fbc
--- /dev/null
+++ b/tests/alloyp5giftcards.test.ts
@@ -0,0 +1,85 @@
+// Location: tests/alloyp5giftcards.test.ts
+// Alloys P5e: gift cards (Pay, the cart scan, the Gift cards screen, the new-card sheet, Reports, the refund flow and the order outbox) reach
+// Shopify through the router. Pins that the Shopify calls are the same as before, that the outbox still treats a Shopify refusal as one
+// that needs attention (now arriving as an Alloy error), and that no caller imports the Shopify gift card files for these any more.
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import * as fake from './helpers/fakeShopify';
+import { setTrainingGuard } from '../src/lib/trainingGuard';
+import { WRITES } from '../src/alloyhost/router';
+
+const card = (o: any = {}) => ({ id: 'GC1', lastCharacters: 'ABCD', balance: { amount: '20.00' }, initialValue: { amount: '50.00' }, enabled: true, expiresOn: null, note: null, customer: null, ...o });
+const ok = (f: string, extra: Record<string, unknown> = {}) => fake.data({ [f]: { ...extra, userErrors: [] } });
+const txn = (id: string, kind: 'Debit' | 'Credit', amount: string, note: string) => ({ __typename: `GiftCard${kind}Transaction`, id, note, processedAt: '2026-11-01T00:00:00Z', amount: { amount } });
+
+test('lookup, history, all-history and outstanding through the router return what the Shopify functions return, with the same queries', async () => {
+  const { needFeature } = await import('../src/alloyhost/need'); const g = await import('../src/lib/shopify/giftcards');
+  const both = async <T>(queue: () => void, viaRouter: () => Promise<T>, direct: () => Promise<T>) => {
+    fake.install(); await fake.signIn(); queue(); const a = await viaRouter(); const qa = JSON.stringify(fake.gqlCalls().map(c => [c.query, c.variables]));
+    fake.install(); await fake.signIn(); queue(); const b = await direct(); const qb = JSON.stringify(fake.gqlCalls().map(c => [c.query, c.variables]));
+    assert.deepEqual(a, b); assert.equal(qa, qb); return a;
+  };
+  const found = await both(() => fake.on('giftCards(first: 10', fake.data({ giftCards: { nodes: [card()] } })), () => needFeature('giftCards', 'lookup')('ABCD1234EFGH5678'), () => g.lookupGiftCard('ABCD1234EFGH5678'));
+  assert.equal(found?.id, 'GC1');
+  const hist = () => fake.on('transactions(first: 30)', fake.data({ giftCard: { transactions: { nodes: [txn('A', 'Debit', '-5.00', 'n1')] } } }));
+  assert.equal((await both(hist, () => needFeature('giftCards', 'history')('GC1'), () => g.giftCardHistory('GC1'))).length, 1);
+  const all = () => fake.on('transactions(first:250', fake.data({ giftCard: { transactions: { pageInfo: { hasNextPage: false }, nodes: [txn('B', 'Credit', '2.00', 'n2')] } } }));
+  assert.equal((await both(all, () => needFeature('giftCards', 'allHistory')('GC1'), () => g.allGiftCardTransactions('GC1'))).length, 1);
+  const out = () => fake.on('giftCards(first: 100', fake.data({ giftCards: { pageInfo: { hasNextPage: false }, nodes: [{ balance: { amount: '2.50' } }] } }));
+  assert.deepEqual(await both(out, () => needFeature('giftCards', 'outstanding')(), () => g.outstandingBalance()), { cards: 1, cents: 250 });
+});
+
+test('creating a card (till sale from the outbox, or a refund to a new card) sends the same mutations, including the recipient', async () => {
+  fake.install(); await fake.signIn();
+  const { needFeature } = await import('../src/alloyhost/need');
+  fake.on('customers(first: 20', fake.data({ customers: { nodes: [{ id: 'U9', email: 'f@x.com', displayName: 'F' }] } }));
+  fake.on('giftCardCreate', ok('giftCardCreate', { giftCard: card() }));
+  const g = await needFeature('giftCards', 'create')({ valueCents: 5000, code: 'ABCD1234EFGH5678', saleUuid: 'S', customerId: 'U1', recipient: { email: 'f@x.com', name: 'Fay', message: 'Enjoy' } });
+  assert.equal(g.id, 'GC1'); const i = fake.lastCall().variables.i;
+  assert.equal(i.customerId, 'U1'); assert.deepEqual(i.recipientAttributes, { id: 'U9', preferredName: 'Fay', message: 'Enjoy' }); assert.equal(i.initialValue, '50.00');
+});
+
+test('debitOnce and creditOnce through the router skip what is already on the card and refuse a different amount, as before', async () => {
+  fake.install(); await fake.signIn();
+  const { needFeature } = await import('../src/alloyhost/need');
+  const hist = (nodes: any[]) => fake.on('transactions(first:250', fake.data({ giftCard: { transactions: { pageInfo: { hasNextPage: false }, nodes } } }));
+  hist([]); fake.on('giftCardDebit', ok('giftCardDebit', { giftCardDebitTransaction: { id: 'T' } }));
+  await needFeature('giftCards', 'debitOnce')('GC1', 500, 'POS sale AB tender 1');
+  assert.deepEqual(fake.lastCall().variables, { id: 'GC1', i: { debitAmount: { amount: '5.00', currencyCode: 'AUD' }, note: 'POS sale AB tender 1' } });
+  hist([txn('A', 'Credit', '3.00', 'N')]);
+  await needFeature('giftCards', 'creditOnce')('GC1', 300, 'N'); assert.equal(fake.gqlCalls().filter(c => c.query.includes('giftCardCredit')).length, 0);
+  hist([txn('A', 'Credit', '3.00', 'N')]);
+  await assert.rejects(() => needFeature('giftCards', 'creditOnce')('GC1', 400, 'N'), /different amount/);
+});
+
+test('a Shopify refusal reaches the outbox as an Alloy user error, and the outbox still treats it as one that needs attention', async () => {
+  fake.install(); await fake.signIn();
+  const { needFeature } = await import('../src/alloyhost/need'); const { isAlloyUserError } = await import('../src/alloykit/errors');
+  fake.on('giftCardCreate', fake.data({ giftCardCreate: { giftCard: null, userErrors: [{ code: 'INVALID', message: 'Too big' }] } }));
+  await assert.rejects(() => needFeature('giftCards', 'create')({ valueCents: 5000, code: 'ABCD1234EFGH5678', saleUuid: 'S' }), (e: any) => isAlloyUserError(e) && e.message === 'Creating the gift card: Too big');
+  assert.ok(readFileSync('src/lib/sync.ts', 'utf8').includes('const user = e instanceof ShopifyUserError || isAlloyUserError(e);'));
+});
+
+test('with no login the screens get the old "not set up" words, and in practice mode the old practice words', async () => {
+  fake.install(); const client = await import('../src/alloys/shopify/client'); await client.clearCreds();
+  const { needFeature, NOT_SET_UP } = await import('../src/alloyhost/need');
+  assert.throws(() => needFeature('giftCards', 'lookup'), (e: any) => e.message === NOT_SET_UP);
+  await fake.signIn(); setTrainingGuard(true);
+  try { assert.throws(() => needFeature('giftCards', 'lookup'), (e: any) => e.message === 'Training mode: Shopify is switched off.'); } finally { setTrainingGuard(false); }
+});
+
+test('the router treats every gift card write as a write (create, debit, credit and both once-only forms) in practice mode', () => {
+  assert.deepEqual(WRITES.giftCards, ['create', 'debit', 'credit', 'debitOnce', 'creditOnce']);
+});
+
+test('no caller imports the Shopify gift card file for these calls; the card type and the code maker come from the app side', () => {
+  const files = ['src/screens/Pay.tsx', 'src/screens/CartPane.tsx', 'src/screens/GiftCards.tsx', 'src/screens/sheets.tsx', 'src/screens/Reports.tsx', 'src/lib/refundFlow.ts', 'src/lib/sync.ts', 'src/lib/trainingGifts.ts'];
+  for (const f of files) {
+    const src = readFileSync(f, 'utf8');
+    assert.equal(/shopify\/giftcards/.test(src), false, f);
+    assert.equal(/\b(lookupGiftCard|createGiftCard|debitGiftCardOnce|creditGiftCardOnce|giftCardHistory|allGiftCardTransactions|outstandingBalance)\(/.test(src), false, f);
+  }
+  assert.ok(readFileSync('src/lib/giftCode.ts', 'utf8').includes('export const newGiftCode'));
+});
