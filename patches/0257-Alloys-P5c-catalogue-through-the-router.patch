@@ -0,0 +1,92 @@
+// Location: tests/alloyp5catalogue.test.ts
+// Alloys P5c: the catalogue import, the half-hourly refresh and the Items screen reach Shopify through the router. Pins that the Shopify
+// calls and results are the same as calling Shopify directly, that paging is read to the end and cannot loop, and that the callers moved.
+import './helpers/fakeShopify';
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import * as fake from './helpers/fakeShopify';
+import { setTrainingGuard } from '../src/lib/trainingGuard';
+
+import { useApp } from '../src/state/store';
+useApp.getState().patchSettings({ locationId: 'L1' }); // the one Shopify location every call here is made at
+
+const bulk = (rows: unknown[]) => {
+  const url = `https://bulk.example/${fake.calls.length}-${Math.random().toString(36).slice(2)}`;
+  fake.bulkFiles.set(url, rows.map(r => JSON.stringify(r)).join('\n'));
+  fake.on('bulkOperationRunQuery', fake.data({ bulkOperationRunQuery: { bulkOperation: { id: 'B1', status: 'CREATED' }, userErrors: [] } }));
+  fake.on('currentBulkOperation', fake.data({ currentBulkOperation: { id: 'B1', status: 'COMPLETED', objectCount: rows.length, url } }));
+};
+const VARIANTS = [{ id: 'V1', title: 'Default Title', price: '12.50', inventoryItem: { id: 'I1', tracked: true, inventoryLevel: { quantities: [{ name: 'available', quantity: 7 }] } }, product: { id: 'P1', title: 'Cow', status: 'ACTIVE', tags: [] } }];
+const COLLECTIONS = [{ id: 'C1', title: 'Animals' }, { id: 'P1', __parentId: 'C1' }];
+const CUSTOMERS = [{ id: 'U1', displayName: 'Ann', email: 'a@x.com', numberOfOrders: 1 }];
+
+test('the import reads items, collections and customers through the router with the same Shopify calls and results as direct', async () => {
+  const run = async (viaRouter: boolean) => {
+    fake.install(); await fake.signIn(); bulk(VARIANTS); bulk(COLLECTIONS); bulk(CUSTOMERS);
+    const seen: string[] = [];
+    let r;
+    if (viaRouter) { const c = await import('../src/alloyhost/catalogue'); r = [await c.listAllItems(s => seen.push(s)), await c.listAllCollections(s => seen.push(s)), await c.listAllCustomers(s => seen.push(s))]; }
