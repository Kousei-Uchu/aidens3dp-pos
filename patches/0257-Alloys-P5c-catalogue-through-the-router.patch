+// Location: src/alloyhost/catalogue.ts
+// Alloys P5c: how the app reads the whole catalogue (items, collections, customers) through the router. An Alloy may hand a long list
+// back in pages; these read every page, one after the other. Shopify returns each list as a single page (it is one bulk job), so against
+// Shopify this makes exactly the calls the import has always made. A cursor that does not advance is an error, never an endless loop.
+import type { Collection, Customer, Variant } from '../lib/types';
+import type { Page, PageReq } from '../alloykit/types';
+import { needFeature } from './need';
+import type { Router } from './router';
+import { appRouter } from './appRouter';
+
+export async function readAllPages<T>(read: (req: PageReq) => Promise<Page<T>>, onProgress?: (s: string) => void): Promise<T[]> {
+  const rows: T[] = []; let after: string | null = null; const seen = new Set<string>();
+  for (;;) {
+    const p = await read({ after, onProgress }); rows.push(...p.rows);
+    if (p.next === null) return rows;
+    if (seen.has(p.next)) throw new Error('The service sent the same page cursor twice, so the list was stopped.');
+    seen.add(p.next); after = p.next;
+  }
+}
+
+export const listAllItems = async (onProgress?: (s: string) => void, router: Router = appRouter): Promise<Variant[]> =>
+  readAllPages(needFeature('catalogue', 'listItems', 'Shopify', router), onProgress);
+export const listAllCollections = async (onProgress?: (s: string) => void, router: Router = appRouter): Promise<Collection[]> =>
+  readAllPages(needFeature('catalogue', 'listCollections', 'Shopify', router), onProgress);
+
+/** The local customer list is optional: with Customers off, or an Alloy that cannot list them all, the till simply has none stored. */
+export async function listAllCustomers(onProgress?: (s: string) => void, router: Router = appRouter): Promise<Customer[]> {
+  if (!router.has('customers', 'listAll')) {
+    // Same words as before when the login is missing: the import fails at the first step anyway, so this is only reached when it is on purpose.
+    return [];
+  }
+  return router.api('customers')!.listAll!({ onProgress });
+}
