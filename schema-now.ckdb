DEFINE SCHEMA

    RECORD TYPE Cart (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        cart_uuid       STRING QUERYABLE SEARCHABLE SORTABLE,
        created_at      STRING QUERYABLE SEARCHABLE SORTABLE,
        customer_json   STRING QUERYABLE SEARCHABLE SORTABLE,
        discount_json   STRING QUERYABLE SEARCHABLE SORTABLE,
        employee        STRING QUERYABLE SEARCHABLE SORTABLE,
        lines_json      STRING QUERYABLE SEARCHABLE SORTABLE,
        locked_at       STRING QUERYABLE SEARCHABLE SORTABLE,
        locked_by       STRING QUERYABLE SEARCHABLE SORTABLE,
        name            STRING QUERYABLE SEARCHABLE SORTABLE,
        note            STRING QUERYABLE SEARCHABLE SORTABLE,
        register_id     STRING QUERYABLE SEARCHABLE SORTABLE,
        status          STRING QUERYABLE SEARCHABLE SORTABLE,
        updated_at      STRING QUERYABLE SEARCHABLE SORTABLE,
        version         STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE DrawerCheckpoint (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        asOfStamp       STRING QUERYABLE SEARCHABLE SORTABLE,
        counts          STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE DrawerShift (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        floatCents      INT64 QUERYABLE SORTABLE,
        open            INT64 QUERYABLE SORTABLE,
        openedAt        STRING QUERYABLE SEARCHABLE SORTABLE,
        paidInCents     INT64 QUERYABLE SORTABLE,
        paidOutCents    INT64 QUERYABLE SORTABLE,
        staff           STRING QUERYABLE SEARCHABLE SORTABLE,
        version         INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Layout (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        layout_json     STRING QUERYABLE SEARCHABLE SORTABLE,
        layout_key      STRING QUERYABLE SEARCHABLE SORTABLE,
        updated_at      STRING QUERYABLE SEARCHABLE SORTABLE,
        updated_by      STRING QUERYABLE SEARCHABLE SORTABLE,
        version         STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE LedgerEntry (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        delta           STRING QUERYABLE SEARCHABLE SORTABLE,
        kind            STRING QUERYABLE SEARCHABLE SORTABLE,
        note            STRING QUERYABLE SEARCHABLE SORTABLE,
        saleUuid        STRING QUERYABLE SEARCHABLE SORTABLE,
        staff           STRING QUERYABLE SEARCHABLE SORTABLE,
        ts              STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Migration (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        counts          STRING QUERYABLE SEARCHABLE SORTABLE,
        cursor          STRING QUERYABLE SEARCHABLE SORTABLE,
        error           STRING QUERYABLE SEARCHABLE SORTABLE,
        finishedAt      INT64 QUERYABLE SORTABLE,
        holder          STRING QUERYABLE SEARCHABLE SORTABLE,
        holderName      STRING QUERYABLE SEARCHABLE SORTABLE,
        phase           STRING QUERYABLE SEARCHABLE SORTABLE,
        startedAt       INT64 QUERYABLE SORTABLE,
        status          STRING QUERYABLE SEARCHABLE SORTABLE,
        v               INT64 QUERYABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Rollup (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        date            STRING QUERYABLE SEARCHABLE SORTABLE,
        register_id     STRING QUERYABLE SEARCHABLE SORTABLE,
        rollup_key      STRING QUERYABLE SEARCHABLE SORTABLE,
        totals_json     STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Sale (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        cogs_cents      INT64 QUERYABLE SORTABLE,
        customer_gid    STRING QUERYABLE SEARCHABLE SORTABLE,
        discounts_cents INT64 QUERYABLE SORTABLE,
        employee        STRING QUERYABLE SEARCHABLE SORTABLE,
        entry_type      STRING QUERYABLE SEARCHABLE SORTABLE,
        fees_cents      INT64 QUERYABLE SORTABLE,
        items_cents     INT64 QUERYABLE SORTABLE,
        lines_json      STRING QUERYABLE SEARCHABLE SORTABLE,
        net_cents       INT64 QUERYABLE SORTABLE,
        order_gid       STRING QUERYABLE SEARCHABLE SORTABLE,
        order_name      STRING QUERYABLE SEARCHABLE SORTABLE,
        refund_of       STRING QUERYABLE SEARCHABLE SORTABLE,
        register_id     STRING QUERYABLE SEARCHABLE SORTABLE,
        register_name   STRING QUERYABLE SEARCHABLE SORTABLE,
        rounding_cents  INT64 QUERYABLE SORTABLE,
        sale_json       STRING QUERYABLE SEARCHABLE SORTABLE,
        sale_uuid       STRING QUERYABLE SEARCHABLE SORTABLE,
        status          STRING QUERYABLE SEARCHABLE SORTABLE,
        tenders_json    STRING QUERYABLE SEARCHABLE SORTABLE,
        tip_cents       INT64 QUERYABLE SORTABLE,
        total_cents     INT64 QUERYABLE SORTABLE,
        ts              STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Settings (
        "___createTime" TIMESTAMP QUERYABLE SORTABLE,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP QUERYABLE SORTABLE,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        settings_json   STRING QUERYABLE SEARCHABLE SORTABLE,
        settings_key    STRING QUERYABLE SEARCHABLE SORTABLE,
        version         STRING QUERYABLE SEARCHABLE SORTABLE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    RECORD TYPE "cloudkit.share" (
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        "cloudkit.thumbnailImageData" BYTES,
        "cloudkit.title"              STRING,
        "cloudkit.type"               STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );